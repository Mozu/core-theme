  {% extends "email/email" %}

  {% block body-content %}
    <br>
    <p>
        {% if model and model.firstName %}
        {{ labels.emailOpening|string_format(model.firstName)|safe }}
        {% else %}
        {{ labels.emailOpeningAlternative|safe }}
        {% endif %}
    </p>
	

	<p>{{ labels.digitalItemEmailIntro|safe }}</p>
	
	{% if model.GiftMessage %}
		<p><b>{{ labels.digitalMessage }}{{":"}}</b> <span class="mz-price">{{model.GiftMessage}}</span></p>
	{% endif %}
		
	{{ labels.digitalItemEmailInstructions|safe }}

    <p>{{ labels.digitalItemBlob|string_format(siteContext.generalSettings.websiteName, domainName)|safe }} </p>

    {{ labels.emailClosing|string_format(siteContext.generalSettings.websiteName)|safe }}

{% endblock body-content %}
