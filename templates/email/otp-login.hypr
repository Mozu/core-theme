{% extends "email/email" %}

{% block body-content %}
  <!--- DEBUG: User Object Dump --->
  <div style="background: #f0f0f0; border: 2px solid #ff0000; padding: 15px; margin: 10px 0; font-family: monospace; font-size: 12px;">
    <h3 style="color: #ff0000; margin-top: 0;">DEBUG: User Object Properties</h3>
    {% if user %}
      <table style="border-collapse: collapse; width: 100%; font-size: 11px;">
        <tr style="background: #ddd;"><th style="border: 1px solid #999; padding: 5px; text-align: left;">Property</th><th style="border: 1px solid #999; padding: 5px; text-align: left;">Value</th></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user (raw):</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.firstName:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.firstName }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.lastName:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.lastName }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.emailAddress:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.email }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.id:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.userId }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.userName:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.userName }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.isAnonymous:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.isAnonymous }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.behaviors:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.behaviors }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.isAuthenticated:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.isAuthenticated }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.accountId:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.accountId }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.companyOrOrganization:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.companyOrOrganization }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.localeCode:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.localeCode }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.attributes:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.attributes }}</td></tr>
        <tr><td style="border: 1px solid #ccc; padding: 5px;"><strong>user.customerSet:</strong></td><td style="border: 1px solid #ccc; padding: 5px;">{{ user.customerSet }}</td></tr>
      </table>
    {% else %}
      <p style="color: red; font-weight: bold;">⚠️ User object is NULL or UNDEFINED</p>
    {% endif %}
  </div>
  <!--- END DEBUG --->
  
  <!--- Header --->
  <div class="mz-otp-email-header">  
    <img src="https://kibocommerce.com/wp-content/themes/kibo/images/logo.png" alt="logo">
    <div class="mz-otp-header-body">
      <p><strong>{{ siteContext.generalSettings.websiteName }}</strong></p>
      <h3>{{ labels.emailSubjectOtp }}</h3>
    </div>
  </div>
  <br/>

  <div class="mz-otp-email-body">
    {% if user and user.firstName %}
      {{ labels.emailOpening|string_format(user.firstName)|safe }}
    {% else %}
      {{ labels.emailOpeningAlternative|safe }}
    {% endif %}

    <p>{{ labels.otpEmailInstruction }}</p>
    
    <div class="mz-otp-code" style="font-size: 18px; font-weight: bold; text-align: center; letter-spacing: 2px; padding: 15px; border: 1px dashed #ccc; background-color: #f9f9f9; margin: 20px 0;">
      {{ model.OtpCode }}
    </div>

    <p>{{ labels.otpNotRequested }}</p>
    
    <p><small>{{ labels.systemGeneratedEmail }}</small></p>

    {{ labels.emailClosing|string_format(siteContext.generalSettings.websiteName)|safe }}
  </div>
{% endblock body-content %}
