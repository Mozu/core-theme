{% comment %}
Amazon Pay V2 - Exact same structure as V1
{% endcomment %}

<tr id="amazonAddressBookWidgetTR">
	<td colspan="2">
		<div class="aws-step-content">
			<h3>{{ labels.awsShippingAddress }}</h3>
			<div id="addressBookWidgetDiv" class="aws-widget">
				<!-- Amazon Pay V2 Address Widget will be rendered here -->
			</div>
		</div>
	</td>
</tr>

<tr id="amazonWalletWidgetTR">
	<td colspan="2">
		<div class="aws-step-content">
			<h3>{{ labels.awsPaymentMethod }}</h3>
			<div id="walletWidgetDiv" class="aws-widget">
				<!-- Amazon Pay V2 Wallet Widget will be rendered here -->
			</div>
		</div>
	</td>
</tr>

<tr id="amazonAddressBookWidgetTD">
	<td colspan="2">
		<div class="aws-step-content">
			<div id="continue" class="amazon-actions" style="display:none;">
				{% comment %}
 <button type="button" onclick="
					console.log('Script started:', !!window.v2ScriptStarted);
					console.log('Modules loaded:', !!window.v2ModulesLoaded); 
					console.log('CheckoutView created:', !!window.v2CheckoutViewCreated);
					console.log('CheckoutView available:', !!window.checkoutView);
					
					if (window.checkoutView && window.checkoutView.submit) {
						window.checkoutView.submit();
					} else {
						alert('CheckoutView not available - check console logs');
					}
				" class="mz-button mz-button-primary amazon-continue-btn">
					Continue to Review
				</button> 
{% endcomment %}
				<button type="button" onclick="window.history.back();" class="mz-button amazon-cancel-btn">
					Cancel
				</button>
			</div>
		</div>
	</td>
</tr>