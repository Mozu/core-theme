
<tr class="amazon-address-bookrow">
	<td>
		<h3 class="amazon-section-title">{{ labels.awsShippingAddress }}</h3>
		<div id="addressBookWidgetDiv" class="aws-widget amazon-loading"></div>
	</td>
	<td>
		<h3 class="amazon-section-title">{{ labels.awsPaymentMethod }}</h3>
		<div id="walletWidgetDiv" class="aws-widget amazon-loading"> </div>
	</td>
</tr>

{% if model.destinations && model.destinations.length > 1%}
	<tr>
		<td colspan="2"> 
			<input type="checkbox" data-mz-value="overrideItemDestinations" value="true" {% if model.overrideItemDestinations %}checked="checked"{% endif %}> Override checkout address
		</td>
	</tr>
{%endif%}
<tr>
	<td class="button-section">
		<button id="cancel" onclick="window.history.back();" class="mz-button mz-button-medium">{{ labels.cancel }}</button>
		<button id="continue" class="mz-button mz-button-medium continue-btn" data-mz-action="submit">{{ labels.continue }}</button>
	</td>
</tr>

