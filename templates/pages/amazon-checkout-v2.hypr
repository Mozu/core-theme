{% extends "page" %}

{% block body-content %}

{% preload_json model "checkout" %}
{% require_script "pages/amazon-checkout-v2" %}

<div class="mz-l-container">
	<script type="text/javascript">
		window.onload = function(){
			var isQuoteOrder = window.location.href.indexOf("quoteOrder") > 0;

			var elementId = 'shippingAndBillingTitle';
			if(isQuoteOrder) {
				elementId = 'billingTitle';
			}

			var element = document.getElementById(elementId);
			element.style.display = 'block';
		};

		// Debug function to test checkoutView manually
		window.testCheckoutView = function() {
			console.log("=== Manual CheckoutView Test ===");
			console.log("window.checkoutView exists:", !!window.checkoutView);
			if (window.checkoutView) {
				console.log("checkoutView type:", typeof window.checkoutView);
				console.log("checkoutView submit method:", typeof window.checkoutView.submit);
				console.log("checkoutView properties:", Object.keys(window.checkoutView));
			}
			console.log("window.order exists:", !!window.order);
			return window.checkoutView;
		};
	</script>
    <h1 class="mz-pagetitle" id="shippingAndBillingTitle" style="display:none;">
		{{ labels.awsCheckout }}
    </h1>
	<h1 class="mz-pagetitle" id="billingTitle" style="display:none;">
		{{ labels.awsCheckoutBilling }}
    </h1>

    <form id="checkout-form" class="mz-checkoutform mz-l-2column mz-l-2column-right" method="post" onsubmit="return false;" id="amazonCheckout">
    	{% include "modules/common/message-bar" with model=model.messages %}
    	<table id="shippingBillingTbl" class="shippingBillingTbl">
        	{% include "modules/checkout/amazon-shipping-billing-v2" %}
	    </table>
    </form>

</div>

{% endblock body-content %}
