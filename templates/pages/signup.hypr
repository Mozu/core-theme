{% extends "page" %}

{% block title-tag-content %}{% firstof pageContext.metaTitle labels.signUp %} - {% parent %}{% endblock title-tag-content %}

{% block body-tag-classes %} mz-signuppage {% endblock body-tag-classes %}

{% block body-content %}
    <div class="mz-l-container">
        <h1 class="mz-pagetitle">{{ labels.signUp }}</h1>
        {% dropzone "signup-top" scope="template" %}
        <form method="post" class="mz-signupform mz-signup-page" name="mz-signupform">
           {% include "modules/common/message-bar" with model=model.messages %}
           <input type="hidden" name="returnUrl" value="{{ model.returnUrl }}" />
           <div class="mz-l-formfieldgroup">
                <div class="mz-l-formfieldgroup-row">
                    <div class="mz-l-formfieldgroup-cell">
                        <label for="firstName">{{ labels.firstName }}</label>
                    </div>
                    <div class="mz-l-formfieldgroup-cell">
                        <input type="text" name="firstName" data-mz-signup-firstname />
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row">
                    <div class="mz-l-formfieldgroup-cell">
                        <label for="lastName">{{ labels.lastName }}</label>
                    </div>
                    <div class="mz-l-formfieldgroup-cell">
                        <input type="text" name="lastName" data-mz-signup-lastname />
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row">
                    <div class="mz-l-formfieldgroup-cell">
                        <label for="emailAddress">{{ labels.emailAddress }}</label>
                    </div>
                    <div class="mz-l-formfieldgroup-cell">
                        <input type="email" name="emailAddress" data-mz-signup-emailaddress />
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row">
                    <div class="mz-l-formfieldgroup-cell">
                        <label for="password">{{ labels.password }}</label>
                    </div>
                    <div class="mz-l-formfieldgroup-cell">
                        <input type="password" name="password" data-mz-signup-password />
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row">
                    <div class="mz-l-formfieldgroup-cell">
                        <label for="confirmPassword">{{ labels.confirmPassword }}</label>
                    </div>
                    <div class="mz-l-formfieldgroup-cell">
                        <input type="password" name="confirmPassword" data-mz-signup-confirmpassword />
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row">
                  <div class="mz-l-formfieldgroup-cell">
                      <input style="float:right" type="checkbox" name="agreeToGDPR" data-mz-signup-agreeToGDPR />
                  </div>
                    <div class="mz-l-formfieldgroup-cell">
                      <label style="float:left" for="agreeToGDPR">{{ labels.agreeToGDPR|string_format("https://kibocommerce.com/privacy/")|safe }}</label>
                  </div>
                </div>
                <div class="mz-l-formfieldgroup-row">
                    <div class="mz-l-formfieldgroup-cell"></div>
                    <div class="mz-l-formfieldgroup-cell">
                        <button class="mz-button mz-button-large mz-sign-up-page-button" data-mz-action="signuppage-submit">{{ labels.signUp }}</button>
                    </div>
                </div>
                <!-- 2FA UI Elements (hidden by default, shown during 2FA flow) -->
                <div class="mz-l-formfieldgroup-row mz-twofa-title-row" style="display: none;">
                    <div class="mz-l-formfieldgroup-cell"></div>
                    <div class="mz-l-formfieldgroup-cell">
                        <h3>{{ labels.loginVerificationRequired }}</h3>
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row mz-twofa-input-row" style="display: none;">
                    <div class="mz-l-formfieldgroup-cell">
                        <label for="mz-twofa-code">{{ labels.verificationCode }}</label>
                    </div>
                    <div class="mz-l-formfieldgroup-cell">
                        <input type="text" id="mz-twofa-code" data-mz-twofa-code maxlength="6" placeholder="{{ labels.enter6DigitCode }}" autocomplete="one-time-code" pattern="[0-9]{6}" required>
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row mz-twofa-message-row" style="display: none;">
                    <div class="mz-l-formfieldgroup-cell"></div>
                    <div class="mz-l-formfieldgroup-cell">
                        <section data-mz-role="popover-message" class="mz-popover-message"></section>
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row mz-twofa-buttons-row" style="display: none;">
                    <div class="mz-l-formfieldgroup-cell"></div>
                    <div class="mz-l-formfieldgroup-cell">
                        <a href="#" class="mz-resend-twofa" data-mz-action="resend-twofa-code">{{ labels.resendCode }}</a>
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row mz-twofa-back-row" style="display: none;">
                    <div class="mz-l-formfieldgroup-cell"></div>
                    <div class="mz-l-formfieldgroup-cell">
                        <a href="#" class="mz-back-to-signup" data-mz-action="backto-signup">{{ labels.backToSignUp }}</a>
                    </div>
                </div>
                <div class="mz-l-formfieldgroup-row">
                    <div class="mz-l-formfieldgroup-cell"></div>
                    <div class="mz-l-formfieldgroup-cell">
                        <section data-mz-role="popover-message" class="mz-popover-message"></section>
                    </div>
                </div>
            </div>
        </form>
    </div>
{% endblock body-content %}
