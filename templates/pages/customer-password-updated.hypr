{% extends "page" %}

{% block title-tag-content %}{{ labels.customerPasswordUpdatedSubject }} - {% parent %}{% endblock title-tag-content %}

{% block body-tag-classes %} mz-email-preview {% endblock body-tag-classes %}

{% block body-content %}
  <div class="mz-l-container">
    <h1>{{ labels.customerPasswordUpdatedSubject }}</h1>
    <p>{{ labels.customerPasswordUpdatedBody }}</p>

    {% if model and model.OccurredUtc %}
      <p>{{ labels.customerPasswordUpdatedWhen|string_format(model.OccurredUtc) }}</p>
    {% endif %}

    {% if model and model.SupportUrl %}
      <p>{{ labels.customerPasswordUpdatedSupport|string_format(model.SupportUrl)|safe }}</p>
    {% endif %}
  </div>
{% endblock body-content %}
