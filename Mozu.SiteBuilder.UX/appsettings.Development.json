{
	"spring": {

		"cloud": {
			"config": {
				"uri": "http://shared.kubedev.kibo-dev.com/kibo.config",
				"label": "environment(_)prod"
			}
		}
	},
	"Mozu": {
		"appSettings": {
			"redis_health_check": "true",
			"YSOD_ERRORS": "true",
			"disableCDN": "true",
			"Environment": "prod",
			"ScaleUnitId": "sb",
			"SSLValidationEnabled": "false",
			"partial_caching_default_duration": "300",
			"service-maxSize-default": "2147483647",
			"webpages:Version": "3.0.0.0",
			"ClientValidationEnabled": "true",
			"UnobtrusiveJavaScriptEnabled": "true",
			"clientCacheHeaderLength:default": "1209600",
			"MinThreadIO": "5",
			"MinThreadWorker": "200",
			"js-sdk-build-dir": "~/BuiltinScripts/SDK/dist/",
			"require-js-build-dir": "~/BuiltinScripts/RequireJS/dist/",
			"hyprlive-build-dir": "~/BuiltinScripts/HyprLive/dist/",
			"AppId": "c9141bc2fcc14cebb0f727d0374ae956",
			"ApplicationName": "MozuStorefront",
			"routeDebug": "false",
			"gositeRedirectsHostname": "false",
			"gositeDomainPriority": "Primary",
			"ReverseProxy": "false",
			"partial_output_cache_stack_limit": "15",
			"actions:debugtimeout2": "99999999",
			"sitebuilder.MonitorThemeChanges": "false",
			"redis_hosts": "localhost:6379",

			"DefaultCacheRepo": "redis",
			"loadbalencer.isolation.domains:": "fart",
			"arcjsClaimExpiration": "600"
		},
		"services2": {
			"RODUCTRUNTIME": "http://localhost:2188"
		},
		"domains": {
			"tp": "http://services-sb-prod.kube-int.sandbox.mozu.com"
		},

			"connectionString": {
				"rediscache": "localhost:6379,keepAlive=45,connectTimeout=7000,configCheckSeconds=10"
			}
		},
	"Logging": {
		"LogLevel": {
			"Default": "Information"
		}
	},
	"AllowedHosts": "*"
}