<?xml version="1.0" encoding="utf-8"?>

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings  >
    <add key="Environment" value="SI" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="authCookieDomain" value="mozu-si.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="authCookieName" value="sbAuthSI" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  </appSettings> 
</configuration>