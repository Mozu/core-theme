<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=152368 
  -->
<configuration>
  <configSections>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <sectionGroup name="fiftyOne">
      <section name="log" type="FiftyOne.Foundation.Mobile.Configuration.LogSection, FiftyOne.Foundation" requirePermission="false" allowDefinition="Everywhere" restartOnExternalChanges="false" allowExeDefinition="MachineToApplication" />
      <!--
      <section name="redirect" type="FiftyOne.Foundation.Mobile.Configuration.RedirectSection, FiftyOne.Foundation" requirePermission="false" allowDefinition="Everywhere" restartOnExternalChanges="false" allowExeDefinition="MachineToApplication"/>
      -->
      <section name="detection" type="FiftyOne.Foundation.Mobile.Detection.Configuration.DetectionSection, FiftyOne.Foundation" requirePermission="false" allowDefinition="Everywhere" restartOnExternalChanges="false" allowExeDefinition="MachineToApplication" />
    </sectionGroup>
  </configSections>
  <appSettings file="..\user.app.config">
    <add key="redis_health_check" value="true" />
    <add key="YSOD_ERRORS" value="true" />
    <add key="disableCDN" value="true" />
    <add key="EnableRequestLogging" value="false" />
    <add key="Environment" value="ngdev03" />
    <add key="ScaleUnitId" value="SB" />
    <add key="mozu_core_settings_path" value="\configs\_v2" />
    <add key="SSLValidationEnabled" value="false" />
    <add key="partial_caching_default_duration" value="300" />
    <add key="service-maxSize-default" value="2147483647" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="clientCacheHeaderLength:default" value="1209600" />
    <add key="MinThreadIO" value="5" />
    <add key="MinThreadWorker" value="200" />
    <add key="js-sdk-build-dir" value="~/BuiltinScripts/SDK/dist/" />
    <add key="require-js-build-dir" value="~/BuiltinScripts/RequireJS/dist/" />
    <add key="hyprlive-build-dir" value="~/BuiltinScripts/HyprLive/dist/" />
    <add key="AppId" value="c9141bc2fcc14cebb0f727d0374ae956" />
    <add key="ApplicationName" value="MozuStorefront" />
    <add key="routeDebug" value="false" />
    <add key="gositeRedirectsHostname" value="false" />
    <add key="gositeDomainPriority" value="Primary" />
    <add key="ReverseProxy" value="false" />
    <add key="partial_output_cache_stack_limit" value="15" />
    <add key="V8DebugEnabled" value="false" />
    <add key="V8DebugPort" value="9292" />
    <add key="actions:debugtimeout2" value="99999999" />
    <add key="clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=0&amp;EnableLocalCache=true&amp;EnableDirtyCacheRead=true&amp;SlidingExpirationSeconds=900" />
    <add key="sitebuilder.Default.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=0&amp;EnableLocalCache=true&amp;SlidingExpirationSeconds=300&amp;AbsoluteExpirationSeconds=1200&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="sitebuilder.CatalogIndependent.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=0&amp;EnableLocalCache=true&amp;SlidingExpirationSeconds=300&amp;AbsoluteExpirationSeconds=1100&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="sitebuilder.PartialOutput.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=500&amp;EnableLocalCache=true&amp;AbsoluteExpirationSeconds=800&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="sitebuilder.ProductSearch.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=1024&amp;EnableLocalCache=true&amp;AbsoluteExpirationSeconds=700&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="sitebuilder.Default.staging.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=100&amp;EnableLocalCache=true&amp;AbsoluteExpirationSeconds=100&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="sitebuilder.CatalogIndependent.staging.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=100&amp;EnableLocalCache=true&amp;AbsoluteExpirationSeconds=100&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="sitebuilder.PartialOutput.staging.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=100&amp;EnableLocalCache=true&amp;AbsoluteExpirationSeconds=100&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="sitebuilder.ProductSearch.staging.clientCacheSettings" value="LocalCacheMemoryLimitMegabytes=100&amp;EnableLocalCache=true&amp;AbsoluteExpirationSeconds=100&amp;EnableDirtyCacheBackgroundValidation=false" />
    <add key="Sitebuilder.ContextBuilder.Compressed.CacheSettings" value="LocalCacheMemoryLimitMegabytes=0&amp;EnableLocalCache=true&amp;SlidingExpirationSeconds=300&amp;AbsoluteExpirationSeconds=1200&amp;EnableDirtyCacheBackgroundValidation=false&amp;SerializationType=JsonNetCompressed" />
    <add key="Sitebuilder.Redirects.Compressed.CacheSettings" value="LocalCacheMemoryLimitMegabytes=0&amp;EnableLocalCache=true&amp;SlidingExpirationSeconds=300&amp;AbsoluteExpirationSeconds=1200&amp;EnableDirtyCacheBackgroundValidation=false&amp;SerializationType=JsonNetCompressed" />
    <add key="sitebuilder.MonitorThemeChanges" value="false" />
  </appSettings>
  <system.net>
    <!--
   <defaultProxy  >
      <proxy bypassonlocal="False" usesystemdefault="False" proxyaddress="http://127.0.0.1:8888" />
    </defaultProxy>
    -->
  </system.net>
  <!--
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web> 
        <httpRuntime targetFramework="4.5" />
      </system.Web> 
  -->
  <system.runtime.caching>
    <memoryCache>
      <namedCaches>
        <add name="default" cacheMemoryLimitMegabytes="0" pollingInterval="00:02:00" />
      </namedCaches>
    </memoryCache>
  </system.runtime.caching>
  <system.web>
    <authentication mode="Forms">
      <forms name="formsauth" loginUrl="~/auth/signin" timeout="2880" />
    </authentication>
    <compilation targetFramework="4.6.1" debug="true">
      <assemblies>
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Helpers, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Mvc, Version=5.2.2.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.WebPages, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <remove assembly="ClearScriptV8-32" />
        <remove assembly="ClearScriptV8-64" />
      </assemblies>
    </compilation>
    <customErrors mode="Off" />
    <pages validateRequest="false" controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <httpRuntime requestValidationMode="2.0" maxRequestLength="20480" requestPathInvalidCharacters="" relaxedUrlToFileSystemMapping="true" maxUrlLength="2000" />
  </system.web>
  <system.webServer>
    <defaultDocument enabled="false" />
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule" />
      <remove name="Detector" />
      <add name="Detector" type="FiftyOne.Foundation.Mobile.Detection.DetectorModule, FiftyOne.Foundation" />
    </modules>
    <staticContent>
      <remove fileExtension=".less" />
      <remove fileExtension=".json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".less" mimeType="text/css" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
    </staticContent>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="20480000" />
      </requestFiltering>
    </security>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" hostingModel="InProcess">
      <environmentVariables>
        <environmentVariable name="COMPLUS_ForceENC" value="1" />
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
  <dotless minifyCss="false" cache="true" web="false" />
  <!--
    Configuration section for 51degrees mobile detection framework 
    http://51degrees.mobi/Support/Documentation/Foundation/UserGuide.aspx
  -->
  <fiftyOne>
    <log logFile="~/App_Data/Log.txt" logLevel="Info" />
    <!-- data is embedded in the dll, we do not need to provide a data path -->
    <detection binaryFilePath="~/app_data/51Degrees-PremiumV3_2_1.dat" shareUsage="false" memoryMode="false" featureDetectionEnabled="true" />
  </fiftyOne>
  <runtime>
    
