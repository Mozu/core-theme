<?xml version="1.0" encoding="utf-8" ?>
  <parameters >
    <parameter name="applicationPool" defaultValue="Mozu.SiteBuilder.UX.Admin" >
      <parameterEntry kind="DeploymentObjectAttribute" scope="application"
                      match="application/@applicationPool" />
    </parameter>
    <parameter
      name="physicalPath"
      description="Physical Path Location"
      defaultValue="d:/mozu/sites/Dev/Mozu.SiteBuilder.UX.Admin"
      tags="">
      <parameterEntry
        kind="DeploymentObjectAttribute"
        scope="application"
        match="application/@physicalPath" />
    </parameter>
    
    <parameter
      name="IIS Web Application Name"
      description="The fully-pathed name of this application in IIS."
      defaultValue="RiaSiteBuilder/Admin"
      tags="">
      <parameterEntry
        kind="DeploymentObjectAttribute"
        scope="application"
        match="application/@IIS Web Application Name" />
    </parameter>
  </parameters>