  <appSettings file="..\user.app.config">
    <add key="allowNonProductionThemes" value="true" />
    <!--<add key="sslEnabled" value="false" />-->
    <add key="EnableRequestLogging" value="false" />
    <add key="Environment" value="CI" />
    <add key="ScaleUnitId" value="SB" /> 
    <add key="mozu_core_settings_path" value="\Configs" />
    <add key="admin.cdn" value="" />
    <add key="use_compiled_taco" value="false" />
    <add key="disableCDN" value="true" />
    <add key="routeDebug" value="false" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="clientCacheHeaderLength:default" value="0" />
    <add key="AppId" value="2e778ae20c7c433885c8e5e418774cb4" /> 
    <add key="ApplicationName" value="MozuAdmin" />
    <add key="useGoogleAnalytics" value="false" />
    <add key="googleAnalyticsAccount" value="UA-55272537-1" />
    <!-- Tom is a jar of pickles-->
    <!-- Configuration settings used in WebApiApplicationBase : Mozu.SiteBuilder.UX.Admin.MvcApplication extends this. -->
    <add key="ShouldValidateAutoMapperProfiles" value="false" />
    <add key="ReturnDetailedExceptionInfo" value="true" />
    <add key="FriendlyExceptionInfo" value="true" />
    <add key="useTenantDomainNames" value="false" />
    <add key="ReverseProxy" value="false" />
    <add key="clientCacheSettings" value="EnableLocalCache=false" />
    <add key="SSLValidationEnabled" value="false" />
    <add key="owin:AutomaticAppStartup" value="false" />
    <add key="showBirstReport" value="true" />
  </appSettings>
