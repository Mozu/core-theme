<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=152368
  -->
<configuration>
  <configSections>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
  </configSections>
  <appSettings file="..\user.app.config">
    <add key="allowNonProductionThemes" value="true" />
    <!--<add key="sslEnabled" value="false" /> -->
    <add key="EnableRequestLogging" value="false" />
    <add key="Environment" value="ngdev03" />
    <add key="ScaleUnitId" value="SB" />
    <add key="mozu_core_settings_path" value="\Configs\_v2" />
    <add key="admin.cdn" value="" />
    <add key="use_compiled_taco" value="false" />
    <add key="disableCDN" value="true" />
    <add key="routeDebug" value="false" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="clientCacheHeaderLength:default" value="0" />
    <add key="AppId" value="2e778ae20c7c433885c8e5e418774cb4" />
    <add key="ApplicationName" value="MozuAdmin" />
    <add key="useGoogleAnalytics" value="false" />
    <add key="googleAnalyticsAccount" value="UA-55272537-1" />
    <!-- React is a jar of pickes -->
    <add key="ReactEnvironment" value="hot" />
    <!-- Tom is a jar of pickles-->
    <!-- Configuration settings used in WebApiApplicationBase : Mozu.SiteBuilder.UX.Admin.MvcApplication extends this. -->
    <add key="ShouldValidateAutoMapperProfiles" value="false" />
    <add key="ReturnDetailedExceptionInfo" value="true" />
    <add key="FriendlyExceptionInfo" value="true" />
    <add key="useTenantDomainNames" value="false" />
    <add key="ReverseProxy" value="false" />
    <add key="clientCacheSettings" value="EnableLocalCache=false" />
    <add key="SSLValidationEnabled" value="false" />
    <add key="owin:AutomaticAppStartup" value="false" />
    <add key="showBirstReport" value="true" />
    <add key="sitebuilder.enableContextCacheBackgroundBuilds" value="false" />
    <add key="ServiceClient.Default.Timout" value="45000" />
    <!-- needed to point to homepod tenant-->
    <add key="hp_local" value="{{hp}}" />
  </appSettings>
  <!--
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <customErrors mode="Off" />
    <compilation debug="true" targetFramework="4.6.1">
      <assemblies>
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Helpers, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Mvc, Version=5.2.2.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.WebPages, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <remove assembly="ClearScriptV8-32" />
        <remove assembly="ClearScriptV8-64" />
        <add assembly="System.Runtime, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
      </assemblies>
    </compilation>
    <authentication mode="Forms">
      <forms name="formsauth" loginUrl="~/auth/FedLogin/" timeout="2880" />
      <!--<forms name="formsauth" loginUrl="~/auth/" timeout="2880" />-->
    </authentication>
    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <httpModules>
      <!--<remove name="siteAuth" />-->
      <add name="siteAuth" type="Mozu.SiteBuilder.Mvc.Security.SbAuthenticationModule, Mozu.SiteBuilder.Mvc" />
    </httpModules>
    <httpRuntime requestValidationMode="2.0" maxRequestLength="20480" />
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
    <globalization culture="auto" uiCulture="auto" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <add name="VersionValidationCacheHeaderModule" type="Mozu.SiteBuilder.UX.Admin.Modules.VersionValidationCacheHeaderModule, Mozu.SiteBuilder.UX.Admin" />
      <add name="BetaControlVersionModule" type="Mozu.SiteBuilder.UX.Admin.Modules.BetaControlVersionModule, Mozu.SiteBuilder.UX.Admin" />
    </modules>
    <handlers>
      <remove name="dotless" />
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <staticContent>
      <remove fileExtension=".less" />
      <remove fileExtension=".json" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".svg" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".less" mimeType="text/css" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".svg" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="20480000" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Content-Language" value="en" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <runtime>

    
