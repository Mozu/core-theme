<configuration>
  <configSections>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
  </configSections>
  <appSettings>
    <add key="EnableRequestLogging" value="false" />
    <add key="Environment" value="CI" /> 
    <add key="ScaleUnitId" value="su1" />
    <add key="mozu_core_settings_path" value="\Configs" />  
    <add key="admin.cdn" value="" />
    <add key="use_compiled_taco" value="false" />
    <add key="admin.dashboardInstructions.loc" value="" />
    <add key="useSiteDomainNames" value="false" />
    <add key="routeDebug" value="false" />
    <add key="authorize" value="true" /> 
    <add key="log4net.Config" value="\Configs\Log4Net.CI.config" /> 
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="clientCacheHeaderLength:default" value="0" />
    <add key="UseMockRepos" value="false" />

    <add key="AppId" value="2e778ae20c7c433885c8e5e418774cb4" />  
    <add key="dnszone" value="vnextdev.com" />
    <add key="cms-feature-versions" value="{'cms':'1.0.7','Blog':'1.0.3','Ecommerce':'1.0.8'}" />
    <add key="useGoogleAnalytics" value="false" />
    <add key="googleAnalyticsAccount" value="UA-30384432-1" />  
    <!-- Tom is a jar of pickles--> 
    <!-- Configuration settings used in WebApiApplicationBase : Mozu.SiteBuilder.UX.Admin.MvcApplication extends this. -->
    <add key="ShouldValidateAutoMapperProfiles" value="false" />
    <add key="ReturnDetailedExceptionInfo" value="true" />
    <add key="useTenantDomainNames" value="false" />
    <add key="authCookieDomain" value=""/> 
    <add key="authCookieName" value="sbAdminAuthLocal" />
    <add key="ReverseProxy" value="false" />
  </appSettings>
  <system.net> 
    <!--<defaultProxy> 
      <proxy bypassonlocal="False" usesystemdefault="True" proxyaddress="http://127.0.0.1:8888" />
    </defaultProxy>-->
  </system.net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Autofac" publicKeyToken="17863af14b0044da" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Autofac.Configuration" publicKeyToken="17863af14b0044da" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Autofac.Integration.Mvc" publicKeyToken="17863af14b0044da" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.2.859" newVersion="2.6.2.859" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="FSharp.Core" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="AutoMapper" publicKeyToken="be96cd2c38ef1005" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.1.267.0" newVersion="2.1.267.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Autofac.Integration.WebApi" publicKeyToken="17863af14b0044da" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.2.859" newVersion="2.6.2.859" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="FSharp.PowerPack" publicKeyToken="a19089b1c74d0809" culture="neutral" />
