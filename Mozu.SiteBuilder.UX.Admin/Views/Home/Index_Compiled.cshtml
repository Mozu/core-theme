@using System.Configuration
@{
    Layout = "";
    var assFile = typeof(Mozu.SiteBuilder.UX.Admin.Api.AccountController ).Assembly.Location;
    var ver = System.Diagnostics.FileVersionInfo.GetVersionInfo(assFile);
    var cdn = @ConfigurationManager.AppSettings["admin.cdn"];
}
<!DOCTYPE html>
<html>
<head>
    <title>MOZU-ADMIN</title>
    <link rel="stylesheet" type="text/css" href="@cdn@Url.Content("~/Scripts/build/resources/Taco-all.css")?ver=@ver.FileVersion" />
    @Html.Partial("admininlinejson")
    <script type="text/javascript" src="@cdn@Url.Content("~/Scripts/resources/lib/init.min.js")"></script>
    <script type="text/javascript" src="@cdn@Url.Content("~/Scripts/build/all-classes.js")?ver=@ver.FileVersion"></script>
    <script src="@cdn@Url.Content("~/Scripts/ext/locale/" + ViewData["extlocalefile"])"></script>

    <script type="text/javascript">

        Ext.Ajax.timeout = 120000;

        Ext.Loader.setConfig({
            enabled: false
        });

    </script>
</head>

<body></body>

</html>
