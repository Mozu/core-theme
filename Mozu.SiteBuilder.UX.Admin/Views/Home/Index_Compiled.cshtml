@using System.Configuration
@using Mozu.SiteBuilder.Mvc.Contexts
@{
    Layout = "";

    var ass = typeof(Mozu.SiteBuilder.UX.Admin.Api.AccountController).Assembly;
    var assFile = ass.Location;
    var assemblyInfoAtt = (System.Reflection.AssemblyInformationalVersionAttribute)ass.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false).FirstOrDefault() ?? new System.Reflection.AssemblyInformationalVersionAttribute("local");
    var assemblyInfoHash = new Guid(System.Security.Cryptography.MD5.Create().ComputeHash(System.Text.Encoding.ASCII.GetBytes(assemblyInfoAtt.InformationalVersion))).ToString();

    var ver = System.Diagnostics.FileVersionInfo.GetVersionInfo(assFile);
   
    var tenantGlobalSettings = (ITenantAdminSettingsContext)ViewData["tenantGlobalSettings"];

    var betaControlVersion = tenantGlobalSettings.EnableBetaAdmin ? null : tenantGlobalSettings.BetaControlVersion;
    var cdn = (string)ViewData["cdn"];
    var mozuInstanceId = (string)ViewData["mozuInstanceId"];
    var requestSuffix = string.Format("ver={0}&verHash={1}&bcv={2}&_miid={3}", ver.FileVersion, assemblyInfoHash, betaControlVersion, mozuInstanceId);

}
@helper DoCss(string cdn, string requestSuffix)
    {
        var subCss = System.IO.Directory.GetFiles(Server.MapPath("~/Scripts/build/resources/"), "Taco-all_*.css");

        if (subCss.Length == 0)
        {
            <link rel="stylesheet" type="text/css" href="@cdn@Url.Content("~/Scripts/build/resources/Taco-all.css")?@requestSuffix" />
        }
        else
        {
            foreach (var css in subCss)
            {
                <link rel="stylesheet" type="text/css" href="@cdn@Url.Content("~/Scripts/build/resources/" + System.IO.Path.GetFileName(css))?@requestSuffix" />
            }
        }
}
<!DOCTYPE html>
<html>
<head>
    <title>MOZU-ADMIN</title>
    <link rel="stylesheet" type="text/css" href="@cdn@Url.Content("~/Scripts/build/resources/fonts/fontawesome/css/all.css")?@requestSuffix" />
    <link type="image/x-icon" href="@cdn@Url.Content("~/Scripts/resources/favicon.ico")?@requestSuffix" rel="icon" />
    <link type="image/x-icon" href="@cdn@Url.Content("~/Scripts/resources/favicon.ico")?@requestSuffix" rel="shortcut icon" />

    @DoCss(cdn, requestSuffix);
    @Html.Partial("admininlinejson")
    <script type="text/javascript" src="@cdn@Url.Content("~/Scripts/resources/lib/init.min.js")?@requestSuffix"></script>

    <script type="text/javascript" src="@cdn@Url.Content("~/Scripts/build/" + ViewData["applib"])?@requestSuffix"></script>
    <script src="@cdn@Url.Content("~/Scripts/build/locale/" + ViewData["extlocalefile"])?@requestSuffix"></script>

    @if (!(Request.Browser.Type.Contains("IE") && Request.Browser.MajorVersion < 9))
    {
        <script src="@cdn@Url.Content("~/Scripts/resources/lib/ace/ace.js")?@requestSuffix" type="text/javascript" charset="utf-8"></script>
        <script src="@cdn@Url.Content("~/Scripts/resources/lib/ace/theme-textmate.js")?@requestSuffix" type="text/javascript" charset="utf-8"></script>
        <script src="@cdn@Url.Content("~/Scripts/resources/lib/ace/ext-language_tools.js")?@requestSuffix" type="text/javascript" charset="utf-8"></script>
        <script src="@cdn@Url.Content("~/Scripts/resources/lib/ace/mode-mozufilter.js")?@requestSuffix" type="text/javascript" charset="utf-8"></script>
    }





    <script type="text/javascript">

        Ext.Ajax.timeout = 120000;

        Ext.Loader.setConfig({
            enabled: false
        });

    </script>
</head>

<body>
</body>

</html>
