@using System.Configuration
@{
    Layout = "";
    var assFile = typeof(Mozu.SiteBuilder.UX.Admin.Api.AccountController ).Assembly.Location;
    var ver = System.Diagnostics.FileVersionInfo.GetVersionInfo(assFile);
    var cdnHost = Mozu.Core.Settings.MozuConfigurationManager.AppSettings("CdnHost");
    var cdn = Mozu.Core.Settings.MozuConfigurationManager.AppSettings("disableCDN") == "true" || string.IsNullOrEmpty(cdnHost) ? "" : ("//" + cdnHost + "/common");
}
<!DOCTYPE html>
<html>
<head>
    <title>MOZU-ADMIN</title>
    <link rel="stylesheet" type="text/css" href="@cdn@Url.Content("~/Scripts/build/resources/Taco-all.css")?ver=@ver.FileVersion" />
    @Html.Partial("admininlinejson")
    <script type="text/javascript" src="@cdn@Url.Content("~/Scripts/resources/lib/init.min.js")"></script>    
    <script type="text/javascript" src="@cdn@Url.Content("~/Scripts/build/" + ViewData["applib"])?ver=@ver.FileVersion"></script>
    <script src="@cdn@Url.Content("~/Scripts/build/locale/" + ViewData["extlocalefile"])"></script>
    
    @if (!(Request.Browser.Type.Contains("IE") && Request.Browser.MajorVersion < 9))
    {
        <script src="@cdn@Url.Content("~/Scripts/resources/lib/ace/ace.js")" type="text/javascript" charset="utf-8"></script>
        <script src="@cdn@Url.Content("~/Scripts/resources/lib/ace/theme-textmate.js")" type="text/javascript" charset="utf-8"></script>
        <script src="@cdn@Url.Content("~/Scripts/resources/lib/ace/mode-mozufilter.js")" type="text/javascript" charset="utf-8"></script>
    }
    




    <script type="text/javascript">

        Ext.Ajax.timeout = 120000;

        Ext.Loader.setConfig({
            enabled: false
        });

    </script>
</head>

<body></body>

</html>
