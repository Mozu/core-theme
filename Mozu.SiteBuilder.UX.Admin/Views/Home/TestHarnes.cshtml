
@{
    Layout = "";
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/resources/css/taco.css")" />
    <link href="@Url.Content("~/Scripts/resources/css/ExtUx/css/CheckHeader.css")" rel="stylesheet" type="text/css" />
    @Html.Partial("admininlinejson");
    
    <script src="@Url.Content("~/Scripts/resources/lib/json2.js")"></script>
    <script src="@Url.Content("~/Scripts/resources/lib/history.adapter.native.js")"></script>
    <script src="@Url.Content("~/Scripts/resources/lib/history.html4.js")"></script>
    <script src="@Url.Content("~/Scripts/resources/lib/history.js")"></script>
    

    <script src="@Url.Content("~/Scripts/ext/ext-all-debug.js")"></script>
    
    <script src="@Url.Content("~/Scripts/ext/locale/" + ViewData["extlocalefile"])"></script>   
    
    <script type="text/javascript">
        Ext.state.Manager.setProvider(Ext.create('Ext.state.CookieProvider', {
            path: '/admin/',
            expires: new Date(new Date().getTime() + (1000 * 60 * 60 * 24 * 30))
        }));
        //1 min timeout
        Ext.Ajax.timeout = 120000;
        Ext.Loader.setConfig({
            enabled: true,
            disableCaching: !!Ext.state.Manager.get('disableCaching'),
            paths: {
                'Ext.ux': '@Url.Content("~/Scripts/ext/ux")'
                , 'Taco': '@Url.Content("~/Scripts/app")'
            }
        });
        Ext.ns('Taco');
        Taco.baseCSSPrefix = 'taco-';

    </script>
   
    @* <script src="@Url.Content("~/Scripts/taco-min.js")"></script>*@
</head>
@*<script>
    if (window.location.pathname[window.location.pathname.length - 1] != '/') {
        window.location.href = "/admin/";
    }
</script>*@
<body></body>

</html>

