@{
    Layout = "";
    var cookie = Context.Request.Cookies.Get("taco-asset-location");
    var assetServer = cookie != null && cookie.Value != null ? System.Web.HttpUtility.UrlDecode(cookie.Value) : "";
    var cssPath = assetServer+ Url.Content("~/Scripts/build/resources/Taco-all.css");
    var appPath = assetServer + Url.Content("~/Scripts/app");
    var uxPath = assetServer + Url.Content("~/Scripts/ux");
    var extPath = assetServer + Url.Content("~/Scripts/ext/src");
    var bootStrapPath = assetServer + @Url.Content("~/Scripts/bootstrap.js");
    var appJsPath = assetServer + @Url.Content("~/Scripts/app/app.js");

    var extLib = assetServer + Url.Content("~/Scripts/ext/" + ViewData["extlib"]);
    var extLocale = assetServer + Url.Content("~/Scripts/ext/locale/" + ViewData["extlocalefile"]);
}
<!DOCTYPE html>
<html>
<head>
    <title>Mozu Admin</title>
    
    <link rel="stylesheet" type="text/css" href="@cssPath" />

    @Html.Partial("admininlinejson")

    <script type="text/javascript" src="@Url.Content("~/Scripts/resources/lib/polyfills.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/resources/lib/json2.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/resources/lib/history.adapter.native.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/resources/lib/history.html4.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/resources/lib/history.js")"></script>
    
    <!--
    <script src="@Url.Content("~/Scripts/resources/lib/ace/ace.js")" type="text/javascript" charset="utf-8"></script>
    <script src="@Url.Content("~/Scripts/resources/lib/ace/theme-textmate.js")" type="text/javascript" charset="utf-8"></script>
    <script src="@Url.Content("~/Scripts/resources/lib/ace/mode-mozufilter.js")" type="text/javascript" charset="utf-8"></script>
    -->
    
    

    <script type="text/javascript" src="@extLib"></script>
    <script type="text/javascript" src="@extLocale"></script>
    
    <script type="text/javascript">
    Ext.state.Manager.setProvider(Ext.create('Ext.state.CookieProvider', {
        path: '/admin/',
        expires: new Date(new Date().getTime() + (1000 * 60 * 60 * 24 * 30))
    }));
    //1 min timeout
    Ext.Ajax.timeout = 120000;
    Ext.Loader.setConfig({
        enabled: true,
        disableCaching: !!Ext.state.Manager.get('disableCaching')

    });
    Ext.Loader.addClassPathMappings({
        Taco: '@appPath',
        "Ext.ux.form.field.BoxSelect": "@uxPath/boxselect/form/field/BoxSelect.js",
        "Ext.ux.layout.component.field.BoxSelectField": "@uxPath/boxselect/layout/component/field/BoxSelectField.js",
        'Ext': '@extPath'
        });
    Ext.ns('Taco');
    Taco.baseCSSPrefix = 'taco-';

    (function () {
        var oldClassPathMappings = Ext.Loader.addClassPathMappings;
        Ext.Loader.addClassPathMappings = function (classPaths) {
            for (var cls in classPaths) classPaths[cls] = "@Url.Content("~/Scripts")/" + classPaths[cls];
            oldClassPathMappings.call(Ext.Loader, classPaths);
            // only do this once
            Ext.Loader.addClassPathMappings = oldClassPathMappings;
        };
    }());

    </script>
    @*<script src="@bootStrapPath"></script>*@
    <script src="@appJsPath"></script>


  

</head>

<body data-current-user="@System.Environment.UserName"></body>

</html>

