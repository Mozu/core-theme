@using System.Diagnostics
@using System.Web.Configuration
@using Mozu.Core.Api.Contracts
@using Mozu.SiteBuilder.Mvc
@using Mozu.SiteBuilder.UX.Admin.Api
@using Newtonsoft.Json
@using Mozu.Core.Settings;
@using User = Mozu.SiteBuilder.UX.Admin.Api.Models.Account.User
<script>
    @{

        bool debugLayouts = WebConfigurationManager.AppSettings["extDebugLayout"] == "true";
        string assFile = typeof (AccountController).Assembly.Location;
        DateTime verDate = File.GetCreationTime(assFile);
        FileVersionInfo ver = FileVersionInfo.GetVersionInfo(assFile);

        var user = (User) ViewData["user"];
        int[] behaviors = user.BehaviorIds;
        var siteRoles = (List<UserRole>) ViewData["siteRoles"];
        List<UserRole> siteRolesJson = siteRoles;

        object taContext = ViewData["taContext"];
        object siteUsers = ViewData["siteUsers"];
        string extPath = WebConfigurationManager.AppSettings["extPath"];

        var paymentApiBaseUrl = MozuConfigurationManager.Urls("service-url-StorefrontCardsWebApi");

        object locValues = ViewData["localizationValues"];

        var windowTaco = new
                             {
                                 baseCSSPrefix = "taco-",
                                 testHarnessMode = Context.Request["testHarnessMode"] == "true",
                                 adminRelPath = @Url.Content("~"),
                                 cdnPrefix = Mozu.Core.Settings.MozuConfigurationManager.AppSettings("CdnHost"),
                                 User = new
                                            {
                                                id = user.Id, behaviors, taContext,
                                                email = user.EmailAddress,
                                                sites = siteRolesJson,
                                                name = (user.FirstName + " " + user.LastName).Trim()
                                            },
                                 apiVersion = ver.FileVersion,
                                 localizationValues = locValues, paymentApiBaseUrl,
                                 buildDate = verDate,
                                 siteUsersRaw = siteUsers,
                             extensiblity = new{
                                 subNavLinks = ViewData["adminSubNavExtensibilty"]
                             },
                             tenantSettings = ViewData["tenantGlobalSettings"]
                             };
    };

    window.Taco = @Html.Raw(JsonConvert.SerializeObject(windowTaco,Newtonsoft.Json.Formatting.None,CaseInsensitiveJsonSerializerSettings.Default));

    window.Taco.extensiblity = window.Taco.extensiblity || {};
    

    window.Taco.adminAppPath = window.location.protocol + "//" + window.location.host + '@Url.Content("~")';
    @if (ViewData["useGoogleAnalytics"] as string == "true")
    {
        @Html.Raw("window.Taco.googleAnalyticsAccountId = \"" + @ViewData["googleAnalyticsAccount"] + "\";")
        ;
    };
    window.History = {
        baseHrefOverride: Taco.adminAppPath
    };
</script>