@using System.Web.Configuration;
<script>
    @{
            
            var debugLayouts = WebConfigurationManager.AppSettings["extDebugLayout"] == "true";
            var assFile = typeof(Mozu.SiteBuilder.UX.Admin.Api.AccountController ).Assembly.Location;
            var verDate = System.IO.File.GetCreationTime(assFile);
            var ver = System.Diagnostics.FileVersionInfo.GetVersionInfo(assFile);
            var site = (Mozu.Tenant.Contracts.Site)ViewData["site"];
            var user = (Mozu.SiteBuilder.UX.Admin.Api.Models.Account.User)ViewData["user"];
            var siteRoles = (List<Mozu.Core.Api.Contracts.Role>)ViewData["siteRoles"];
            var siteRolesJson = Newtonsoft.Json.JsonConvert.SerializeObject(siteRoles);
            var siteJson = Newtonsoft.Json.JsonConvert.SerializeObject(site);
            
            var extPath = WebConfigurationManager.AppSettings["extPath"];
            var dashboardInstructionsLoc = WebConfigurationManager.AppSettings["admin.dashboardInstructions.loc"];
            var dashboardInstructions = "";
            if ( !string.IsNullOrEmpty (dashboardInstructionsLoc ))
            {
                try{
                    using ( var client = new System.Net.WebClient())
                    {
                        dashboardInstructions = Newtonsoft.Json.JsonConvert.ToString(client.DownloadString(dashboardInstructionsLoc));
                    }
                }
                catch{
                }
            }
        dashboardInstructions = dashboardInstructions ?? "";
        }
    
        
      
    window.Taco = {
        baseCSSPrefix :'taco-',
        testHarnessMode:@((Context.Request["testHarnessMode"]=="true").ToString().ToLowerInvariant() ),
        adminAppPath: window.location.protocol + "//" + window.location.host + '@Url.Content("~")',
        adminRelPath:'@Url.Content("~")',
        User : { id: '@user.Id'  , email: '@user.EmailAddress', sites: @Html.Raw(siteRolesJson), name: '@user.FirstName @user.LastName'.trim() },
        siteInfo : @Html.Raw(siteJson),
        apiVersion: '@ver.FileVersion',
        dashBoardInstructions :  @Html.Raw(string.IsNullOrEmpty(dashboardInstructions) ? "'tbd'": dashboardInstructions) ,
        buildDate : new Date ('@verDate')

        @if (Convert.ToBoolean(ViewData["useGoogleAnalytics"])) {
            <text>,googleAnalyticsAccountId: "@ViewData["googleAnalyticsAccount"]"</text>
        }

    };
        
    window.History = {
        baseHrefOverride: Taco.adminAppPath
    };
</script>