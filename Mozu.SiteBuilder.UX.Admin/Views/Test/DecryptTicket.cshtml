@using Newtonsoft.Json
@{
    Layout = null;
    var lwuc = ViewData["user"] as Mozu.Core.LightweightUserClaims;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>DecryptTicket</title>
</head>
<body>
    <div>
        <form method="POST">
            <input type="text" name="ticket" style="width:100%"/>
             <input type="submit"/>
        </form>
       
    </div>
    @if (lwuc != null){
     
        <div >
            <pre><code>
            @Newtonsoft.Json.JsonConvert.SerializeObject(lwuc,Formatting.Indented  )
                </code></pre>
        </div>
         
     }
</body>
</html>
