@using Mozu.SiteBuilder.UX.Models.Admin
@model List<TaContext>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/generic.cshtml";
}
@Html.Partial("mozuheader")

    <style type="text/css">
        #mozu-header {
            padding: 0.4pc;
        }
        #mozu-header img {
            height: 20px;
        }
    </style>


<div class="containerWrapper">
<div class="rolesContainer">
    <a style="float:right" href="logout">Logout</a>
    <h2>Launchpad</h2>


    <div class="rolesWrapper">
        @foreach (var tenant in Model)
        {
            <fieldset>
                <legend>@tenant.Name</legend>
                <code>Id: @tenant.Id</code>
                <a class="prtyButton" style="float:right" href="ChangeTenant?id=@tenant.Id">Launch</a>
            </fieldset>
            @*<div class="role">
                <div class="deleteRole">
                    <a href="javascript:;" onclick="DeleteRole(this,@item.Item1.Id,@item.Item2)">&times;</a>
                </div>
                <div class="roleTitle">
                    <a class="nextgen" href="ChangeRole?id=@item.Item1.Id">@item.Item1.Name</a>
                </div>
                
                <div class="roleType">
                    (@(item.Item2 == 1 ? "Super Admin" : "Admin"))
                </div>
                $1$<code>Url: http://@(item.Item1.AssignedDomain !=null ? item.Item1.AssignedDomain.FullName :"[n/a]")</code>#1#
                <code>Site: @item.Item1.Id</code>
             
            </div>*@
        }
    </div>
</div><!-- #rolesContainer -->
</div>

<script>
    
    function DeleteRole(elm, site, role) {
        if (confirm('do you really want to remove this site from your available sites')) {
            $.ajax({
                url: "DeleteRole",
                data: { siteId: site, roleId: role },
                success: function (result) {
                    // alert('bing');
                    $(elm).parents('.role').remove();

                }
            });
        }
    }
</script>
