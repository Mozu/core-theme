@model Mozu.SiteBuilder.UX.Admin.Api.Models.Account.LoginUser
@{
    ViewBag.Title = "ResetPassword";
    Layout = "~/Views/Shared/generic.cshtml";
}

<div class="loginContainer">
    <h2>Reset Password</h2>
    
    <p class="instruction">Please enter your new password into each field and then hit the button below to make it offical, and proceed to your dashboard.</p>
    
    <form method="POST" action="">
        @Html.HiddenFor(x=> x.ConfirmationCode )
        @Html.HiddenFor(x=> x.EmailAddress  )
        <div>
            @Html.ValidationMessage("Password")
        </div>
        <div>
            <label>
                New Password<br>
                @Html.PasswordFor(x=> x.Password )
            </label>
        </div>
        <br>
        <div>
            @Html.ValidationMessage("confirmPassword")
        </div>
        <div>
            <label>
                Confirm Password<br>
                @Html.Password("confirmPassword")
            </label>
        </div>
    
        <div class="actionContainer">
            <a class="nextgen" href="./">Cancel</a>
            <input type="submit" class="prtyButton" value="Save and Login">
        </div>
    </form>
</div>