@model Mozu.SiteBuilder.UX.Admin.Api.Models.Account.LoginUser
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/generic.cshtml";
}

@Html.Partial("mozuheader")

<div class="containerWrapper">
<div class="loginContainer">
    
    @Html.ValidationSummary()<br>

    <form method="POST" action="/admin/auth/login">
        <table>
            <tr>
                <td>
                    <label for="username">E-mail</label>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.TextBoxFor(x=> x.EmailAddress )
                </td>
            </tr>
            <tr>
                <td>
                    @Html.ValidationMessage("EmailAddress")
                </td>
            </tr>
            <tr>
                <td>
                    <label for="password">Password</label>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.PasswordFor(x=> x.Password )
                </td>
            </tr>
            <tr>
                <td>
                    @Html.ValidationMessage("Password")
                </td>
            </tr>
            <tr>
                <td>
                    <a class="nextgen" href="/admin/auth/forgotpassword">Forgot Password</a>
                </td>
            </tr>
            <tr>
                <td align="right">
                    <input id="submitButton" type="submit" class="prtyButton" value="Login" />
                </td>
            </tr>
        </table>
        @Html.HiddenFor(x=> x.Invitation )
    </form>
    
    @if (System.Configuration.ConfigurationManager.AppSettings["showTestLogin"] != "false")
    {
        <ul>
    
            <li>Click <a href="#" onclick=" testUser() ">here</a> or <a href="#" onclick=" testUser('test_user2@volusion.com') ">here</a> for test login </li>

        </ul>
    }

</div>
</div>
<script>

    function testUser(email) {
        var f = window.document.forms[0];
        f["EmailAddress"].value = email || "test_user@volusion.com";
        f["Password"].value = "Password1";
        f.submit();

    }
    
</script>
