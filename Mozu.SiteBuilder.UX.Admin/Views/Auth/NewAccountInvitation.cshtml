@model Mozu.SiteBuilder.UX.Admin.Api.Models.Account.LoginUser
@{
    ViewBag.Title = "NewAccountInvitation";
    Layout = "~/Views/Shared/generic.cshtml";
}

<h2>NewAccountInvitation</h2>

<br />
<div class="loginContainer">

    @Html.ValidationSummary()<br>

    <form method="POST" >

        <table>
            <tr>
                <td>
                    <label for="firstname">First Name</label>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.TextBox("firstname")
                </td>
            </tr>
            <tr>
                <td>
                    <label for="lastname">Last name</label>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.TextBox("lastname")
                </td>
            </tr>
            <tr>
                <td>
                    <label for="password">Password</label>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.Password("password")
                </td>
            </tr>
            <tr>
                <td>
                    @Html.ValidationMessage("password")
                </td>
            </tr>
            <tr>
                <td align="right">
                    <input type="submit" class="prtyButton" /></td>
            </tr>
            
        </table>
        @Html.HiddenFor(x => x.Invitation)
        @Html.HiddenFor(x => x.EmailAddress)
        @Html.HiddenFor(x => x.SiteId )
        @Html.HiddenFor(x => x.TenantId )

    </form>

   

</div>
<script>

  
</script>

