@model Mozu.SiteBuilder.UX.Admin.Api.Models.Account.LoginUser
@{
    ViewBag.Title = "ForgotPassword";
    Layout = "~/Views/Shared/generic.cshtml";
}

<div class="loginContainer">
    <h2>Forgot Password</h2>

    <p class="instruction">No worries&hellip; we will send you instructions on how to reset your password. Please enter the email id you used to create your account.</p>

    <form method="POST" action="">
        <label>
            Email<br>
            @Html.TextBoxFor(x=> x.EmailAddress , new { type="email" , required="required"} )
        </label>

        <div>
            @Html.ValidationMessage("EmailAddress")
        </div>
        
        <p class="ajaxSuccess">Good news!  An email message with a link to reset your password is on its way to your inbox.  (You can safely close this window now.)</p>
        <p class="ajaxFailure">Uh oh, we seem to have encountered some difficulty with finding that email address.  Could you double check the spelling and try again?</p>

        <div class="actionContainer">
            <a class="nextgen" href="./">Cancel</a>
            <input type="submit" class="prtyButton" value="Send Email">
        </div>
    </form>

</div>

<script>
    (function ($) {
        // *** Get submit button, do AJAX instead, cancel submit event
        $(':submit').click(function () {
            $.post("/admin/auth/forgotpassword",
                $("form").serialize(),
                function (response) {
                // console.log("response:", response, typeof response);
                
                if (response === true) {
                    $('.actionContainer').hide();
                    $('.ajaxSuccess').show(400);
                } else {
                    $('.ajaxFailure').show(400);
                }
            });
            return false;
        });
    })(jQuery);
</script>