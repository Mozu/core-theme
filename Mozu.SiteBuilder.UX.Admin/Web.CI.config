<?xml version="1.0" encoding="utf-8"?>

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <appSettings >
    <add key="Environment" value="CI" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="authCookieDomain" value="mozu-ci.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
    <add key="authCookieName" value="sbAdminAuthCI" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  </appSettings>

</configuration>