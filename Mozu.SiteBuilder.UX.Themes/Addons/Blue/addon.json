{
    /* About: Basic Information about the theme. */
    "about": {
        "name": "blue",
        "author": "Volusion",
        "isDesktop": true,
        "isMobile": false,
        "isTablet":  false
    },

    /* Settings: options for your theme. */
    "settings": [

        /* Common settings used in templates and CSS */
        {
            "id": "defaultPageSize",
            "defaultValue": 1
        }, {
            "id": "blueSetting",
            "defaultValue": "blue"
        },


    ],
    /* Page Types: Users will be allowed to create documents of this type in the CMS */
    "pageTypes": [

        /* user-creatable webpages */
        {
            "id": "blue_page",
            "title": "blue Page",
            "entityType": "webpage",
            "documentType": "web_page",
            "template": "blue-page",
            "userCreatable": true,
            /* list of widgets attached to this type of page by default */
            "widgets": [{
                "definitionId": "content",
                "zoneId": "body",
                "index": 0,
                "config": {
                    "body": "<p>This is blue text/p>"
                }
            }]
        }

    ],
    /* widgets */
    "widgets": [{
            "id": "blue_widget",
            "displayName": "Blue Widget",
            "displayTemplate": "blue/blue",
            "icon": "blue.png",
            "editViewFields": [{
                "name": "color"
            }],
            "defaultConfig": {
                "color": "#0000FF"
            }
        }

    ]
}