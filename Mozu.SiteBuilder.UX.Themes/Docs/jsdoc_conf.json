{
	"tags"      : {
		"allowUnknownTags" : true
	},
    "source": {
        "include": ["../Themes/Core4/scripts"],
        "excludePattern": "vendor"
    },
	"plugins"   : ["plugins/markdown"],
	"templates" : {
		"cleverLinks"     : false,
		"monospaceLinks"  : false,
		"default"         : {
			"outputSourceFiles" : true
		},
		"systemName"      : "Mozu Core4 Theme Modules",
		"footer"          : "",
		"copyright"       : "&copy; 2013-2014 Volusion, Inc.",
		"navType"         : "vertical",
		"theme"           : "cosmo",
		"linenums"        : true
	},
	"markdown"  : {
		"parser"   : "gfm"
	},
    "opts": {
        "destination": "./built",
        "recurse": true,
        "lenient": true,
        "verbose": true,
        "template": "node_modules/ink-docstrap/template"
    }
}