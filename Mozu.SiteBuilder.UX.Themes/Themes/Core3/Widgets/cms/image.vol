<div class="mz-image-wrap" {% data_attributes Model%}>
  {% if not Model.Image_url  %}
    <img {% data_attributes Model.Image_Url %} src ="/admin/scripts/resources/images/AddPhotos.png" alt = "Kind of a big deal" />
  {% else %}
    <img {% data_attributes Model.Image_Url %} src ="{{Model.Image_url.src}}" alt = "{{Model.Image_url.alt}}" width="{{Model.Image_url.width}}" height="{{Model.Image_url.height}}" />
  {% endif %}
</div>