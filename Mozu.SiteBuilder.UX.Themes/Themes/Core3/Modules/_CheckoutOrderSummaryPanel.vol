<div class="mz-panel mz-order-summary-panel" id="mz-order-summary-panel">
    <h3 class="mz-panel-header">
        Order Summary
        <button type="button" data-bind="click: editCart">Edit</button>
    </h3>

    <div id="mz-order-summary" class="mz-order-summary">
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Each</th>
                    <th>Total</th>
                </tr>
            </thead>
            <!-- ko foreach: Items -->
                <tbody>
                    <tr class="mz-line-item" data-bind="css: { 'mz-discounted': $data.DiscountTotal }">
                        <td data-bind="text: Product.Name "></td>
                        <td data-bind="text: Quantity"></td>
                        <td><span class="mz-item-price" data-bind="currencyText: UnitPrice.BaseAmount"></span></td>
                        <td><span class="mz-item-price" data-bind="currencyText: Subtotal"></span></td>
                    </tr>
                    <!-- ko if: DiscountTotal && DiscountTotal != Subtotal -->
                        <tr class="mz-line-item mz-discount">
                            <td colspan="2">
                                <!-- ko if: $data.Discount -->
                                    <span class="mz-discount-name" data-bind="text: Discount.Name"></span> 
                                    <span class="mz-discount-amt" data-bind="visible: Discount.FreeShipping">Free Shipping</span>
                                <!-- /ko -->
                                <span class="mz-discount-amt" ><span data-bind="currencyText: DiscountTotal"></span> OFF</span>
                            </td>
                            <td><span data-bind="currencyText: UnitPrice.DiscountedAmount"></span></td>
                            <td><span data-bind="currencyText: Total"></span></td>
                        </tr>
                    <!-- /ko -->
                </tbody>
            <!-- /ko -->
          
            <tbody>
                <tr class="mz-cost-summary">
                    <td class="mz-line-item-summary" colspan="4">
                        <table>
                            <tbody>
                            <!-- ko foreach: OrderDiscounts -->
                            <!-- ko if: !Excluded -->
                                <tr>
                                    <td><!-- ko text: Discount.Name --><!-- /ko -->:</td>
                                    <td><span data-bind="currencyText: -Impact"></span></td>
                                </tr>
                            <!-- /ko -->
                            <!-- /ko -->
                                <tr>
                                    <td>Sub-Total:</td>
                                    <td><span data-bind="currencyText: DiscountedTotal"></span></td>
                                </tr>
                                <tr class="mz-shipping-total-row">
                                    <td>Shipping &amp; Handling:</td>
                                    <td><span data-bind="currencyText: ShippingTotal"></span></td>
                                </tr>
                            <!-- ko if: HandlingAmount -->
                                <tr>
                                    <td>Additional Handling:</td>
                                    <td><span data-bind="currencyText: HandlingAmount"></span></td>
                                </tr>
                            <!-- /ko -->
                                <tr>
                                    <td>Tax:</td>
                                    <td><span data-bind="currencyText: TaxTotal"></span></td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
            <tbody>
                <tr class="mz-total">
                    <td class="mz-line-item-summary" colspan="4">Total: <span data-bind="currencyText: Total"></span></td>
                </tr>
            </tbody>
        </table>
    </div><!-- #order-summary -->

</div><!-- Order Summary .panel -->