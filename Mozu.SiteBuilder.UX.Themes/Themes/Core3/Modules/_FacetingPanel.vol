<section class="mz-faceting-form">
    <div class="mz-sidebar-item">
        <input type="checkbox" id="mz-faceting-clearall-1" class="mz-faceting-option" data-mz-action="clearfacets" data-bind="event: { change: clearAllFacets }"><label for="mz-faceting-clearall-1">Clear All Filters</label>
    </div>
    <!-- ko foreach: Facets -->
    <div class="mz-sidebar-item">
        <h4 data-bind="text: Label"></h4>
      <!-- ko if: FacetType === "Value" -->
        <ul class="mz-faceting-group">
            <li>
                <input type="checkbox" class="mz-faceting-option" data-bind="checked: empty, id: emptyId, disable: $root.submitting"><label data-bind="for: emptyId">All</label>
            </li>
            <!-- ko foreach: Values -->
            <li>
                <input type="checkbox" class="mz-faceting-option" data-bind="checked: IsApplied, attr: { id: id }, disable: $root.submitting"><label data-bind="attr: { for: id }, text: Label"></label>
            </li>
            <!-- /ko -->
        </ul>
      <!-- /ko -->
      <!-- ko if: FacetType === "RangeQuery" -->
        <p>Range query goes here.</p>
      <!-- /ko -->
    </div>
    <!-- /ko -->
    <div class="mz-sidebar-item">
        <input type="checkbox" id="mz-faceting-clearall-2" class="mz-faceting-option" data-mz-action="clearfacets" data-bind="change: clearAllFacets, disable: $root.submitting"><label for="mz-faceting-clearall-2">Clear All Filters</label>
    </div>
</section>