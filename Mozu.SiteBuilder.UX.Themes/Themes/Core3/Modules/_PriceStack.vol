<div class="mz-price-stack-wrap">		
		<div class="mz-price-label">{{Model.ProductCode}}</div>
    <div class="mz-price-sub-wrap">
        {% if Model.price.price != Model.price.offerPrice %}
            <div class="mz-price-amt mz-strikethrough">
                {{Model.price.price|currency}}
            </div>
            <div class="mz-price-saleprice mz-price-amt">
                {% if Model.price.hasDiscount %}
                    <span class="mz-price-discount-name">{{Model.price.discountName}} &ndash;</span>
                {% endif %}
                {{Model.price.offerPrice|currency}}
            </div>
        {% else %}
        <div class="mz-price-amt">
            {{Model.price.price|currency}}
        </div>
        {% endif %}
        <div class="mz-dotted-spanner">.</div>
    </div>
</div>