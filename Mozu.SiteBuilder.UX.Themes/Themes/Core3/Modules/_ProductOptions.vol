{% if Model.Options %}
<div class="mz-details-configurator-wrap" data-bind="with: Options">
    <h3 class="mz-configurator-head">Choose your options...</h3>
    <div class="mz-configurator" data-bind="visible: $data.length > 0, foreach: $data">
        <strong class="mz-required" data-bind="visible: IsRequired">*</strong>
        <strong class="mz-option-name" data-bind="text: AttributeDetail.Name"></strong>: 
        <!-- ko if: AttributeDetail.InputType == 'List' -->
            <!-- ko if: IsMultiValue -->
                <select class="mz-multiselect mz-option" multiple data-bind="disable: $root.submitting, selectedOptions: Value, options: Values, optionsText: 'Value', optionsValue: 'Value'"></select>
            <!-- /ko -->
            <!-- ko if: !IsMultiValue -->
                <select class="mz-dropdown mz-option" data-bind="disable: $root.submitting, value: Value, options: Values, optionsCaption: '[Select]', optionsText: 'Value', optionsValue: 'Value'">
                </select>
            <!-- /ko -->
        <!-- /ko -->
        <!-- ko if: AttributeDetail.ValueType == 'ShopperEntered' -->
            <input
                class="mz-textbox mz-option"
                type="text"
                data-bind="value: ShopperEnteredValue, disable: $root.submitting"
            >
        <!-- /ko -->
    </div>
</div>
{% endif %}