<div class="mz-paging-wrap">
	<form class="mz-paging-form">
		<label>Sort by:</label>
		<select name="sortBy" class="mz-paging-sorting">
			{% for item in Model.Sorts %}
				<option {{item.selected|yesno:"selected, , "}} value="{{item.Value}}">{{item.Text}}</option>
			{%endfor%}
		</select>
		<select class="mz-paging-pagesize" name="itemsPerPage">
			{% for item in Model.PageSizes %}
				<option {{item.selected|yesno:"selected, , "}} value="{{item.Value}}" >{{item.Text}}</option>
			{%endfor%}
		</select>
	</form>  
  

</div>