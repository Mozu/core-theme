<tr>
    <td colspan="5" align="right">
        <em class="mz-auxiliary-text">Tax &amp; Shipping Calculated at Checkout</em>
    </td>
</tr>

<!-- ko foreach: OrderDiscounts -->
<!-- ko if: !Excluded -->
<tr class="mz-cart-total-row">
  <td class="mz-cart-total-label" colspan="3" align="right">
    <!-- ko text: Discount.Name --><!-- /ko -->:
  </td>
  <td class="mz-cart-total-wrap" colspan="2" align="right">
    <span class="mz-cart-rowtotal" data-bind="currencyText: -Impact"></span>
  </td>
</tr>
<!-- /ko -->
<!-- /ko -->


<tr class="mz-cart-total-row">
    <td class="mz-cart-total-label" colspan="3" align="right">
        Order Total:
    </td>
    <td class="mz-cart-total-wrap" colspan="2" align="right">
        <strong><span id="mz-cart-total" class="mz-cart-total" data-bind="currencyText: DiscountedTotal"></span></strong>
    </td>
</tr>
<tr> 
    <td colspan="5" align ="right">
        <input type="hidden" name="Id" value="{{ Model.Id }}" />
            <!-- ko if: submitting -->
                {% include "Modules/LoadingBar" %}
            <!-- /ko -->
        <button id="checkout" class="mz-button mz-btn-checkout mz-btn-cta"  {% if Model.Items.Count == 0 %} disabled="disabled" {% endif %} data-bind="click: proceedToCheckout, enable: canCheckout, visible: !submitting()">Proceed to Checkout</button>
    </td>
</tr>