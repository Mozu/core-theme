<div id="mz-coupon-code-container" class="mz-coupon-code-container" data-bind="css: { 'mz-submitting-coupon': submittingCoupon }">
    <label for="coupon-code">Coupon Code</label>
    <input type="text" id="mz-coupon-code" name="coupon-code" data-bind="value: CouponCode">
    <button type="button" class="mz-submit-button" data-bind="click: addCoupon">Apply</button>
    {% include "Modules/LoadingBar" %}
</div>