{% for prod in Model %}
	<div class="mz-featured-products-widget">
		<figure class="mz-product-image mz-featured-product-image">
		  <a href={{prod.url}}>
			<img {% data_attributes prod.images.main %} src="{{prod.images.main.resize.100.src}}" height="100" />
		  </a>
		</figure>
		<div class="mz-featured-product-caption">
		  <a class="mz-featured-products-link" href={{prod.url}}>
			<span {% data_attributes prod.name %}>{{prod.name}}</span>
		  </a>
		 <span class="mz-product-price">{{prod.price.offerPrice|currency}}</span>
		</div>
	</div>
{% endfor %} 