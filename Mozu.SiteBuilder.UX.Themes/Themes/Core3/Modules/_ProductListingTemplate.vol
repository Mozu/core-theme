<script type="text/html" id="mz-tpt-product-listing">
<div class="mz-product-listing-wrap">
	<!-- ko if: $data.length -->
		<ul class="mz-list-control" data-items-per-row="3">
			<!-- ko foreach: $data -->
				<li class="mz-list-item">
					<div class="mz-product-item-wrap">
						<div class="mz-product-image-wrap">
							<a class="mz-product-image-link" data-bind="attr: { href: '/product/' + ProductCode }">
								<img data-bind="attr: { src: (Content.ProductImages[0] && Content.ProductImages[0].ImageUrl || 'http://placehold.it/160&text=Missing+Photo') + '?size=160' } " class="mz-product-image">
							</a>
						</div>

						<div class="mz-product-info-wrap">
							<a class="mz-product-title-link" data-bind="attr: { href: '/product/' + ProductCode }, text: Content.ProductName "></a>

							<div class="mz-price-stack-wrap">       
								<div class="mz-price-label" data-bind="text: ProductCode"></div>
								<div class="mz-price-sub-wrap" data-bind="with: Price">
									<!-- ko if: SalePrice() && (Price() !== SalePrice()) -->
									<div class="mz-price-amt mz-strikethrough" data-bind="currencyText: Price"></div>
									<div class="mz-price-saleprice">
										<!-- ko if: $data.Discount && $data.Discount.Discount -->
										<span class="mz-price-discount-name" data-bind="text: Discount.Discount.Name + ' &ndash;'"></span>
										<!-- /ko -->
										<span class="mz-price-amt" data-bind="currencyText: SalePrice"></span>
									</div>
									<!-- /ko -->
									<!-- ko if: !SalePrice() || Price() === SalePrice() -->
									<div class="mz-price-amt" data-bind="currencyText: Price"></div>
									<!-- /ko -->
								</div>
							</div>
						</div> <!-- .mz-product-info-wrap -->

					</div> <!-- .mz-product-item-wrap -->

				</li> <!-- .mz-list-item -->
                <!-- ko if: $root.isItemModulus($index, 3) -->
                  <li class="mz-list-spacer"></li>
                <!-- /ko -->
			<!-- /ko -->
		</ul>
	<!-- /ko -->
</div>
</script>