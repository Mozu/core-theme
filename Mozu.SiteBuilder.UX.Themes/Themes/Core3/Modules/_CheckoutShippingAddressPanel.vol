{% comment %}
    Note that this panel requires the AddressSummaryTemplate and AddressFormTemplate modules to be present on the page, since they are bound by the #mz-completed-summary and #mz-form-fields divs.
{% endcomment %}
<div class="mz-panel" id="mz-shipping-address-panel" data-bind="with: ShippingInfo.ShippingContact, cssClassFrom: ShippingInfo.ShippingContact.stepStatus(), cssClassFromPrefix: 'mz-stepstatus-'">
    <h3 class="mz-panel-header">
        Shipping Information
        <button class="mz-edit-button" data-bind="click: edit">Edit</button>
    </h3>
    <div class="mz-panel-wrap">
        <div class="mz-inner-panel" data-bind="changeHeightOn: stepStatus() + Address.CountryCode()">
            <p class="mz-desc">Where to?</p>
            <div class="mz-completed-summary" data-bind="template: 'mz-tpt-address-summary'"></div>
            <div class="mz-form-fieldgroup mz-form-fields" data-bind="template: 'mz-tpt-address-form'"></div>
            <div class="mz-next-step">
                {% include "Modules/LoadingBar" %}
                <button type="button" class="mz-submit-button" data-bind="click: nextStep, text: nextButtonText"></button>
            </div>
        </div><!-- .mz-inner-panel -->
    </div>
</div><!-- Step 1 .panel -->