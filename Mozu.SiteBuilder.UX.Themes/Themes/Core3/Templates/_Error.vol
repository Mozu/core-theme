{% extends "default" %}

{% block Init %}
    {% setTemplateVariables BodyTagClasses="mz-error-page" %}
    {{ block.super }}
{% endblock Init %}

{% block BodyContent %}
<div id="mz-error-page" class="mz-error-page" >

	<h2 class="mz-error-head">Oh, heavens. <span class="mz-error-subhead">We did warn you about errors.</span><span class="mz-error-text">{{Model.Message}}</span></h2>
	<a href="javascript:;" id="mz-error-detail-link" class="mz-error-detail-expander">the gory details</a>
	<blockquote id="mz-error-detail" class="mz-error-detail">
	<pre><code>{% dump Model %}</code></pre>
	</blockquote>
</div>
{% require_script "pages/error" %}
{% endblock BodyContent %}