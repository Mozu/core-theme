{% extends "default" %}
{% setTemplateVariables BodyTagClasses="checkout" %}

{% block Init %}
{% require_script "pages/checkout" %}
{% endblock Init %}

{% block BodyContent %}

<div id="mz-checkout-loading" class="mz-checkout-loading">
    <p>
        <em>Please wait...</em>
    </p>
    {% include "Modules/LoadingBar" %}
</div>

<form id="mz-checkout-form" class="mz-checkout-form" style="visibility: hidden" method="post" action="" onsubmit="return false;" 
    data-mz-checkout="{% json_attribute Model.order %}" 
    data-mz-paymentapibase="{{ Model.paymentApiBase }}" 
    data-mz-shippingmethods="{% json_attribute Model.availableShippingMethods %}"
    data-bind="css: { 'mz-submitting': submitting }">
    <h1 class="mz-page-header">
        Checkout{% if not user.email %}
        <span class="mz-page-headernote mz-auxiliary-text mz-mini-modal-parent">Registered Customer? <a class="mz-utility-link mz-login" data-mz-action="login" href="javascript:;">Sign in</a>
            {% include "Modules/LoginModal" %}
        </span>
        {% endif %}
    </h1>

    <div class="mz-messages">
        <ul data-bind="visible: messages().length > 0, foreach: messages" class="mz-errors">
            <li data-bind="text: message"></li>
        </ul>
    </div>

    <div class="mz-column" id="mz-checkout-rightcol">
        <div class="mz-panel mz-order-summary-panel" id="mz-order-summary-panel">
            <h3 class="mz-panel-header">
                Order Summary
                <button data-bind="click: editCart">Edit</button>
            </h3>

            <div id="mz-order-summary" class="mz-order-summary">
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Each</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <!-- ko foreach: Items -->
                    <tbody>
                        <tr class="mz-line-item" data-bind="css: { 'mz-discounted': DiscountTotal != Subtotal }">
                            <td data-bind="text: Product.Name "></td>
                            <td data-bind="text: Quantity"></td>
                            <td><span class="mz-item-price" data-bind="currencyText: Product.Price"></span></td>
                            <td><span class="mz-item-price" data-bind="currencyText: Subtotal"></span></td>
                        </tr>
                        <!-- ko if: false -->
                        <tr class="mz-line-item mz-discount">
                            <td colspan="2">
                                <span class="mz-discount-name" data-bind="text: Discount.Name"></span> 
                                <span class="mz-discount-amt" data-bind="visible: Discount.FreeShipping">Free Shipping</span>
                                <span class="mz-discount-amt" data-bind="visible: !Discount.FreeShipping"><span data-bind="currencyText: Product.Price - Discount.SalePrice"></span> OFF</span>
                            </td>
                            <td><span data-bind="currencyText: Discount.SalePrice"></span></td>
                            <td><span data-bind="currencyText: Discount.SalePrice * quantity"></span></td>
                        </tr>
                        <!-- /ko -->
                    </tbody>
                    <!-- /ko -->
                    <tbody>
                        <tr class="mz-cost-summary">
                            <td class="mz-line-item-summary" colspan="4">
                                <table>
                                    <tr>
                                        <td>Sub-Total:</td>
                                        <td><span data-bind="currencyText: Subtotal"></span></td>
                                    </tr>
                                    <tr class="mz-shipping-total-row">
                                        <td>Shipping &amp; Handling:</td>
                                        <td><span data-bind="currencyText: ShippingTotal"></span></td>
                                    </tr>
                                    <tr>
                                        <td>Tax:</td>
                                        <td><span data-bind="currencyText: TaxTotal"></span></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                    <tbody>
                        <tr class="mz-total">
                            <td class="mz-line-item-summary" colspan="4">Total: <span data-bind="currencyText: Total"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div><!-- #order-summary -->

        </div><!-- Order Summary .panel -->

        <div id="mz-coupon-code-container" class="mz-coupon-code-container" data-bind="css: { 'mz-submitting-coupon': submittingCoupon }">
            <label for="coupon-code">Coupon Code</label>
            <input type="text" id="mz-coupon-code" name="coupon-code" data-bind="value: CouponCode">
            <button class="mz-submit-button" data-bind="click: addCoupon">Apply</button>
            {% include "Modules/LoadingBar" %}
        </div>

        <label>
            Comments
            <textarea id="mz-order-comments" class="mz-order-comments" name="comments" data-bind="value: Note.Text"></textarea>
        </label>

    </div><!-- right .column -->
    <div class="mz-column">
        <div class="mz-panel" id="mz-shipping-address-panel" data-bind="with: Shipment.ShippingAddress, cssClassFrom: Shipment.ShippingAddress.stepStatus(), cssClassFromPrefix: 'mz-stepstatus-'">
            <h3 class="mz-panel-header">
                Shipping Information
                <button class="mz-edit-button" data-bind="click: edit">Edit</button>
            </h3>
            <div class="mz-panel-wrap">
                <div class="mz-inner-panel" data-bind="changeHeightOn: stepStatus() + Address.CountryCode()">
                    <p class="mz-desc">Where to?</p>
                    <div class="mz-completed-summary" data-bind="template: 'address-summary'"></div>
                    <div class="mz-form-fieldgroup mz-form-fields" data-bind="template: 'address-form'"></div>
                    <div class="mz-next-step">
                        {% include "Modules/LoadingBar" %}
                        <button class="mz-submit-button" data-bind="click: nextStep, text: nextButtonText"></button>
                    </div>
                </div><!-- .mz-inner-panel -->
            </div>
        </div><!-- Step 1 .panel -->


        <div class="mz-panel" id="mz-shipping-method-panel" data-bind="with: Shipment, cssClassFrom: Shipment.stepStatus(), cssClassFromPrefix: 'mz-stepstatus-'">
            <h3 class="mz-panel-header">
                Shipping Method
                <button class="mz-edit-button" data-bind="click: edit">Edit</button>
            </h3>
            <div class="mz-panel-wrap">
                <div class="mz-inner-panel" data-bind="changeHeightOn: stepStatus() + availableShippingMethods()">
                    <p class="mz-desc">How to send it?</p>
                    <div class="mz-completed-summary mz-inline">
                        <strong data-bind="text: ShippingMethodName"></strong> (<span data-bind="currencyText: Price.Price"></span>)
                    </div>
                    <div class="mz-form-fields">
                    <!-- ko if: availableShippingMethods().length > 0 -->
                        <div data-bind="foreach: availableShippingMethods">
                            <label class="mz-inline">
                                <input type="radio" name="shippingMethod" data-bind="value: ShippingMethodCode, checked: $parent.ShippingMethodCode">
                                <span data-bind="text: ShippingMethodName"></span> <span class="mz-shipping-price"><span data-bind="currencyText: Price"></span></span>
                            </label>
                        </div>
                    <!-- /ko -->

                        <div class="mz-next-step">
                            {% include "Modules/LoadingBar" %}
                            <button class="mz-submit-button" data-bind="click: nextStep, text: nextButtonText">Next</button>
                        </div>
                    </div>
                </div><!-- .mz-inner-panel -->
            </div>
        </div><!-- Step 2 .panel -->

        <div class="mz-panel" id="mz-payment-information-panel" data-bind="with: Payment, cssClassFrom: Payment.stepStatus(), cssClassFromPrefix: 'mz-stepstatus-'">
            <h3 class="mz-panel-header">
                Payment Information
                <button class="mz-edit-button" data-bind="click: edit">Edit</button>
            </h3>
            <div class="mz-panel-wrap">
            <div class="mz-inner-panel" data-bind="changeHeightOn: stepStatus() + Card.IsSameBillingShippingAddress() + PaymentType()">
                <p class="mz-desc">How to bill?</p>
                <div class="mz-completed-summary">
                    <span data-bind="text: PaymentType"></span>
                    <span data-bind="visible: paymentTypeIsCheck, text: Check.CheckNumber"></span>
                    <!-- ko if: paymentTypeIsCreditCard -->
                        <span data-bind="text: Card.CardNumberPartOrMask"></span>

                        <h4>Billing Address</h4>
                        <!-- ko if: Card.IsSameBillingShippingAddress -->
                            <div data-bind="template: { name: 'address-summary', data: $root.Shipment.ShippingAddress }"></div>
                        <!-- /ko -->
                        <!-- ko if: !Card.IsSameBillingShippingAddress() -->
                            <div data-bind="template: { name: 'address-summary', data: Card.BillingAddress }"></div>
                        <!-- /ko -->

                        <h4>Billing Contact Information</h4>
                        <span>Phone: <strong data-bind="text: Card.BillingAddress.PhoneNumbers.Home"></strong></span>
                        <span>Email: <strong data-bind="text: Card.BillingAddress.Email"></strong></span>
                    <!-- /ko -->
                </div>

                <div class="mz-form-fields">
                <p class="mz-desc">
                    <select data-bind="value: PaymentType">
                        <option>Select payment method</option>
                        <option disabled value="CreditCard">Credit Card</option>
                        <option value="Check">Check by Mail</option>
                    </select>
                    <span class="mz-validation-message" data-bind="text: PaymentType.validationMessage() || '&nbsp;'"></span>
                </p>

                <!-- ko if: paymentTypeIsCreditCard -->
                <div class="mz-form-fieldgroup" data-bind="with: Card">
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="mz-payment-credit-card-type">Card Type<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <select id="mz-payment-credit-card-type" data-bind="value: PaymentOrCardType, css: {'mz-invalid': PaymentOrCardType.invalid() }">
                            {% comment %} TODO: Figure out how to get a live set of ccards {% endcomment %}
                            {% comment %}
                                <option></option>
                                {% for card in SiteContext.Settings.Checkout.PaymentSettings.SupportedCards %}
                                <option value="{{card.Key}}">{{card.Value}}</option>
                                {% endfor %}
                            {% endcomment %}
                                <option value="VISA">Visa</option>
                                <option value="MC">Mastercard</option>
                                <option value="AMEX">American Express</option>
                                <option value="DISCOVER">Discover</option>
                            </select>
                            <span class="mz-validation-message" data-bind="text: PaymentOrCardType.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="mz-payment-credit-card-number">Card Number<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" name="credit-card-number" id="mz-payment-credit-card-number" data-bind="value: CardNumberPartOrMask, css: {'mz-invalid': CardNumberPartOrMask.invalid() }">
                            <span class="mz-validation-message" data-bind="text: CardNumberPartOrMask.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="mz-payment-credit-card-name">Name on Card<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" name="credit-card-name" id="mz-payment-credit-card-name" data-bind="value: NameOnCard, css: {'mz-invalid': NameOnCard.invalid() }">
                            <span class="mz-validation-message" data-bind="text: NameOnCard.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="mz-payment-expiration-month">Expires<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <select class="mz-half-size" id="mz-payment-expiration-month" name="expiration-month" data-bind="value: ExpireMonth, css: {'mz-invalid': ExpireMonth.invalid() }">
                                <option></option>
                                <option value="01">01 - January</option>
                                <option value="02">02 - February</option>
                                <option value="03">03 - March</option>
                                <option value="04">04 - April</option>
                                <option value="05">05 - May</option>
                                <option value="06">06 - June</option>
                                <option value="07">07 - July</option>
                                <option value="08">08 - August</option>
                                <option value="09">09 - September</option>
                                <option value="10">10 - October</option>
                                <option value="11">11 - November</option>
                                <option value="12">12 - December</option>
                            </select>
                            <select class="mz-half-size" name="mz-payment-expiration-year" data-bind="value: ExpireYear, css: {'mz-invalid': ExpireYear.invalid() }">
                                <option></option>
                                <option value="2013">2013</option>
                                <option value="2014">2014</option>
                                <option value="2015">2015</option>
                                <option value="2016">2016</option>
                                <option value="2017">2017</option>
                                <option value="2018">2018</option>
                                <option value="2019">2019</option>
                                <option value="2020">2020</option>
                                <option value="2021">2021</option>
                                <option value="2022">2022</option>
                                <option value="2023">2023</option>
                            </select>
                            <span class="mz-validation-message" data-bind="visible: ExpireYear.invalid(), text: ExpireYear.validationMessage()">&nbsp;</span>
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="mz-payment-security-code">Security Code<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" name="security-code" id="mz-payment-security-code" class="mz-half-size" data-bind="value: CVV, css: {'mz-invalid': CVV.invalid() }">
                            <span class="mz-validation-message" data-bind="text: CVV.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell"></div>
                        <div class="mz-form-field-cell">
                            <label class="mz-inline"><input type="checkbox" name="save-card-info" data-bind="checked: IsCardInfoSaved"> Save credit card information</label>
                        </div>
                    </div>
                </div><!-- credit card fields-->

                <h4>Billing Address</h4>
                <div class="mz-single-setting"><label class="mz-inline"><input type="checkbox" data-bind="checked: Card.IsSameBillingShippingAddress"> Use my shipping address</label></div>
                <div class="mz-completed-summary mz-same-as-shipping-summary" id="mz-same-as-shipping-summary" data-bind="visible: Card.IsSameBillingShippingAddress, template: { name: 'address-summary', data: $root.Shipment.ShippingAddress}">
                </div>
                <div class="mz-form-fieldgroup mz-form-fields" data-bind="visible: !Card.IsSameBillingShippingAddress(), template: { name: 'address-form', data: Card.BillingAddress }"></div>

                <h4>Billing Contact Info</h4>
                <div class="mz-form-fieldgroup">
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="billing-phone">Phone:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" id="billing-phone" name="billing-phone" data-bind="value: Card.BillingAddress.PhoneNumbers.Home">
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="billing-email">Email<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" id="billing-email" name="billing-email" data-bind="value: Card.BillingAddress.Email, css: {'mz-invalid': Card.BillingAddress.Email.invalid() }">
                            <span class="mz-validation-message" data-bind="text: Card.BillingAddress.Email.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell"></div>
                        <div class="mz-form-field-cell">
                            <label class="mz-inline"><input type="checkbox" name="special-offers" checked style="float: left; margin-right: 8px;"> Yes! I want to be receive news<br>and special offers from you!</label>
                        </div>
                    </div>
                </div>
                <!-- /ko -->

                <div class="mz-form-fieldgroup" data-bind="visible: paymentTypeIsCheck, with: Check">
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="nameOnCheck">Name on check<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" name="nameOnCheck" id="nameOnCheck" data-bind="value: NameOnCheck, css: {'mz-invalid': NameOnCheck.invalid() }">
                            <span class="mz-validation-message" data-bind="text: NameOnCheck.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="checkNumber">Routing Number<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" name="checkNumber" id="checkNumber" data-bind="value: RoutingNumber, css: {'mz-invalid': RoutingNumber.invalid() }">
                            <span class="mz-validation-message" data-bind="text: RoutingNumber.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>                    
                    <div class="mz-form-field-row">
                        <div class="mz-form-field-cell">
                            <label for="checkNumber">Check Number<span class="mz-required-field"> *</span>:</label>
                        </div>
                        <div class="mz-form-field-cell">
                            <input type="text" name="checkNumber" id="checkNumber" data-bind="value: CheckNumber, css: {'mz-invalid': CheckNumber.invalid() }">
                            <span class="mz-validation-message" data-bind="text: CheckNumber.validationMessage() || '&nbsp;'"></span>
                        </div>
                    </div>
                <p><a href="#">Read more</a> about paying by check</p>
                </div><!-- pay by check fields -->


                </div>
                <div class="mz-next-step">
                    {% include "Modules/LoadingBar" %}
                    <button class="mz-submit-button" data-bind="click: nextStep">Next</button>
                </div>
            </div><!-- .mz-inner-panel -->
            </div>
        </div><!-- Step 3 .panel -->

        <div class="mz-panel mz-checkout-reviewpanel" id="mz-checkout-reviewpanel" data-bind="css: { 'mz-stepstatus-submitting': submitting }">
            <h3 class="mz-panel-header">
                Review & Place Order
            </h3>
            <div class="mz-panel-wrap">
            <div class="mz-inner-panel" data-bind="changeHeightOn: createAccount(), visible: orderStatus">
                <p class="mz-desc">Please review all of the information on this page and, if necessary, make changes before placing your order.</p>

                <label class='inline'>
                    <input type="checkbox" name="terms-and-conditions" id="mz-terms-and-conditions" data-bind="checked: agreeToTerms"> I agree to the <a href="javascript:;">terms &amp; conditions</a>.
                </label>
                <span class="mz-validation-message" data-bind="text: agreeToTerms.validationMessage() || '&nbsp;'"></span>

                {% if  User.isAnonymous %}
                <label class='inline'>
                    <input type="checkbox" name="create-new-account" data-bind="checked: createAccount"> Create an account for easy checkout on future orders
                </label>

                <div id="mz-create-account-fields" class="mz-create-account-fields" data-bind="visible: createAccount">
                    <label>
                        Username
                        <input type="text" name="new-account-email" data-bind="value: email, css: {'mz-invalid': email.invalid() }">
                        <span class="mz-validation-message" data-bind="text: email.validationMessage() || '&nbsp;'"></span>
                    </label>
                    <label>
                        Create password
                        <input type="password" name="new-account-password" data-bind="value: password, css: {'mz-invalid': password.invalid() }">
                    </label>
                    <label>
                        Confirm password
                        <input type="password" name="new-account-confirm" data-bind="value: confirmPassword, css: {'mz-invalid': confirmPassword.invalid() }">
                    </label>
                    <span class="mz-validation-message" data-bind="text: password.validationMessage() || '&nbsp;'"></span>
                    <span class="mz-validation-message" data-bind="text: confirmPassword.validationMessage() || '&nbsp;'"></span>
                </div>
                {% endif %}

                <div class="mz-next-step">
                    {% include "Modules/LoadingBar" %}
                    <button class="mz-submit-button mz-button mz-btn-cta" data-bind="click: submit">Place Order</button>
                </div>
            </div><!-- .mz-inner-panel -->
            </div>
        </div><!-- Step 4 .panel -->
    </div><!-- left .column -->

    <script type="text/html" id="address-summary">
        <span data-bind="text: FirstName() + ' ' + LastNameOrSurname()"></span>
        <span data-bind="text: Address.Address1()"></span>
        <span data-bind="text: Address.Address2(), visible: Address.Address2()"></span>
        <span data-bind="text: Address.Address3(), visible: Address.Address3()"></span>
        <span data-bind="text: Address.CityOrTown() + ', ' + Address.StateOrProvince() + ' ' + Address.PostalOrZipCode()"></span>
        <span data-bind="text: Address.CountryCode()"></span>
    </script>

    <script type="text/html" id="address-form">
   <div class="mz-form-field-row">
        <div class="mz-form-field-cell">
                <label for="firstname">First Name<span class="mz-required-field" data-bind="visible: FirstName.required"> *</span>:</label>
            </div>
            <div class="mz-form-field-cell">
                <input type="text" id="mz-shipping-address-firstname" name="firstname" data-bind="value: FirstName, css: { 'mz-invalid': FirstName.invalid() }">
                <span class="mz-validation-message" data-bind="text: FirstName.validationMessage() || '&nbsp;'"></span>
            </div>
        </div>
        <div class="mz-form-field-row">
            <div class="mz-form-field-cell">
                <label for="lastname">Last Name<span class="mz-required-field"> *</span>:</label>
            </div>
            <div class="mz-form-field-cell">
                <input type="text" id="mz-shipping-address-lastname" name="lastname" data-bind="value: LastNameOrSurname, css: { 'mz-invalid': LastNameOrSurname.invalid() }">
                <span class="mz-validation-message" data-bind="text: LastNameOrSurname.validationMessage() || '&nbsp;'"></span>
            </div>
        </div>
        <div class="mz-form-field-row">
            <div class="mz-form-field-cell">
                <label for="address-line-1">Address<span class="mz-required-field" data-bind="visible: Address.Address1.required"> *</span>:</label>
            </div>
            <div class="mz-form-field-cell">
                <input type="text" id="mz-shipping-address-line-1" name="address-line-1" data-bind="value: Address.Address1, css: { 'mz-invalid': Address.Address1.invalid() }">
                <span class="mz-validation-message" data-bind="text: Address.Address1.validationMessage() || '&nbsp;'"></span>
            </div>
        </div>
        <div class="mz-form-field-row">
            <div class="mz-form-field-cell"></div>
            <div class="mz-form-field-cell">
                <input type="text" id="mz-shipping-address-line-2" name="address-line-2" data-bind="value: Address.Address2">
                <span class="mz-validation-message">&nbsp;</span>
            </div>
        </div>
        <div class="mz-form-field-row">
            <div class="mz-form-field-cell">
                <label for="city">City<span class="mz-required-field"> *</span>:</label>
            </div>
            <div class="mz-form-field-cell">
                <input type="text" id="mz-shipping-address-city" name="city" data-bind="value: Address.CityOrTown, css: { 'mz-invalid': Address.CityOrTown.invalid() }">
                <span class="mz-validation-message" data-bind="text: Address.CityOrTown.validationMessage() || '&nbsp;'"></span>
            </div>
        </div>
        <div class="mz-form-field-row">
            <div class="mz-form-field-cell">
                <label for="country">Country<span class="mz-required-field"> *</span>:</label>
            </div>
            <div class="mz-form-field-cell">
                <select id="mz-shipping-address-country" data-bind="value: Address.CountryCode, options: Address.countryList, optionsCaption: 'Choose...', optionsText: 'CountryLabel', optionsValue: 'CountryCode', css: { 'mz-invalid': Address.CountryCode.invalid() }">
                </select>
                <span class="mz-validation-message" data-bind="text: Address.CountryCode.validationMessage() || '&nbsp;'"></span>
            </div>
        </div>
        <div class="mz-form-field-row" data-bind="visible: Address.CountryCode">
            <div class="mz-form-field-cell">
                <label data-bind="html: Address.stateprovLabel() + '<span class=\'mz-required-field\' data-bind=\'visible: Address.StateOrProvince.required\'> *</span>:'"></label>
            </div>
            <div class="mz-form-field-cell">
                <input type="text" style="position: absolute; left: -99999px" name="state" id="state" data-bind="value: Address.autofilledState" />
                <select data-bind="options: Address.stateprovList, optionsText: 'Value', optionsValue: 'Code', optionsCaption: 'Choose...', value: Address.StateOrProvince, css: { 'mz-invalid': Address.StateOrProvince.invalid() }">
                </select>
                <span class="mz-validation-message" data-bind="text: Address.StateOrProvince.validationMessage() || '&nbsp;'"></span>
            </div>
        </div>
        <div class="mz-form-field-row">
            <div class="mz-form-field-cell">
                <label for="postal-code">Zip/Postal Code<span class="mz-required-field"> *</span>:</label>
            </div>
            <div class="mz-form-field-cell">
                <input type="text" id="mz-shipping-address-postal-code" name="postal-code" data-bind="value: Address.PostalOrZipCode, css: { 'mz-invalid': Address.PostalOrZipCode.invalid() }">
                <span class="mz-validation-message" data-bind="text: Address.PostalOrZipCode.validationMessage() || '&nbsp;'"></span>
            </div>
        </div>
    </script>


</form>

{% endblock BodyContent %}
