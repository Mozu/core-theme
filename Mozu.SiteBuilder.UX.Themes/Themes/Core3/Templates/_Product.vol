{% extends "layouts\default" %}

{% block Init %}
	{% setTemplateVariables BodyTagClasses="mz-product" %}
	{{ block.super }}
{% endblock Init%}

{% block BodyContent %}

{% require_script "pages/product" %}

<div id="mz-product-detail" class="mz-product-detail-wrap" data-mz-product="{% json_attribute Model %}" style="visibility: hidden">

	<h1 class="mz-page-header" {% data_attributes Model.Content.ProductName %}>{{ Model.Content.ProductName }}
        <span class="mz-product-code mz-auxiliary-text" {% data_attributes Model.ProductCode %}>Product Code: {{ Model.ProductCode }}</span>
    </h1>
	
	{% include "Modules/ProductImages" %}

	<div class="mz-detail-info-wrap">

        {% include "Modules/MessageBar" %}

		<div class="mz-details-full-description" >
			{{ Model.Content.ProductFullDescription }}
		</div>
        
        <dl class="mz-details-properties">
            {% for property in Model.Properties %}
                <dt>{{property.AttributeDetail.Name}}</dt>
                {% for v in property.Values %}
                    <dd>{% if v.StringValue %}{{v.StringValue}}{% else %}{{v.Value}}{% endif %}</dd>
                {% endfor %}
            {% endfor %}
        </dl>

        {% include "Modules/ProductOptions" %}
			
	
	<div class="mz-price-stack-wrap">		
		<h3 class="mz-price-label">Our Price:</h3>
		<div class="mz-price">
			<!-- ko if: hasPriceRange() -->
                <!-- ko if: PriceRange.hasDiscountedRange() -->
                  <div data-bind="with: PriceRange" class="mz-price-amt mz-strikethrough mz-price-range">
                    <!-- ko currencyText: Lower().Price --><!-- /ko --> &ndash; <!-- ko currencyText: Upper().Price --><!-- /ko -->
                  </div>
                  <div data-bind="with: PriceRange" class="mz-price-amt mz-price-saleprice mz-price-range">
                    <!-- ko if: hasDiscountedLower -->
                    <span class="mz-price-amt" data-bind="currencyText: Lower().SalePrice"></span>
                    <!-- /ko -->
                    <!-- ko if: !hasDiscountedLower() -->
                        <!-- ko currencyText: PriceRange.Lower().Price --><!-- /ko -->
                    <!-- /ko -->
                    &ndash;
                    <!-- ko if: hasDiscountedUpper -->
                    <span class="mz-price-amt" data-bind="currencyText: Upper().SalePrice"></span>
                    <!-- /ko -->
                    <!-- ko if: !hasDiscountedUpper() -->
                    <!-- ko currencyText: PriceRange.Upper().Price --><!-- /ko -->
                    <!-- /ko -->
                  </div>
                      <!-- /ko -->
                    <!-- ko if: !PriceRange.hasDiscountedRange() -->
                        <div data-bind="with: PriceRange" class="mz-price-amt mz-price-range">
                          <!-- ko currencyText: Lower().Price --><!-- /ko --> &ndash; <!-- ko currencyText: Upper().Price --><!-- /ko -->
                        </div>
                    <!-- /ko -->
			<!-- /ko -->
			<!-- ko if: !hasPriceRange() -->
				<span class="mz-price-amt" data-bind="currencyText: Price.Price, css: { 'mz-strikethrough': Price.hasSalePrice }"></span>
				<span class="mz-price-amt mz-price-saleprice" data-bind="visible: Price.hasSalePrice, currencyText: Price.SalePrice"></span>
			<!-- /ko -->
		</div>
	</div>
	<div class="mz-not-purchasable-text" data-bind="ifnot: isPurchasable">
		Not Purchasable:
		<!-- ko foreach: PurchasableState().Messages -->
			<span data-bind="text: Message"></span>
		<!-- /ko -->
	</div>
	<section class="mz-conversion-wrap">
			<span class="mz-qty-label">Qty</span>
			<input class="mz-qty-input" type="number" min="1" value="1" data-bind="value: Quantity, css: { 'mz-invalid': Quantity.invalid() }, enable: isPurchasable" />
			<button class="mz-button mz-btn-cta mz-add-to-cart"
				data-bind="click: submit, enable: isPurchasable, css: { invisible: submitting }">
				Add To Cart
			</button>
			<span data-bind="visible: submitting">
				{% include "Modules/LoadingBar" %}
			</span>
            <span class="mz-validation-message" data-bind="text: Quantity.validationMessage() || '&nbsp;'"></span>
	</section>

			
			
	</div>
</div>

{% endblock BodyContent %}


