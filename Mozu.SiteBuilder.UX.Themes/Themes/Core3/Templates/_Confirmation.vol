{% extends "default" %}

{% block Init %}
	{% setTemplateVariables BodyTagClasses="checkout-confirmation" %}
	{% setTemplateVariables IsConfirmationPage="true" %}
{% endblock Init%}

{% block BodyContent %}

<div id="mz-order-confirmation" class="mz-order-confirmation">
	<h2>Order Confirmation</h2>

	<p class="mz-desc">Thank you for your order!  You will receive email confirmation&hellip;</p>

	<table id="mz-purchase-details" class="mz-purchase-details">
		<thead>
			<tr>
				<td class="mz-field-interstitial" colspan="2">Order#: <strong>{{ Model.Id }}</strong></td>
			</tr>
		</thead>
		{# TODO: Make template for Order by Check #}
		<tbody>
			<tr>
				<td class="mz-field-interstitial" colspan="2"><hr></td>
			</tr>
			{% if Model.Payment.PaymentType == "CreditCard" %}
			<tr>
				<td class="mz-field-label">Billing Name:</td>
				<td>{{ Model.Payment.Card.BillingAddress.FirstName }} {{ Model.Payment.Card.BillingAddress.LastNameOrSurname }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Billing Address:</td>
				<td>{{ Model.Payment.Card.BillingAddress.Address.Address1 }}</td>
			</tr>
				{% if Model.Payment.Card.BillingAddress.Address.Address2 %}
			<tr>
				<td></td>
				<td>{{ Model.Payment.Card.BillingAddress.Address.Address2 }}</td>
			</tr>
				{% endif %}
			<tr>
				<td></td>
				<td>{{ Model.Payment.Card.BillingAddress.Address.CityOrTown }}, {{ Model.Payment.Card.BillingAddress.Address.StateOrProvince }} {{ Model.Payment.Card.BillingAddress.Address.PostalOrZipCode }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Phone:</td>
				<td>{{ Model.Payment.Card.BillingAddress.PhoneNumbers.Home }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Email:</td>
				<td>{{ Model.Payment.Card.BillingAddress.Email }}</td>
			</tr>
			<tr>
				<td class="mz-field-interstitial" colspan="2"><hr></td>
			</tr>
			<tr>
				<td class="mz-field-label">Card Type:</td>
				<td>{{ Model.Payment.Card.PaymentOrCardType }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Credit Card #:</td>
				<td>{{ Model.Payment.Card.CardNumberPartOrMask }}</td>
			</tr>
			{% comment %} {# this isn't returned by the services #}
			<tr>
				<td class="mz-field-label">Expiration:</td>
				<td>{{ Model.Payment.Card.ExpireMonth }}.{{ Model.Payment.Card.ExpireYear }}</td>
			</tr>
			{% endcomment %}
			{% else %} {# "Pay by Check" #}
			<tr>
				<td class="mz-field-label">Payment Type:</td>
				<td>{{ Model.Payment.PaymentType }}</td>
			</tr>
			<tr>
				<td></td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td class="mz-field-label"><strong>Mail check to:</strong></td>
				<td>{{ ViewData.MailCheckTo.CompanyName }}</td>
			</tr>
			<tr>
				<td></td>
				<td>{{ ViewData.MailCheckTo.Address1 }}</td>
			</tr>
			<tr>
				<td></td>
				<td>{{ ViewData.MailCheckTo.CityOrTown }}, {{ ViewData.MailCheckTo.StateOrProvince }} {{ ViewData.MailCheckTo.PostalOrZipCode }} </td>
			</tr>
			{% endif %}
			<tr>
				<td></td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td class="mz-field-label">Ship to:</td>
				<td>{{ Model.Shipment.ShippingAddress.FirstName }} {{ Model.Shipment.ShippingAddress.LastNameOrSurname }}</td>
			</tr>
			<tr>
				<td></td>
				<td>{{ Model.Shipment.ShippingAddress.Address.Address1 }}</td>
			</tr>
			{% if Model.Shipment.ShippingAddress.Address.Address2  %}
			<tr>
				<td></td>
				<td>{{ Model.Shipment.ShippingAddress.Address.Address2 }}</td>
			</tr>
			{% endif %}
			<tr>
				<td></td>
				<td>{{ Model.Shipment.ShippingAddress.Address.CityOrTown }}, {{ Model.Shipment.ShippingAddress.Address.StateOrProvince }} {{ Model.Shipment.ShippingAddress.Address.PostalOrZipCode }}</td>
			</tr>
			<tr>
				<td></td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td class="mz-field-label">Shipping Method:</td>
				<td><strong>{{ Model.Shipment.ShippingMethodName }}</strong></td>
			</tr>
		</tbody>
	</table><!-- #purchase-details-->

	<h3>Order Summary</h3>
	<table id="mz-order-summary" class="mz-order-summary">
	    <thead>
	        <tr>
	            <th>Description</th>
	            <th>Qty</th>
	            <th>Unit Price</th>
	            <th>Total Price</th>
	        </tr>
	    </thead>
	    <tbody>
            {% for item in Model.Items %}
	        <tr class="mz-item-row">
	            <td>{{ item.Product.Name }}</td>
	            <td>{{ item.Quantity }}</td>
	            <td>{{ item.Product.Price.Price|currency }}</td>
	            <td>{{ item.Total|currency }}</td>
	        </tr>
            {% endfor %}
	    </tbody>
	    <tfoot>
	        <tr>
	            <td colspan="3">
	                Comments:<br>
                    {% for note in Model.Notes %}
                        <p>{{ note.Text }}</p>
                    {% endfor %}
                </td>
	            <td colspan="2">
	                <table>
	                    <tr>
	                        <td>Subtotal:</td>
	                        <td>{{ Model.Subtotal|currency }}</td>
	                    </tr>
	                    <tr>
	                        <td>Coupon/Discount:</td>
	                        <td>{{ Model.DiscountTotal|currency }}</td>
	                    </tr>
	                    <tr>
	                        <td>Tax:</td>
	                        <td>{{ Model.TaxTotal|currency }}</td>
	                    </tr>
	                    <tr>
	                        <td>Shipping & Handling:</td>
	                        <td>{{ Model.ShippingTotal|currency }}</td>
	                    </tr>
	                    <tr>
	                        <td>Total:</td>
	                        <td>{{ Model.Total|currency }}</td>
	                    </tr>
	                </table>
	            </td>
	        </tr>
	    </tfoot>
	</table>
</div><!-- #order-confirmation -->

{% endblock BodyContent %}

{% block TrailingScripts %}
	{{ block.super }}
	{% if SiteContext.GoogleAnalyticsEnabled and SiteContext.GoogleAnalyticsEcommerceEnabled %}
	<script>
	_gaq.push(['_addTrans',
		'{{ Model.OrderNumber }}',						
		'{{ siteContext.settings.general.websiteName }}',
		'{{ Model.Total }}',							
		'{{ Model.TaxTotal }}',					
		'{{ Model.ShippingTotal }}',		
		'{{ Model.Shipment.ShippingAddress.Address.CityOrTown }}',
		'{{ Model.Shipment.ShippingAddress.Address.StateOrProvince }}',			
		'USA'
	]);

	{% for item in Model.items %}
	_gaq.push(['_addItem',
		'{{ Model.OrderNumber }}',	
		'{{ item.Product.ProductCode }}',
		'{{ item.Product.Name }}',
		'',
		'{{ item.Price.Price }}',
		'{{ item.Quantity }}'

	]);
	{% endfor %}

	_gaq.push(['_trackTrans']);
	</script>
	{% endif %}

{% endblock TrailingScripts %}

		
		
		