{% extends "default" %}
{% setTemplateVariables BodyTagClasses="category" %}

{% block BodyContent %}

<div id="mz-layout-container" class="mz-layout-container mz-content-inner-wrap mz-blog-list-page>
    {% html_action "ProductListing" "catalog" with categoryId=Model.Id and viewName="Modules/ProductListing" as_parameter %}
</div>

{% endblock BodyContent %}s