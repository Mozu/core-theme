{% extends "default" %}

{% block Init %}
    {% setTemplateVariables BodyTagClasses="mz-category" %}
    {{ block.super }}
{% endblock Init %}

{% block BodyContent %}

{% require_script "pages/category" %}

<div id="mz-category-loading" class="mz-category-loading">
    <p>
        <em>Please wait...</em>
    </p>
    {% include "Modules/LoadingBar" %}
</div>

<div id="mz-layout-container" data-mz-category="{{Model.CategoryId}}" class="mz-layout-container mz-content-inner-wrap mz-blog-list-page">
<h1 class="mz-page-header">{{ Model.Name }}</h1>
    {% html_action "ProductListing" "catalog" with categoryId=Model.Id and includeFacets=true and useUrlParams=true and viewName="Modules/ProductListingFaceted" as_parameter %}
</div>

{% endblock BodyContent %}