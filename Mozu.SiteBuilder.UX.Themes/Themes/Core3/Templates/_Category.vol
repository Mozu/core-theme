{% extends "default" %}
{% setTemplateVariables BodyTagClasses="category" %}

{% block BodyContent %}

<div id="mz-category-loading" class="mz-category-loading">
    <p>
        <em>Please wait...</em>
    </p>
    {% include "Modules/LoadingBar" %}
</div>

<div id="mz-layout-container" data-mz-category="{{Model.CategoryId}}" class="mz-layout-container mz-content-inner-wrap mz-blog-list-page">
    {% html_action "ProductListing" "catalog" with categoryId=Model.Id and includeFacets=true and viewName="Modules/ProductListingFaceted" as_parameter %}
</div>

{% endblock BodyContent %}