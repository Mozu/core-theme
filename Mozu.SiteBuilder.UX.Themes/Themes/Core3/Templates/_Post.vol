{% extends "default" %}

{% block Init %}
	{% setTemplateVariables BodyTagClasses="mz-blog-single-post" %}
	{{ block.super }}
{%endblock Init %}

{% block BodyContent %}
<div class="mz-content-inner-wrap mz-blog-post">
	<h1 class="mz-blog-post-title"	{% data_attributes Model.title %}>{{ Model.Title }}</h1>

	<div id="blog-single-post">
		<div class="mz-blog-post-info">
			Posted by <span class="mz-blog-post-author" >{{Model.author}}</span>
			on <span class="blog-post-date" >{{Model.InsertDate|date:"l, F j, Y"}}</span>
		</div>

		<div class="mz-blog-post-body" {% data_attributes Model.body %} >{{Model.body}}</div>
		<nav class="mz-blog-post-links">
				<ul class="mz-blog-social-links">
					<li class="mz-bsl-li">
						<a class="mz-bsl-a" href="#">
							<i class="mz-icon mz-i-facebook-sm"></i>Like
						</a>
					</li>
					<li class="mz-bsl-li">
						<a class="mz-bsl-a" href="#">
							<i class="mz-icon mz-i-twitter-sm"></i>Tweet
						</a>
					</li>
				</ul>
			</nav>
		<div class="mz-blog-post-tags" >
			<h4 class="mz-blog-tag-title">Tags</h4>
			<div class="mz-blog-post-tags-list" {% data_attributes Model.tags %} >
				{% for tag in Model.tags %}
				<a class="mz-blog-tag-a" href="/blogs/tagged/{{tag}}">{{tag}}</a>{% if not forloop.last %}, {% endif %}
				{% empty %}
				{% if SiteContext.IsEditMode %}
				Click here to add tags, homie!
				{% endif %}
				{% endfor %}
			</div>
		</div>
	</div>
</div>
{% endblock BodyContent %}

