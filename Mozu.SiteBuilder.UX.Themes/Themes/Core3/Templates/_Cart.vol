{% extends "default" %}
{% setTemplateVariables BodyTagClasses="cart" %}

{% block Init %}
{% require_script "pages/cart" %}
{% endblock Init%}

{% block BodyContent %}

<div id="mz-layout-container" class="mz-layout-container mz-cart-page mz-content-inner-wrap">
	<h1 class="mz-page-header">Your Cart</h1>
	<form method="post" action="/cart/checkout" id="mz-cart-form" data-cart="{% json_attribute Model %}" data-bind="visible: true" style="display: none">
        {% include "Modules/MessageBar" %}
        {% include "Modules/CartTable" %}
	</form>
</div>

{% endblock BodyContent %}