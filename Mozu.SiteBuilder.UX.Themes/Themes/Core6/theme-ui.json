{
    "items": [
        {
            "xtype": "panel",
            "title": "Features",
            "collapsed": false,
            "items": [
                {
                    "xtype": "mz-input-checkbox",
                    "name": "showAddressTypeDropdown",
                    "fieldLabel": "Show Address Type dropdown in Address Forms (Residential/Commercial)"
                },
                {
                    "xtype": "mz-input-checkbox",
                    "name": "autocompleteProducts",
                    "fieldLabel": "Show product details in search suggestions"
                },
                {
                    "xtype": "mz-input-checkbox",
                    "name": "enablePartialCaching",
                    "fieldLabel": "Enable partial caching using the Hypr {% partial_cache %} tag"
                }
            ]
        },
        {
            "xtype": "panel",
            "title": "Layout",
            "collapsed": false,
            "items": [
                {
                    "xtype": "mz-input-dropdown",
                    "name": "gutterWidth",
                    "fieldLabel": "Base Margin Width",
                    "allowBlank": false,
                    "editable": false,
                    "forceSelection": true,
                    "store": [
                        "15px",
                        "20px",
                        "25px",
                        "30px",
                        "35px"
                    ],
                    "queryMode": "local"
                }
            ]
        },
        {
            "xtype": "panel",
            "title": "Text",
            "collapsed": false,
            "items": [
                {
                    "xtype": "mz-input-selectmulti",
                    "name": "fonts",
                    "fieldLabel": "Use Google Web Fonts",
                    "store": [
                        [ "Source Sans Pro:regular,italic,bold,bolditalic", "Source Sans Pro" ],
                        [ "Open Sans:regular,italic,bold,bolditalic", "Open Sans" ],
                        [ "Raleway:regular,italic,bold,bolditalic", "Raleway" ],
                        [ "Lora:regular,italic,bold,bolditalic", "Lora" ],
                        [ "Rokkitt:regular,italic,bold,bolditalic", "Rokkitt" ]
                    ]
                },
                {
                    "xtype": "mz-input-dropdown",
                    "name": "fallbackFontFamily",
                    "fieldLabel": "Fallback Font Family (if Googld fonts don't load)",
                    "allowBlank": false,
                    "editable": false,
                    "forceSelection": true,
                    "store": [
                        "sans-serif",
                        "serif"
                    ],
                    "queryMode": "local"
                },
                {
                    "xtype": "mz-input-dropdown",
                    "name": "fontSize",
                    "fieldLabel": "Font Size",
                    "allowBlank": false,
                    "editable": false,
                    "forceSelection": true,
                    "store": [
                        "12px",
                        "14px",
                        "16px",
                        "18px",
                        "20px"
                    ],
                    "queryMode": "local"
                },
                {
                    "xtype": "mz-input-color",
                    "name": "textColor",
                    "fieldLabel": "Text Color"
                }
            ]
        },
        {
            "xtype": "panel",
            "title": "Paging",
            "collapsed": false,
            "items": [
                {
                    "fieldLabel": "Default Items Per Page",
                    "xtype": "mz-input-dropdown",
                    "name": "defaultPageSize",
                    "allowBlank": false,
                    "editable": false,
                    "forceSelection": true,
                    "store": [
                        15,
                        25,
                        50
                    ],
                    "queryMode": "local"
                }
            ]
        },
        {
            "xtype": "panel",
            "title": "Navigation",
            "collapsed": false,
            "items": [
                {
                    "fieldLabel": "Maximum Items In Main Nav",
                    "xtype": "mz-input-number",
                    "name": "maxTopLevelNavItems",
                    "hideTrigger": false,
                    "allowDecimal": false,
                    "minValue": 1
                },
                {
                    "fieldLabel": "Maximum Nav Item Label Length",
                    "xtype": "mz-input-number",
                    "name": "maxTopLevelNavLabelLength",
                    "hideTrigger": false,
                    "allowDecimal": false,
                    "minValue": 1
                }
            ]
        }
    ]
}