<pre style="background: white; z-index: 10000; position: fixed; top: 0; left: 0; padding: 2em; border: 1px solid red;">
    <code>
        {% with pageContext.query.pinky|default(4) as pinky %}
        {% with pageContext.query.bumpus|default(5) as bumpus %}
        Pinky is {{ pinky }}.
        Bumpus is {{ bumpus }}.
        Pinky/Bumpus is {{ pinky|divide(bumpus) }}.
        Pinky+Bumpus is {{ pinky|add(bumpus) }}.
        Bumpus+Pinky is {{ bumpus|add(pinky) }}
        Bumpus + Pinky/Bumpus is {% with pinky|divide(bumpus) as pinkyoverbumpus %}{{ bumpus|add(pinkyoverbumpus) }}{% endwith %}
        (Bumpus + Pinky)/Bumpus is {{ bumpus|add(pinky)|divide(bumpus) }}
        Is that more than 6? {% if bumpus|add(pinky)|divide(bumpus) > 6 %}Yes{%else%}No{%endif%}
        {% endwith %}
        {% endwith %}
    </code>
</pre>