<tr>
  <td>
    <!-- This is unimplemented for alpha. -->
    {% if not Model.HasDiscount %}
    <div id="mz-cart-coupon-form" class="mz-coupon-wrap" style="display:none">
      Coupon code: <input {% if Model.Items.Count == 0 %} disabled="disabled" {% endif %} style="width: 100px;" id="mz-cart-coupon-code" type="text" />&nbsp;
      <input id="mz-cart-apply-coupon-button" {% if Model.Items.Count == 0 %} disabled="disabled" {% endif %} type="button" value="Apply" />
    </div>
    {% endif %}
  </td>
</tr>
<tr>
  <td align="right">
    <em class="mz-auxiliary-text">Tax &amp; Shipping Calculated at Checkout</em>
  </td>
</tr>
<tr class="mz-cart-total-row">
  <td>
    <span class="mz-cart-total-label">Order Total:</span>
    <span class="mz-cart-total-wrap">
      <strong>
        <span id="mz-cart-total" class="mz-cart-total" data-bind="currencyText: Total"></span>
      </strong>
    </span>
  </td>
</tr>
<tr>
  <td align="right">
    <button id="checkout" class="mz-button mz-btn-checkout mz-btn-cta" {% if Model.Items.Count == 0 %} disabled="disabled" {% endif %} type="submit" data-bind="click: proceedToCheckout, enable: canCheckout, visible: !submitting()">Proceed to Checkout</button>
  </td>
</tr>