<div data-mz-role="productimages-container" class="mz-product-images-container mz-mobile-optimized">
    {% if Model.Content.ProductImages.Count and Model.Content.ProductImages.Count > 0 %}
    <div data-mz-role="productimages-main">
        <ul>
            {% for image in Model.Content.ProductImages %}
            <li class="mz-product-image-{% if forloop.first %}main{% else %}-additional{% endif %}">
                <img class="mz-product-image-{% if forloop.first %}main{% else %}-additional{% endif %}-link mz-product-image" src="{{ image.src }}" />
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
    <div class="mz-product-images-sliderpos" data-mz-role="productimages-bullets">
        {% for image in Model.Content.ProductImages %}
        <em id="mz-product-images-sliderbullet">&bull;</em>
        {% endfor %}
    </div>
</div>