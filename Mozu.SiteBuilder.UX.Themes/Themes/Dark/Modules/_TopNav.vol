<nav class="mz-site-nav-wrapper">
    <ul class="mz-site-nav">
        {%for link in SiteContext.Navigation.Primary %}
            <li class="mz-site-nav-item">
                <a class="mz-site-nav-link" href="{{link.url}}">{{link.name}}</a>
                {% if link.items %}
                    <div class="mz-site-nav-slideout l2 zeroHeight">
                        <ul class="mz-site-nav-sub">
                            {% for sublink in link.items %}
                                <li class="mz-site-nav-item">
                                    <a class="mz-site-nav-link" href="{{sublink.url}}">{{sublink.name}}</a>
                                    {% if sublink.items %}
                                        <div class="mz-site-nav-slideout l3">
                                            <ul class="mz-site-nav-sub">
                                                {% for subsublink in sublink.items %}
                                                    <li class="mz-site-nav-item">
                                                        <a class="mz-site-nav-link" href="{{subsublink.url}}">{{subsublink.name}}</a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </li>
        {%endfor%}
    </ul>
</nav>
    