{% if Model|length < 1 %}
	<div class="empty-text">Nothing has been tagged yet.</div>
  {% endif %}
  <ul class="recent-posts-list" align="{{ViewData.config.alignment|default:"left"}}">
    {% for tag in Model %}
    <li style="list-style: none;">
      <a href="/blogs/tagged/{{tag.name}}">{{tag.name}}</a>
    </li>
    {% endfor %}
  </ul>
