 <div class="mj-search-wrap">
    <nav class="mz-utility-nav-wrap ">
 	<ul class="mz-utility-nav">
 		{%if user.email %}
 		<li class="mz-utility-nav-item">
 			<div id="logged-in">
 				Welcome, <a href="/myaccount" class="mz-utility-link">{{user.firstName|default:user.email}}</a>! (<a href="javascript:;"  class="mz-utility-link logout">Log Out</a>)
 			</div>
 		</li>
 		{%else%}
 		<li class="mz-utility-nav-item mini-modal-parent">
 			<a href="javascript:;" id="sign-in" class="login-link mz-utility-link">Sign In</a>
            <div class="mini-modal login-modal" style="top: 45px;">
            <span class="css-arrow-up"></span>
            <div class="hbox-sliding-window">
                <section class="ajaxform login show-on-load">
                    <input name="email" placeholder="Email Address" type="email" />
                    <input name="password" placeholder="Password" type="password" />
                    <div class="last-row">
                        (<a href="javascript:;">forgot username or password?</a>) <input type="submit" value="Log In" />
                    </div>
                </section>
                <section class="ajaxform forgot-password">
                    <label class="large-text">
                        Reset Password
                        <input type="email" name="reset-password" placeholder="Email Address" />
                    </label>
                    <div class="last-row">
                      (<a href="javascript:;">Cancel</a>) <input type="submit" value="Send Email" />
                    </div>
                </section>
                <section class="ajaxresponse"></section>
            </div>
        </div>
         </li>
         {%endif%}
         <li class="mz-utility-nav-item">
         	<a class="mz-utility-link" href="/cart">
         		<!-- <i class="icon-shopping-cart"></i> -->
         		View Cart (<span class="mz-cart-item-indicator" id="my-cart-count">{{siteContext.catalog.cartAbstract.itemCount|default:0}}</span>)
         	</a>
         </li>
     </ul>
 </nav>
</div>
