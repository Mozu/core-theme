{% if Model|length < 1 %}
	<div class="empty-text">Get busy. You haven't posted anything yet.</div>
  {% endif %}
  <ul class="recent-posts-list" align="{{ViewData.config.alignment|default:"left"}}">
    {% for post in Model %}
    <li style="list-style: none;">
      <a href="{{post.url}}">{{post.title}}</a>
    </li>
    {% endfor %}
  </ul>
