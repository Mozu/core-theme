{% extends "default" %}
{% setTemplateVariables BodyTagClasses="checkout" %}

{% block Init %}
    {% require_script "pages/checkout.js" %}
{% endblock Init%}

{% block BodyContent %}

<div id="checkout-loading" class="mz-loading-bar">
	<p><em>Please wait...</em></p>
	<span class="l-1"></span>
	<span class="l-2"></span>
	<span class="l-3"></span>
	<span class="l-4"></span>
	<span class="l-5"></span>
	<span class="l-6"></span>
</div>
<form id="checkout-form" style="visibility: hidden" method="post" action="" onsubmit="return false;" data-bind="css: { submitting: submitting }">
	<h2 class="mz-page-header">
		Checkout{% if not user.email %}
		<span class="mz-page-headernote mz-auxiliary-text mini-modal-parent">Registered Customer? <a class="mz-utility-link login-link" href="javascript:;">Sign in</a>
		<div class="mini-modal login-modal" style="top: 45px;">
            <span class="css-arrow-up"></span>
            <div class="hbox-sliding-window">
                <section class="login ajaxform show-on-load">
                    <input name="email" placeholder="Email Address" type="email" />
                    <input name="password" placeholder="Password" type="password" />
                    <div class="last-row">
                        (<a href="javascript:;">forgot username or password?</a>) <input type="submit" value="Log In" />
                    </div>
                </section>
                <section class="forgot-password ajaxform">
                    <label class="large-text">
                        Reset Password
                        <input type="email" name="reset-password" placeholder="Email Address" />
                    </label>
                    <div class="last-row">
                      (<a href="javascript:;">Cancel</a>) <input type="submit" value="Send Email" />
                    </div>
                </section>
                <section class="ajaxresponse"></section>
            </div>
		</div>
		</span>
		{% endif %}
	</h2>

	<div class="mz-messages">
		<ul data-bind="visible: messages().length > 0, foreach: messages" class="mz-errors">
			<li data-bind="text: message"></li>
		</ul>
	</div>

	<div class="mz-column">
		<div class="mz-panel" id="shippingAddress" data-bind="with: shippingAddress, cssClassFrom: shippingAddress.stepStatus(), cssClassFromPrefix: 'stepstatus-'">
			<h3 class="mz-panel-header">
				Shipping Information
				<button class="mz-edit-button" data-bind="click: edit">Edit</button>
			</h3>
			<div class="mz-panel-wrap">
			<div class="mz-inner-panel" data-bind="changeHeightOn: stepStatus">
                <p class="mz-desc">Where to?</p>
                <div class="completed-summary">
                    <span data-bind="text: firstName() + ' ' + lastName()"></span>
                    <span data-bind="text: address1"></span>
                    <span data-bind="text: address2, visible: address2"></span>
                    <span data-bind="text: address3, visible: address3"></span>
                    <span data-bind="text: cityOrTown() + ', ' + stateOrProvince() + ' ' + postalOrZipCode()"></span>
                    <span data-bind="text: countryCode"></span>
                </div>
                <table class="mz-form-fields">
                    <tr>
                        <td>
                            <label for="firstname">First Name<span class="required-field" data-bind="visible: firstName.required"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" id="firstname" name="firstname" data-bind="value: firstName, css: { 'mz-invalid': firstName.invalid() }">
                            <span class="mz-validation-message" data-bind="text: firstName.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="lastname">Last Name<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" id="lastname" name="lastname" data-bind="value: lastName, css: { 'mz-invalid': lastName.invalid() }">
                            <span class="mz-validation-message" data-bind="text: lastName.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="address-line-1">Address<span class="required-field" data-bind="visible: firstName.required"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" id="address-line-1" name="address-line-1" data-bind="value: address1, css: { 'mz-invalid': address1.invalid() }">
                            <span class="mz-validation-message" data-bind="text: address1.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>
                            <input type="text" id="address-line-2" name="address-line-2" data-bind="value: address2">
                            <span class="mz-validation-message">&nbsp;</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="city">City<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" id="city" name="city" data-bind="value: cityOrTown, css: { 'mz-invalid': cityOrTown.invalid() }">
                            <span class="mz-validation-message" data-bind="text: cityOrTown.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="country">Country<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <select id="country" data-bind="value: countryCode, css: { 'mz-invalid': countryCode.invalid() }">
                                {% for country in Model.model.shippingAddress.availableCountries %}
                                <option value="{{ country.code }}">{{ country.name }}</option>
                                {% endfor %}
                            </select>
                            <span class="mz-validation-message" data-bind="text: countryCode.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr data-bind="visible: countryCode">
                        <td>
                            <label for="secondary-country" data-bind="html: stateprovLabel() + '<span class=\'required-field\' data-bind=\'visible: firstName.required\'> *</span>:'"></label>
                        </td>
                        <td>
                            <select data-bind="options: stateprovList, optionsText: 'label', optionsValue: 'code', optionsCaption: 'Choose...', value: stateOrProvince, css: { 'mz-invalid': stateOrProvince.invalid() }">
                            </select>
                            <span class="mz-validation-message" data-bind="text: stateOrProvince.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="postal-code">Zip/Postal Code<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" id="postal-code" name="postal-code" data-bind="value: postalOrZipCode, css: { 'mz-invalid': postalOrZipCode.invalid() }">
                            <span class="mz-validation-message" data-bind="text: postalOrZipCode.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                </table>

                <div class="mz-next-step">
					<div class="mz-loading-bar">
						<span class="l-1"></span>
						<span class="l-2"></span>
						<span class="l-3"></span>
						<span class="l-4"></span>
						<span class="l-5"></span>
						<span class="l-6"></span>
					</div>
                    <button class="mz-submit-button" data-bind="click: nextStep, text: $root.shippingMethod.stepStatus() == 'new' ? 'Next' : 'Update'"></button>
                </div>
            </div><!-- .mz-inner-panel -->
			</div>
		</div><!-- Step 1 .panel -->


		<div class="mz-panel" id="shippingMethodSection" data-bind="with: shippingMethod, cssClassFrom: shippingMethod.stepStatus(), cssClassFromPrefix: 'stepstatus-'">
			<h3 class="mz-panel-header">
				Shipping Method
				<button class="mz-edit-button" data-bind="click: edit">Edit</button>
			</h3>
			<div class="mz-panel-wrap">
			<div class="mz-inner-panel" data-bind="changeHeightOn: stepStatus() + availableShippingMethods()">
                <p class="mz-desc">How to send it?</p>
                <div class="completed-summary inline">
                    <strong data-bind="text: name"></strong> (<span data-bind="currencyText: price"></span>)
                </div>
                <div class="mz-form-fields">
                    <!-- ko foreach: availableShippingMethods -->
                    <label class="inline">
                        <input type="radio" name="shippingMethod" data-bind="value: id, checked: $parent.id">
                        <span data-bind="text: name"></span> <span class="shipping-price"><span data-bind="currencyText: price"></span></span>
                    </label>
                    <!-- /ko -->

                    <div class="mz-next-step">
						<div class="mz-loading-bar">
							<span class="l-1"></span>
							<span class="l-2"></span>
							<span class="l-3"></span>
							<span class="l-4"></span>
							<span class="l-5"></span>
							<span class="l-6"></span>
						</div>
                        <button class="mz-submit-button" data-bind="click: nextStep, text: $root.paymentSection.stepStatus() == 'new' ? 'Next' : 'Update'">Next</button>
                    </div>
                </div>
            </div><!-- .mz-inner-panel -->
			</div>
        </div><!-- Step 2 .panel -->

        <div class="mz-panel" id="payment-information" data-bind="with: paymentSection, cssClassFrom: paymentSection.stepStatus(), cssClassFromPrefix: 'stepstatus-'">
            <h3 class="mz-panel-header">
                Payment Information
                <button class="mz-edit-button" data-bind="click: edit">Edit</button>
            </h3>
			<div class="mz-panel-wrap">
            <div class="mz-inner-panel" data-bind="changeHeightOn: stepStatus() + isSameBillingShippingAddress() + paymentType()">
                <div class="completed-summary">
                    <h4>Payment Type</h4>
                    <span data-bind="text: paymentType"></span>
					<span data-bind="visible: paymentTypeIsCreditCard, text: cardNumberPartOrMask"></span>
					<span data-bind="visible: paymentTypeIsCheck, text: checkNumber"></span>

					<!-- ko if: billingAddressRequired -->
						<h4>Billing Address</h4>
						<!-- ko if: isSameBillingShippingAddress -->
							<span data-bind="text: $root.shippingAddress.firstName() + ' ' + $root.shippingAddress.lastName()"></span>
							<span data-bind="text: $root.shippingAddress.address1()"></span>
							<span data-bind="text: $root.shippingAddress.address2(), visible: $root.shippingAddress.address2"></span>
							<span data-bind="text: $root.shippingAddress.address3(), visible: $root.shippingAddress.address3"></span>
							<span data-bind="text: $root.shippingAddress.cityOrTown() + ', ' + $root.shippingAddress.stateOrProvince() + ' ' + $root.shippingAddress.postalOrZipCode()"></span>
							<span data-bind="text: $root.shippingAddress.countryCode()"></span>
						<!-- /ko -->
						<!-- ko if: !isSameBillingShippingAddress() -->
							<span data-bind="text: firstName() + ' ' + lastName()"></span>
							<span data-bind="text: address1"></span>
							<span data-bind="text: address2, visible: address2()"></span>
							<span data-bind="text: address3, visible: address3()"></span>
							<span data-bind="text: cityOrTown() + ', ' + stateOrProvince() + ' ' + postalOrZipCode()"></span>
							<span data-bind="text: countryCode"></span>
						<!-- /ko -->
					<!-- /ko -->
                    <h4>Billing Contact Information</h4>
                    <span>Phone: <strong data-bind="text: phoneNumbers"></strong></span>
                    <span>Email: <strong data-bind="text: email"></strong></span>
                </div>

                <div class="mz-form-fields">
                <p class="mz-desc">
                    <select data-bind="value: paymentType">
                        <option>Select payment method</option>
                        <option value="CreditCard">Credit Card</option>
                        <option value="Check">Check by Mail</option>
                    </select>
                    <span class="mz-validation-message" data-bind="text: paymentType.validationMessage() || '&nbsp;'"></span>
                </p>

				<!-- ko if: paymentTypeIsCreditCard -->
                <table>
                    <tr>
                        <td>
                            <label for="credit-card-type">Card Type<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <select id="credit-card-type" data-bind="value: cardType, css: { invalid: cardType.invalid() }">
								<option></option>
								{% for card in SiteContext.Settings.Checkout.PaymentSettings.SupportedCards %}
                                <option value="{{card.Key}}">{{card.Value}}</option>
                                {% endfor %}
                            </select>
                            <span class="mz-validation-message" data-bind="text: cardType.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="credit-card-number">Card Number<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="credit-card-number" id="credit-card-number" data-bind="value: cardNumberPartOrMask, css: { invalid: cardNumberPartOrMask.invalid() }">
                            <span class="mz-validation-message" data-bind="text: cardNumberPartOrMask.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
					<tr>
                        <td>
                            <label for="credit-card-name">Name on Card<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="credit-card-name" id="credit-card-name" data-bind="value: nameOnCard, css: { invalid: nameOnCard.invalid() }">
                            <span class="mz-validation-message" data-bind="text: nameOnCard.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="expiration-month">Expires<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <select class="half-size" id="expiration-month" name="expiration-month" data-bind="value: cardExpireMonth, css: { invalid: cardExpireMonth.invalid() }">
								<option></option>
                                <option value="01">January</option>
                                <option value="02">February</option>
                                <option value="03">March</option>
                                <option value="04">April</option>
                                <option value="05">May</option>
                                <option value="06">June</option>
                                <option value="07">July</option>
                                <option value="08">August</option>
                                <option value="09">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                            <select class="half-size" name="expiration-year" data-bind="value: cardExpireYear, css: { invalid: cardExpireYear.invalid() }">
								<option></option>
                                <option value="2012">2012</option>
                                <option value="2013">2013</option>
                                <option value="2014">2014</option>
                                <option value="2015">2015</option>
                                <option value="2016">2016</option>
                                <option value="2017">2017</option>
                                <option value="2018">2018</option>
                                <option value="2019">2019</option>
                                <option value="2020">2020</option>
                                <option value="2021">2021</option>
                                <option value="2022">2022</option>
                            </select>
                            <span class="mz-validation-message" data-bind="visible: cardExpireYear.invalid(), text: cardExpireYear.validationMessage()">&nbsp;</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="security-code">Security Code<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="security-code" id="security-code" class="half-size" data-bind="value: cvv, css: { invalid: cvv.invalid() }">
                            <span class="mz-validation-message" data-bind="text: cvv.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>
                            <label class="inline"><input type="checkbox" name="save-card-info" data-bind="checked: isCardInfoSaved"> Save credit card information</label>
                        </td>
                    </tr>
                </table><!-- credit card fields-->

                <h4>Billing Address</h4>
                <div class="mz-single-setting"><label class="inline"><input type="checkbox" data-bind="checked: isSameBillingShippingAddress"> Use my shipping address</label></div>
                <div class="completed-summary" id="same-as-shipping-summary" data-bind="with: $root.shippingAddress, visible: isSameBillingShippingAddress">
                    <span data-bind="text: firstName() + ' ' + lastName()"></span>
                    <span data-bind="text: address1"></span>
                    <span data-bind="text: address2, visible: address2"></span>
                    <span data-bind="text: address3, visible: address3"></span>
                    <span data-bind="text: cityOrTown() + ', ' + stateOrProvince() + ' ' + postalOrZipCode()"></span>
                    <span data-bind="text: countryCode"></span>
                </div>
                <!-- ko if: !isSameBillingShippingAddress() -->
                <table>
                    <tr>
                        <td>
                            <label for="billing-firstname">First Name<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="billing-firstname" id="billing-firstname" data-bind="value: firstName, css: { invalid: firstName.invalid() }">
                            <span class="mz-validation-message" data-bind="text: firstName.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-middle-initial">Middle Initial:</label>
                        </td>
                        <td>
                            <input type="text" name="billing-middle-initial" id="billing-middle-initial" data-bind="value: middleName">
                            <span class="mz-validation-message">&nbsp;</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-lastname">Last Name<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="billing-lastname" id="billing-lastname" data-bind="value: lastName, css: { invalid: lastName.invalid() }">
                            <span class="mz-validation-message" data-bind="text: lastName.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-address">Address<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="billing-address-1" id="billing-address"  data-bind="value: address1, css: { invalid: address1.invalid() }">
                            <span class="mz-validation-message" data-bind="text: address1.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>
                            <input type="text" name="billing-address-2" data-bind="value: address2">
                            <span class="mz-validation-message">&nbsp;</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-city">City<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="billing-city" id="billing-city" data-bind="value: cityOrTown, css: { invalid: cityOrTown.invalid() }">
                            <span class="mz-validation-message" data-bind="text: cityOrTown.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-country">Country<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <select id="billing-country" data-bind="value: countryCode, css: { invalid: countryCode.invalid() }">
                                <option value="US">United States</option>
                                <option value="UK">United Kingdom</option>
                                <option value="NO">Norway</option>
                                <option value="MXP">Mexipan</option>
                                <option value="AU">Australia</option>
                            </select>
                            <span class="mz-validation-message" data-bind="text: countryCode.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-state">State<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <select data-bind="value: stateOrProvince, css: { invalid: stateOrProvince.invalid() }">
                                <option value="TX">Texas</option>
                                <option value="NB">Nebraska</option>
                                <option value="WA">Washington</option>
                                <option value="OR">Oregon</option>
                                <option value="SC">South Carolina</option>
                            </select>
                            <span class="mz-validation-message" data-bind="text: stateOrProvince.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-postal-code">Zip/Postal Code<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="billing-postal-code" id="billing-postal-code" class="half-size" data-bind="value: postalOrZipCode, css: { invalid: postalOrZipCode.invalid() }">
                            <span class="mz-validation-message" data-bind="text: postalOrZipCode.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                </table>
                <!-- /ko -->
				<!-- /ko -->

				<table data-bind="visible: paymentTypeIsCheck">
                    <tr>
                        <td>
                            <label for="nameOnCheck">Name on check<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="nameOnCheck" id="nameOnCheck" data-bind="value: nameOnCheck, css: { invalid: nameOnCheck.invalid() }">
                            <span class="mz-validation-message" data-bind="text: nameOnCheck.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="checkNumber">Check Number<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" name="checkNumber" id="checkNumber" data-bind="value: checkNumber, css: { invalid: checkNumber.invalid() }">
                            <span class="mz-validation-message" data-bind="text: checkNumber.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                </table><!-- pay by check fields -->
				<p><a href="#">Read more</a> about paying by check</p>

                <h4>Billing Contact Info</h4>
                <table>
                    <tr>
                        <td>
                            <label for="billing-phone">Phone:</label>
                        </td>
                        <td>
                            <input type="text" id="billing-phone" name="billing-phone" data-bind="value: phoneNumbers">
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="billing-email">Email<span class="required-field"> *</span>:</label>
                        </td>
                        <td>
                            <input type="text" id="billing-email" name="billing-email" data-bind="value: email, css: { invalid: email.invalid() }">
                            <span class="mz-validation-message" data-bind="text: email.validationMessage() || '&nbsp;'"></span>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>
                            <label class="inline"><input type="checkbox" name="special-offers" checked style="float: left; margin-right: 8px;"> Yes! I want to be receive news<br>and special offers from you!</label>
                        </td>
                    </tr>
                </table>
				</div>
                <div class="mz-next-step">
					<div class="mz-loading-bar">
						<span class="l-1"></span>
						<span class="l-2"></span>
						<span class="l-3"></span>
						<span class="l-4"></span>
						<span class="l-5"></span>
						<span class="l-6"></span>
					</div>
                    <button class="mz-submit-button" data-bind="click: nextStep">Next</button>
                </div>
            </div><!-- .mz-inner-panel -->
			</div>
		</div><!-- Step 3 .panel -->


		<div class="mz-panel" id="reviewpanel" data-bind="css: { 'stepstatus-submitting': submitting }">
			<h3 class="mz-panel-header">
				Review & Place Order
			</h3>
			<div class="mz-panel-wrap">
            <div class="mz-inner-panel" data-bind="changeHeightOn: createAccount(), visible: orderStatus">
                <p class="mz-desc">Please review all of the information on this page and, if necessary, make changes before placing your order.</p>

                <label class='inline'>
                    <input type="checkbox" name="terms-and-conditions" id="terms-and-conditions" data-bind="checked: agreeToTerms"> I agree to the <a href="javascript:;">terms &amp; conditions</a>.
                </label>
				<span class="mz-validation-message" data-bind="text: agreeToTerms.validationMessage() || '&nbsp;'"></span>

				{% if  User.isAnonymous %}
                <label class='inline'>
                    <input type="checkbox" name="create-new-account" data-bind="checked: createAccount"> Create an account for easy checkout on future orders
                </label>

                <div id="create-account-fields" data-bind="visible: createAccount">
                    <label>
                        Username
                        <input type="text" name="new-account-email" data-bind="value: email, css: {invalid: email.invalid() }">
						<span class="mz-validation-message" data-bind="text: email.validationMessage() || '&nbsp;'"></span>
                    </label>
                    <label>
                        Create password
                        <input type="password" name="new-account-password" data-bind="value: password, css: {invalid: password.invalid() }">
                    </label>
                    <label>
                        Confirm password
                        <input type="password" name="new-account-confirm" data-bind="value: confirmPassword, css: {invalid: confirmPassword.invalid() }">
                    </label>
					<span class="mz-validation-message" data-bind="text: password.validationMessage() || '&nbsp;'"></span>
					<span class="mz-validation-message" data-bind="text: confirmPassword.validationMessage() || '&nbsp;'"></span>
                </div>
				{% endif %}

                <div class="mz-next-step">
					<div class="mz-loading-bar">
						<span class="l-1"></span>
						<span class="l-2"></span>
						<span class="l-3"></span>
						<span class="l-4"></span>
						<span class="l-5"></span>
						<span class="l-6"></span>
					</div>
                    <button class="mz-submit-button mz-button mz-btn-cta" data-bind="click: submit">Place Order</button>
                </div>
            </div><!-- .mz-inner-panel -->
			</div>
        </div><!-- Step 4 .panel -->
	</div><!-- left .column -->

	<div class="mz-column" id="checkout-rightcol">
		<div class="mz-panel" id="panel-order-summary">
			<h3 class="mz-panel-header">
				Order Summary
				<button data-bind="click: editCart">Edit</button>
			</h3>

			<div id="order-summary" data-bind="with: orderSummary">
				<table>
					<thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Each</th>
                            <th>Total</th>
                        </tr>
                    </thead>
					<!-- ko foreach: items -->
					<tbody>
                        <tr class="line-item" data-bind="css: { discounted: discount }">
                            <td data-bind="text: productName"></td>
                            <td data-bind="text: quantity"></td>
                            <td><span class="item-price" data-bind="currencyText: unitPrice"></span></td>
                            <td><span class="item-price" data-bind="currencyText: subTotal"></span></td>
                        </tr>
						<!-- ko if: discount -->
						<tr class="line-item discount">
							<td colspan="2">
								<span class="discount-name" data-bind="text: discount.name"></span> 
								<span class="discount-amt" data-bind="visible: discount.freeShipping">Free Shipping</span>
								<span class="discount-amt" data-bind="visible: !discount.freeShipping"><span data-bind="currencyText: unitPrice - discount.salePrice"></span> OFF</span>
							</td>
							<td><span data-bind="currencyText: discount.salePrice"></span></td>
							<td><span data-bind="currencyText: discount.salePrice * quantity"></span></td>
						</tr>
						<!-- /ko -->
					</tbody>
					<!-- /ko -->
					<tbody>
                        <tr class="cost-summary">
                            <td colspan="4">
                                <table>
                                    <tr>
                                        <td>Sub-Total:</td>
                                        <td><span data-bind="currencyText: subTotal"></span></td>
                                    </tr>
                                    <tr class="shipping-total-row">
                                        <td>Shipping &amp; Handling:</td>
                                        <td><span data-bind="currencyText: shippingTotal"></span></td>
                                    </tr>
                                    <tr>
                                        <td>Tax:</td>
                                        <td><span data-bind="currencyText: taxTotal"></span></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
					</tbody>
					<tbody>
                        <tr class="total">
                            <td colspan="4">Total: <span data-bind="currencyText: total"></span></td>
                        </tr>
					</tbody>
				</table>
			</div><!-- #order-summary -->

		</div><!-- Order Summary .panel -->

		<div id="coupon-code-container" data-bind="with: orderSummary, css: { 'submitting-coupon': orderSummary.stepStatus() == 'submitting' }">
			<label for="coupon-code">Coupon Code</label>
			<input type="text" id="coupon-code" name="coupon-code" data-bind="value: couponCode">
			<button class="mz-submit-button" data-bind="click: nextStep">Apply</button>
			<div class="mz-loading-bar">
				<span class="l-1"></span>
				<span class="l-2"></span>
				<span class="l-3"></span>
				<span class="l-4"></span>
				<span class="l-5"></span>
				<span class="l-6"></span>
			</div>
		</div>

		<label>
			Comments
			<textarea id="comments" name="comments" data-bind="value: orderSummary.comments"></textarea>
		</label>

	</div><!-- right .column -->
</form>

{% endblock BodyContent %}
