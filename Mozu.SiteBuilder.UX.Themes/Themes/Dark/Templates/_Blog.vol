{% extends "default" %}

{% block Init %}
{%setTemplateVariables BodyTagClasses="blog" %}
{% endblock Init%}

{% block BodyContent %}

<div id="mz-layout-container" class="mz-content-inner-wrap mz-blog-list-page">
    
	<h1 class="mz-page-header" {% data_attributes Model.Title %}>{{ Model.Title }}</h1>

    <div id="mz-layout-main">

        {% if Model.posts|length < 1 and SiteContext.IsEditMode %}
        <div class="mz-empty-text">
            You have no posts &ndash; Do you have something to say? DO YOU? <br>
            Click here to tell the world what you are thinking.
        </div>
        {% endif %}
        <div class="mz-blog-list">
            {% for post in Model.posts %}
            <div class="mz-blog-post"> 
                <h2 class="mz-blog-post-title">
                    <a class="mz-title-link" href="{{post.url}}">{{post.title}}</a>
                </h2>
                {% if forloop.counter0 == 0 and  Model.config.postListFormat == "expandLatest" %}
                <div class="mz-blog-post-body">
                    <span class="mz-blog-date">{{post.date|date:"F j, Y"}}</span>
                    <div class="mz-author-wrap"> Posted by <span class="mz-author-name">{{Model.config.author}}</span></div>
                    {{post.body}}
                    <a class="mz-read-more-a" href="{{post.url}}">continue reading...</a>
                </div>

                {% else %}
                <div class="mz-blog-post-teaser">
                    <span class="mz-blog-date">{{post.date|date:"F j, Y"}}</span>
                    <div class="mz-author-wrap"> Posted by <span class="mz-author-name">{{Model.config.author}}</span></div>
                    {{post.teaser}}
                    <a class="mz-read-more-a" href="{{post.url}}">continue reading...</a>
                </div>
                {% endif %}
                {% if Model.config.enableShare != false %}
                <div class="mz-blog-post-links">
                    <ul class="mz-blog-social-links">
                        <li class="mz-bsl-li">
                            <a class="mz-bsl-a" href="#">
                                <i class="mz-icon mz-i-facebook-sm"></i>Like
                            </a>
                        </li>
                        <li class="mz-bsl-li">
                            <a class="mz-bsl-a" href="#">
                                <i class="mz-icon mz-i-twitter-sm"></i>Tweet
                            </a>
                        </li>
                    </ul>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    <div id="mz-layout-right">
        {% dropzone "body-right" %} 
    </div>
	<div class="clearfix">
	</div>
</div>

{% endblock BodyContent %}

