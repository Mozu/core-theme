{% extends "default" %}
{% setTemplateVariables BodyTagClasses="category" %}

{% block BodyContent %}

<div id="mz-layout-container" class="mz-content-inner-wrap mz-blog-list-page {% if SiteContext.Navigation.Secondary %}mz-category-sidenav-true{% endif %}">

    {% if SiteContext.Navigation.Secondary %}
        {% include "modules/LeftNav" %}
    {% endif %}

    {% html_action "ProductListing" "catalog" with categoryTitle=Model.name and categoryId=Model.id and viewName="modules/productListing" as_parameter %}
</div>

{% endblock BodyContent %}