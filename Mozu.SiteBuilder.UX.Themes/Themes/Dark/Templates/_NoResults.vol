{% extends "default" %}
{% setTemplateVariables BodyTagClasses="search-results no-results" %}

{% block BodyContent %}

<div class="mz-search-results">
    <h2 class="mz-search-restults-title mz-page-title">Search Results</h2>
	<h3>Sorry, your search yielded no results.</h3>
	<ul>
		<li>Are all of your search terms spelled correctly?</li>
		<li>Have you tried removing some active filters?</li>
	</ul>
</div>
{% endblock BodyContent %}