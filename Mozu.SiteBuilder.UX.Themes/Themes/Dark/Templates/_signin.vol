{% extends "default" %}

{% block Init %}
	{% setTemplateVariables BodyTagClasses="login" %}
{% endblock Init%}

{% block BodyContent %}

<div id="sign-in">
	<h2>Sign In</h2>
    <form method="POST">
        <table>
             <tr>
                <td>
                   {% html_validation_summary %}
                </td>
            </tr>
            <tr>
                <td>
                    <label for="email">Email</label>
                </td>
            </tr>
            <tr>
                <td>
                    <input name="email" value="{{model.email|default:user.email}}" type="email"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="password">Password</label>
                </td>
            </tr>
            <tr>
                <td>
                    <input name="password"  type="password"/>
                </td>
            </tr>
              
            <tr>
                <td align="right">
                    <input type="submit" class="prtyButton"/></td>
            </tr>
        </table>

       

    </form>
	
</div>

{% endblock BodyContent %}
