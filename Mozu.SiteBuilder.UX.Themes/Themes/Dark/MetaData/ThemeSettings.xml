<?xml version="1.0"?>
<settings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\..\Tools\ThemeSettings.xsd">
  <items>
    <section id="colors" label="Colors" visible="true">
      <items>
        <group id="globalFontColor" label="Global Colors">
          <items>
            <setting id="siteBackgroundColor" type="color" label="Background color behind your site" defaultValue="#E5E5E5"  />
            <setting id="wrapBackgroundColor" type="color" label="Overall background color for your site" defaultValue="#FFFFFF"  />
          </items>
        </group>
        <group id="siteHeaderBackgroundColor" label="Site Header Background Color">
          <items>
            <setting id="siteHeaderBackgroundColor" type="color" label="Background color behind your site header" defaultValue="#333333"  />
            <setting id="wrapBackgroundColor" type="color" label="Overall background color for your site" defaultValue="#FFFFFF"  />
          </items>
        </group>
        <group id="color_nav" label="Navigation">
          <items>
            
            <setting id="navBackgroundColor" type="color" label="Navigation Background Color" defaultValue="#CCCCCC"  />
            <setting id="storeNameColor" type="color" label="Store name color" defaultValue="#FFFFFF"  />
            <setting id="siteNavColorLevel1" type="color" label="Site first level navigation color" defaultValue="#C5C5C5"  />
            <setting id="siteNavVisitedColorLevel1" type="color" label="Site first level navigation visited color" defaultValue="#C5C5C5"  />
            <setting id="siteNavHoverColorLevel1" type="color" label="Site first level navigation hover color" defaultValue="#C5C5C5"  />
            <setting id="siteNavColorLevel2" type="color" label="Site second level navigation color" defaultValue="#333333"  />
            <setting id="siteNavVisitedColorLevel2" type="color" label="Site second level navigation visited color" defaultValue="#FFFFFF"  />
            <setting id="siteNavHoverColorLevel2" type="color" label="Site second level navigation hover color" defaultValue="#FFFFFF"  />
            <setting id="siteNavColorLevel3" type="color" label="Site third level navigation color" defaultValue="#333333"  />
            <setting id="siteNavVisitedColorLevel3" type="color" label="Site third level navigation visited color" defaultValue="#333333"  />
            <setting id="siteNavHoverColorLevel3" type="color" label="Site third level navigation hover color" defaultValue="#00FFFF"  />
          </items>
        </group>
        <group id="color_body" label="Body">
          <items>
            <setting id="contentBackgroundColor" type="color" label="The background color of your content area" defaultValue="#FFFFFF"  />
            <setting id="defaultTextColor" type="color" label="Body text color" defaultValue="#333333"  />
            <setting id="headlineTextColor" type="color" label="Headline color" defaultValue="#666666"  />
            <setting id="subHeadlineTextColor" type="color" label="Sub headline color" defaultValue="#333333"  />
            <setting id="linkColor" type="color" label="Link color" defaultValue="#333333"  />
            <setting id="linkVisited" type="color" label="Link (visited) color" defaultValue="#333333"  />
            <setting id="linkHover" type="color" label="Link (hover) color" defaultValue="#333333"  />
            <setting id="breadcrumbColor" type="color" label="Breadcrumb font color" defaultValue="#555555"  />
          </items>
        </group>
        <group id="color_footer" label="Footer">
          <items>
            <setting id="siteFooterLinkColor" type="color" label="Site footer color" defaultValue="#FFFFFF"  />
            <setting id="siteFooterVisitedLinkColor" type="color" label="Site footer visited color" defaultValue="#FFFFFF"  />
            
            <setting id="siteFooterHoverLinkColor" type="color" label="Site footer hover color" defaultValue="#FFFFFF"  />
          </items>
        </group>
      </items>
      
    </section> 
    <section id="fonts" label="Fonts" visible="true">
      <items>
        <group id="globalFontGroup" label="Global Font">
          <items>
            <setting id="globalFont" type="font" label="Global Font" defaultValue="14px Tahoma, sans-serif"  />
          </items>
        </group>
          <group id="font_site_nav" label="Navigation">
              <items>
                  <setting id="storeNameFont" type="font" label="Store name font" defaultValue="bold 30px Tahoma, sans-serif"  />
                  <setting id="siteNavFontLevel1" type="font" label="Site first level navigation font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavVisitedFontLevel1" type="font" label="Site first level navigation visited font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavHoverFontLevel1" type="font" label="Site first level navigation hover font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavFontLevel2" type="font" label="Site second level navigation font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavVisitedFontLevel2" type="font" label="Site second level navigation visited font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavHoverFontLevel2" type="font" label="Site second level navigation hover font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavFontLevel3" type="font" label="Site third level navigation font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavVisitedFontLevel3" type="font" label="Site third level navigation visited font" defaultValue="14px Tahoma, sans-serif"  />
                  <setting id="siteNavHoverFontLevel3" type="font" label="Site third level navigation hover font" defaultValue="14px Tahoma, sans-serif"  />
              </items>
          </group>
          <group id="content_body" label="Content Body">
          <items>
          </items>
        </group>
        <group id="font_footer" label="Footer">
          <items>
            <setting id="siteFooterLinkFont" type="font" label="Site footer font" defaultValue="11px/110% Tahoma, sans-serif"  />
            <setting id="siteFooterHoverLinkFont" type="font" label="Site footer font (hover)" defaultValue=" 11px/110% Tahoma, sans-serif"  />
          </items>
        </group>
      </items>
    </section>
  </items>
</settings>
