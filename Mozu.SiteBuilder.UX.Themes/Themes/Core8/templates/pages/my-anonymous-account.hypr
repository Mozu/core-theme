{% extends "page" %}

{% block title-tag-content %}{% firstof pageContext.metaTitle labels.logIn %} - {% parent %}{% endblock title-tag-content %}

{% block body-tag-classes %} mz-loginpage {% endblock body-tag-classes %}

{% block body-content %}
    <div class="mz-l-container">
        <h1 class="mz-pagetitle">{{ labels.orderStatus }}</h1>

        <div class="mz-l-stack-section mz-accountorderhistory" id="anonymous-account-order">
            {% include "modules/my-account/order-history-order-listing" with model=model.order %}
        </div>

        <div class="mz-l-stack-section mz-accountreturnhistory" id="anonymous-account-return">
            {% include "modules/my-account/my-account-returnhistory" with model=model.returns %}
        </div>
    </div>
{% endblock body-content %}
