{
  /* About: Basic Information about the theme. */
  "about": {
    "name": "Core4",
    "author": "Volusion",
    "extends": null,
    "isDesktop": true,
    "isMobile": false,
    "defaultLanguage": "en-US"
  },

  /* Settings: User-configurable options for your theme. */
  "settings": {

    "internal-themeAddons"              : [],

    /* Common settings used in templates */
    "defaultPageSize"                   : 15,
    "pageSizeOptions"                   : [15,25,50,100],
    "maxProductSummaryWords"            : 40,

    /* Common apperance settings used in the stylesheet */
    "font"                              : "Source Sans Pro",
    "fallbackFontFamily"                : "sans-serif",
    "fontSize"                          : "14px",
    "gutterWidth"                       : "25px",
    "textColor"                         : "#444444",
    "bodyBackgroundColor"               : "#FFFFFF",
    "bannerImageEnabled"                : false,
    "bannerImage"                       : "/resources/images/banner.jpg",
    "bannerImageRepeat"                 : "repeat-x",

    /* Settings specific to category page display */
    "showCategoryFacets"                : true,

    /* Settings specific to product listing modules */
    "listProductShortDesc"              : true,
    "listProductCode"                   : true,

    /* Settings specific to product pages */
    "showProductDetailShortDesc"        : true,
    "showProductDetailProperties"       : true,
    "showProductDetailMeasurements"     : true,

    /* Settings specific to the cart */
    "showCartItemOptions"               : true,
    "showCartItemImage"                 : true,
    "showCartItemDimensions"            : true,
    "showCartItemWeight"                : true,

    /* Settings specific to checkout pages */
    "showCheckoutCommentsField"         : true,
    "requireCheckoutAgreeToTerms"       : true
  },
  /* Page Types: Users will be allowed to create documents of this type in the CMS */
  "pageTypes": [

    /* user-creatable webpages */
    {
      "id":             "about_us",
      "title":          "About Us",
      "entityType":     "webpage",
      "documentType":   "web_page",
      "template":       "about-us",
      "userCreatable":  true,
      /* list of widgets attached to this type of page by default */
      "widgets": [
        {
          "definitionId": "content",
          "zoneId": "body",
          "index": 0,
          "config": {
            "body": "<p>About Us</p>"
          }
        }
      ]
    },
    {
      "id":             "blank_page",
      "title":          "Blank Page",
      "entityType":     "webpage",
      "documentType":   "web_page",
      "template":       "blank-page",
      "userCreatable":  true
    },
    {
      "id":             "landing",
      "title":          "Landing Page",
      "entityType":     "webpage",
      "userCreatable":  true,
      "template":       "blank-page"
    },
    {
      "id":             "home",
      "title":          "Home Page",
      "entityType":     "webpage",
      "userCreatable":  true,
      "template":       "home"
    },
    /* catalog types */
    {
      "id":             "category",
      "title":          "Category",
      "entityType":     "category",
      "userCreatable":  false,
      "template":       "category"
    },
    {
      "id":             "product",
      "title":          "Product",
      "entityType":     "product",
      "userCreatable":  false,
      "template":       "product"
    },
    {
      "id":             "search",
      "title":          "Search Results",
      "entityType":     "searchresult",
      "template":       "search-results",
      "userCreatable":  false
    },
    /* system pages */
    {
      "id":             "404",
      "title":          "404 Not Found",
      "entityType":     "webpage",
      "documentType":   "web_page",
      "template":       "404",
      "userCreatable":  false
    },
    {
      "id":             "cart",
      "title":          "Cart",
      "entityType":     "cart",
      "template":       "cart",
      "userCreatable":  false
    },
    {
      "id":             "checkout",
      "title":          "Checkout",
      "entityType":     "order",
      "template":       "checkout",
      "userCreatable":  false
    },
    {
      "id":             "confirmation",
      "title":          "Confirmation",
      "entityType":     "order",
      "template":       "confirmation",
      "userCreatable":  false
    },
    {
      "id":             "my_account",
      "title":          "My Account",
      "entityType":     "customer",
      "template":       "my-account",
      "userCreatable":  false
    },
    {
      "id":             "login",
      "title":          "Login",
      "entityType":     "login",
      "template":       "login",
      "userCreatable":  false
    }
  ],
  /* widgets */
  "widgets": [
    {
         "id": "featured_product",
         "displayName": "Featured Products",
         "displayTemplate": "catalog/featuredproducts",
         "icon": "_0007_featured-products.png",
         "editView": "Taco.view.site.widget.FeaturedProducts",
        
         "editViewConfig": "{listeners:{afterRender:function() {console.log('test of the editviewConfig system');}}}",
         "properties": []
    }, 
    {
        "id": "content",
        "displayName": "Content",
        "displayTemplate": "cms/content",
        "icon": "_0004_html.png",
        "defaultConfig": {
			"body": "<h2>title</h2><div>Content</div>"
		}
    },
      {
        "id": "image",
        "displayName": "test image",
        "displayTemplate": "cms/image",
        "editViewFields":[
            {
                "name":"image",
                "fieldLabel":"image",
                "xtype":"taco-singleimagefield"
            }
         ],
        "icon": "_0004_html.png"
    },
    {
        "id": "horizontal_rule",
        "displayName": "Horizontal Rule",
        "displayTemplate": "cms/horizontalrule",
        "icon": "_0005_horizontal-divider.png",
        "editView": "Taco.view.site.widget.HorizontalRule",
        "defaultConfig": {
            "hrBorderWidth": "1px",
            "hrBorderColor": "#000",
            "hrBorderStyle": "solid",
            "hrMarginTop": "None",
            "hrMarginBottom": "None"
        }
    }, 
    {
        "id": "addthis",
        "displayName": "AddThis",
        "displayTemplate": "social/addthis",
        "editView": "Taco.view.site.widget.AddThis",
        "properties": [],
        "category": "social",
        "icon": "_0008_share.png"
    }, 
    {
        "id": "facebook_comments",
        "displayName": "Facebook Comments",
        "displayTemplate": "social/facebookComments",
        "icon": "_0008_share.png",
        "editView": "Taco.view.site.widget.FacebookComments",
        "minWidth": 400,
        "properties": [],
        "category": "social"
    }
 ]
}
