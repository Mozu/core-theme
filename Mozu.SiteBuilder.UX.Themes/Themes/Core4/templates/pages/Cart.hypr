{% extends "layouts/default" %}

{% block Init %}
    {% setTemplateVariables BodyTagClasses="mz-cart" %}
    {% require_script "pages/cart" %}
    {{ block.super }}
{% endblock Init%}

{% block BodyContent %}

{% preload_json Model "cart" %}

<div id="mz-layout-container" class="mz-layout-container mz-cart-page mz-content-inner-wrap">
	<h1 class="mz-page-header">Your Cart</h1>
	<form method="post" action="/cart/checkout" id="mz-cart-form">
        {% include "Modules/Common/MessageBar" %}
        <table class="mz-table mz-cart" id="mz-cart">
            {% include "Modules/Cart/CartTableBody" %}
        </table>
	</form>
</div>

{% endblock BodyContent %}