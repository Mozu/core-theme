{% extends "page" %}

{% block title-tag-content %} Order Confirmation - {{block.super}} {% endblock title-tag-content %}

{% block body-content %}


<div class="mz-l-container">
    <h1 class="mz-pagetitle">
        Order Confirmation
    </h1>

	<h4>Thank you for your order!  You will receive email confirmation.</h4>

	<table id="mz-purchase-details" class="mz-purchase-details">
		<thead>
			<tr>
				<td class="mz-field-interstitial" colspan="2">Order#: <strong>{{ Model.OrderNumber }}</strong></td>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td class="mz-field-interstitial" colspan="2"><hr></td>
			</tr>
			{% if Model.BillingInfo.PaymentType == PaymentTypes.CreditCard %}
			<tr>
				<td class="mz-field-label">Billing Name:</td>
				<td>{{ Model.BillingInfo.BillingContact.FirstName }} {{ Model.BillingInfo.BillingContact.LastNameOrSurname }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Billing Address:</td>
				<td>{{ Model.BillingInfo.BillingContact.Address.Address1 }}</td>
			</tr>
				{% if Model.BillingInfo.BillingContact.Address.Address2 %}
			<tr>
				<td></td>
				<td>{{ Model.BillingInfo.BillingContact.Address.Address2 }}</td>
			</tr>
				{% endif %}
			<tr>
				<td></td>
				<td>{{ Model.BillingInfo.BillingContact.Address.CityOrTown }}, {{ Model.BillingInfo.BillingContact.Address.StateOrProvince }} {{ Model.BillingInfo.BillingContact.Address.PostalOrZipCode }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Phone:</td>
				<td>{{ Model.BillingInfo.BillingContact.PhoneNumbers.Home }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Email:</td>
				<td>{{ Model.BillingInfo.BillingContact.Email }}</td>
			</tr>
			<tr>
				<td class="mz-field-interstitial" colspan="2"><hr></td>
			</tr>
			<tr>
				<td class="mz-field-label">Card Type:</td>
				<td>{{ Model.BillingInfo.Card.PaymentOrCardType }}</td>
			</tr>
			<tr>
				<td class="mz-field-label">Credit Card #:</td>
				<td>{{ Model.BillingInfo.Card.CardNumberPartOrMask }}</td>
			</tr>
			{% comment %} {# this isn't returned by the services #}
			<tr>
				<td class="mz-field-label">Expiration:</td>
				<td>{{ Model.BillingInfo.Card.ExpireMonth }}.{{ Model.BillingInfo.Card.ExpireYear }}</td>
			</tr>
			{% endcomment %}
			{% else %} {# "Pay by Check" #}
			<tr>
				<td class="mz-field-label">Payment Type:</td>
				<td>{{ Model.BillingInfo.PaymentType }}</td>
			</tr>
			<tr>
				<td></td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td class="mz-field-label"><strong>Mail check to:</strong></td>
				<td>
					{% if ViewData.MailCheckTo.CompanyOrOrganization %}
					{{ ViewData.MailCheckTo.CompanyOrOrganization }}
					{% else %}
					{{ ViewData.MailCheckTo.FirstName }} {{ ViewData.MailCheckTo.LastNameOrSurname }}
					{% endif %}
				</td>
			</tr>
			<tr>
				<td></td>
				<td>{{ ViewData.MailCheckTo.Address.Address1 }}</td>
			</tr>
			<tr>
				<td></td>
				<td>{{ ViewData.MailCheckTo.Address.CityOrTown }}, {{ ViewData.MailCheckTo.Address.StateOrProvince }} {{ ViewData.MailCheckTo.Address.PostalOrZipCode }} </td>
			</tr>
			{% endif %}
			<tr>
				<td></td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td class="mz-field-label">Ship to:</td>
				<td>{{ Model.ShippingInfo.ShippingContact.FirstName }} {{ Model.ShippingInfo.ShippingContact.LastNameOrSurname }}</td>
			</tr>
			<tr>
				<td></td>
				<td>{{ Model.ShippingInfo.ShippingContact.Address.Address1 }}</td>
			</tr>
			{% if Model.ShippingInfo.ShippingContact.Address.Address2  %}
			<tr>
				<td></td>
				<td>{{ Model.ShippingInfo.ShippingContact.Address.Address2 }}</td>
			</tr>
			{% endif %}
			<tr>
				<td></td>
				<td>{{ Model.ShippingInfo.ShippingContact.Address.CityOrTown }}, {{ Model.ShippingInfo.ShippingContact.Address.StateOrProvince }} {{ Model.ShippingInfo.ShippingContact.Address.PostalOrZipCode }}</td>
			</tr>
			<tr>
				<td></td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td class="mz-field-label">Shipping Method:</td>
				<td><strong>{{ Model.ShippingInfo.ShippingMethodName }}</strong></td>
			</tr>
		</tbody>
	</table><!-- #purchase-details-->

	<h2>Order Summary</h2>
    {% include "modules/common/order-summary" %}
    {% if Model.ShopperNotes.Comments %}
    <div class="mz-ordercomments">
        <h5 class="mz-ordercomments-header">Comments</h5>
        <p class="mz-ordercomments-body">{{ Model.ShopperNotes.Comments }}</p>
    </div>
    {% endif %}
    {% if Model.ShopperNotes.GiftMessage %}
    <div class="mz-ordercomments">
        <h5 class="mz-ordercomments-header">Gift Message</h5>
        <p class="mz-ordercomments-body">{{ Model.ShopperNotes.GiftMessage }}</p>
    </div>
    {% endif %}
</div><!-- #order-confirmation -->

{% endblock body-content %}

{% block trailing-scripts %}
	{{ block.super }}
	{% if SiteContext.GoogleAnalyticsEnabled and SiteContext.GoogleAnalyticsEcommerceEnabled %}
	<script>
	_gaq.push(['_addTrans',
		'{{ Model.OrderNumber }}',						
		'{{ siteContext.settings.general.websiteName }}',
		'{{ Model.Total }}',							
		'{{ Model.TaxTotal }}',					
		'{{ Model.ShippingTotal }}',		
		'{{ Model.ShippingInfo.ShippingContact.Address.CityOrTown }}',
		'{{ Model.ShippingInfo.ShippingContact.Address.StateOrProvince }}',			
		'USA'
	]);

	{% for item in Model.Items %}
	_gaq.push(['_addItem',
		'{{ Model.OrderNumber }}',	
		'{{ item.Product.ProductCode }}',
		'{{ item.Product.Name }}',
		'',
		'{{ item.Price.Price }}',
		'{{ item.Quantity }}'

	]);
	{% endfor %}

	_gaq.push(['_trackTrans']);
	</script>
	{% endif %}

{% endblock trailing-scripts %}

		
		
		