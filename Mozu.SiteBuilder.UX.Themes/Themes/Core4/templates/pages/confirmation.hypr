{% extends "page" %}

{% block body-tag-classes %} mz-confirmation {% endblock body-tag-classes %}

{% block title-tag-content %} {{ labels.orderConfirmation }} - {% parent %} {% endblock title-tag-content %}

{% block body-content %}

{% preload_json model "order" %}

<div class="mz-l-container">
    <h1 class="mz-pagetitle">{{ labels.orderConfirmation }} </h1>

	<p>{{ labels.confirmationText }}</p>

    <p>{{ labels.yourOrderNumber|string_format(model.orderNumber)|safe }}</p>

    <div class="mz-l-stack">
        <div class="mz-l-stack-section">
            <h4 class="mz-l-stack-sectiontitle">{{ labels.payments }}</h4>
            {% for payment in model.payments %}
            {% if payment.status != "Voided" %}
            <div class="mz-checkout-payment">
                <h4 class="mz-checkout-paymenttitle"><strong>{{ payment.amountRequested|currency }}</strong> &mdash; {{ payment.billingInfo.paymentType }}</h4>
                <dl class="mz-propertylist">
                    {% if payment.billingInfo.billingContact.email %}
                    <dt>{{ labels.billingEmail }}</dt>
                    <dd>{{ payment.billingInfo.billingContact.email }}</dd>
                    {% endif %}
                    {% if payment.billingInfo.paymentType == "StoreCredit" %}
                    <dt>{{ labels.storeCreditNumber }}</dt>
                    <dd>{{ payment.billingInfo.storeCreditCode }}</dd>
                    {% else %}
                    <dt>{{ labels.billingName }}</dt>
                    <dd>{{ payment.billingInfo.billingContact.firstName }} {{ payment.billingInfo.billingContact.lastNameOrSurname }}</dd>
                    <dt>{{ labels.billingAddress }}</dt>
                    <dd class="mz-addresssummary">{% include "modules/common/address-summary" with model=payment.billingInfo.billingContact %}</dd>
                    {% endif %}
                    {% if payment.billingInfo.paymentType == "CreditCard" %}
                    <dt>{{ labels.cardType }}</dt>
                    <dd>{{ payment.billingInfo.card.paymentOrCardType }}</dd>
                    <dt>{{ labels.cardNumber }}</dt>
                    <dd>{{ payment.billingInfo.card.cardNumberPartOrMask|default("****************") }}</dd>
                    {% endif %}
                    {% if model.billingInfo.paymentType == "PaypalExpress" %}
                    <dt>{{ labels.paymentType }}</dt>
                    <dd>{{ labels.payPal }}</dd>
                    {% endif %}
                    {% if payment.billingInfo.paymentType == "Check" %}
                    <!--
                    <dt>{{ labels.checkNumber }}</dt>
                    <dd>{{ payment.billingInfo.check.checkNumber }}</dd>
                    -->
                    <dt><strong>{{ labels.mailCheckTo }}</strong></dt>
                    <dd class="mz-addresssummary">
                        <span>{{ ViewData.mailCheckTo.shippingOriginContact.firstName}} {{ ViewData.mailCheckTo.shippingOriginContact.lastNameOrSurname }}</span>
                        <span>{{ ViewData.mailCheckTo.shippingOriginContact.companyOrOrganization }}</span>
                        {% include "modules/common/address-summary" with model=ViewData.mailCheckTo %}
                    </dd>
                    {% endif %}
                </dl>
            </div>
            {% endif %}
            {% endfor %}
        </div>
        <div class="mz-l-stack-section">
            <h4 class="mz-l-stack-sectiontitle">{{ labels.shippingInformation }}</h4>
            <dl class="mz-propertylist">
                <dt>{{ labels.shipTo }}</dt>
                <dd class="mz-addresssummary">{% include "modules/common/address-summary" with model=model.fulfillmentInfo.fulfillmentContact %}</dd>
                <dt>{{ labels.shippingMethod }}</dt>
                <dd>{{ model.fulfillmentInfo.shippingMethodName }}</dd>
            </dl>
        </div>

        <div class="mz-l-stack-section">
            <h4 class="mz-l-stack-sectiontitle">{{ labels.orderSummary }} </h4>
            {% include "modules/common/order-summary" %}
            {% if model.shopperNotes.comments %}
            <div class="mz-ordercomments">
                <h5 class="mz-ordercomments-header">{{ labels.comments }}</h5>
                <p class="mz-ordercomments-body">{{ model.shopperNotes.comments }}</p>
            </div>
            {% endif %}
            {% if model.shopperNotes.giftMessage %}
            <div class="mz-ordercomments">
                <h5 class="mz-ordercomments-header">{{ labels.giftMessage }}</h5>
                <p class="mz-ordercomments-body">{{ model.shopperNotes.giftMessage }}</p>
            </div>
            {% endif %}
        </div>
    </div>
</div><!-- #order-confirmation -->

{% endblock body-content %}

{% block trailing-scripts %}
	{% parent %}
	{% if siteContext.generalSettings.isGoogleAnalyticsEnabled and siteContext.generalSettings.isGoogleAnalyticsEcommerceEnabled %}
	{% include "modules/analytics/google-analytics-ecommerce-tracking-code" %}
	{% endif %}

{% endblock trailing-scripts %}

		
		
		