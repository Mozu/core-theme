{% extends "page" %}

{% block body-tag-classes %} mz-confirmation {% endblock body-tag-classes %}

{% block title-tag-content %} {{ themeSettings.labelOrderConfirmation }} - {{block.super}} {% endblock title-tag-content %}

{% block body-content %}


<div class="mz-l-stack">
    <h1 class="mz-pagetitle">
        {{ themeSettings.labelOrderConfirmation }}
    </h1>

	<h4>{{ themeSettings.labelConfirmationText }}</h4>

    <div class="mz-l-stack-section">
    <h2>{{ themeSettings.labelOrderDetails }}</h2>
    <dl class="mz-propertylist">
        <dt>{{ themeSettings.labelOrderNumber }}</dt>
        <dd>{{ Model.OrderNumber }}</dd>
        <dt>{{ themeSettings.labelBillingName }}</dt>
        <dd>{{ Model.BillingInfo.BillingContact.FirstName }} {{ Model.BillingInfo.BillingContact.LastNameOrSurname }}</dd>
        <dt>{{ themeSettings.labelBillingAddress }}</dt>
        <dd class="mz-addresssummary">{% include "modules/common/address-summary" with Model=Model.BillingInfo.BillingContact %}</dd>
        <dt>{{ themeSettings.labelBillingPhone }}</dt>
        <dd>{{ Model.BillingInfo.BillingContact.PhoneNumbers.Home }}</dd>
        <dt>{{ themeSettings.labelBillingEmail }}</dt>
        <dd>{{ Model.BillingInfo.BillingContact.Email }}</dd>
        {% if Model.BillingInfo.PaymentType == "CreditCard" %}
        <dt>{{ themeSettings.labelCardType }}</dt>
        <dd>{{ Model.BillingInfo.Card.PaymentOrCardType }}</dd>
        <dt>{{ themeSettings.labelCardNumber }}</dt>
        <dd>{{ Model.BillingInfo.Card.CardNumberPartOrMask }}</dd>
        {% else %}
        <dt>{{ themeSettings.labelCheckNumber }}</dt>
        <dd>{{ Model.BillingInfo.Check.CheckNumber</dd>
        <dt><strong>{{ themeSettings.labelMailCheckTo }}:</strong></dt>
        <dd class="mz-addresssummary">{% include "modules/common/address-summary" with Model=ViewData.MailCheckTo %}</dd>
        {% endif %}
        <dt>{{ themeSettings.labelShipTo }}</dt>
        <dd class="mz-addresssummary">{% include "modules/common/address-summary" with Model=Model.ShippingInfo.ShippingContact %}</dd>
        <dt>{{ themeSettings.labelShippingMethod }}</dt>
        <dd>{{ Model.ShippingInfo.ShippingMethodName }}</dd>
    </dl>
    </div>

    <div class="mz-l-stack-section">
	<h2>{{ themeSettings.labelOrderSummary }} </h2>
    {% include "modules/common/order-summary" %}
    {% if Model.ShopperNotes.Comments %}
    <div class="mz-ordercomments">
        <h5 class="mz-ordercomments-header">{{ themeSettings.labelComments }}</h5>
        <p class="mz-ordercomments-body">{{ Model.ShopperNotes.Comments }}</p>
    </div>
    {% endif %}
    {% if Model.ShopperNotes.GiftMessage %}
    <div class="mz-ordercomments">
        <h5 class="mz-ordercomments-header">{{ themeSettings.labelGiftMessage }}</h5>
        <p class="mz-ordercomments-body">{{ Model.ShopperNotes.GiftMessage }}</p>
    </div>
    {% endif %}
    </div>
</div><!-- #order-confirmation -->

{% endblock body-content %}

{% block trailing-scripts %}
	{{ block.super }}
	{% if SiteContext.GoogleAnalyticsEnabled and SiteContext.GoogleAnalyticsEcommerceEnabled %}
	<script>
	_gaq.push(['_addTrans',
		'{{ Model.OrderNumber }}',						
		'{{ siteContext.settings.general.websiteName }}',
		'{{ Model.Total }}',							
		'{{ Model.TaxTotal }}',					
		'{{ Model.ShippingTotal }}',		
		'{{ Model.ShippingInfo.ShippingContact.Address.CityOrTown }}',
		'{{ Model.ShippingInfo.ShippingContact.Address.StateOrProvince }}',			
		'USA'
	]);

	{% for item in Model.Items %}
	_gaq.push(['_addItem',
		'{{ Model.OrderNumber }}',	
		'{{ item.Product.ProductCode }}',
		'{{ item.Product.Name }}',
		'',
		'{{ item.Price.Price }}',
		'{{ item.Quantity }}'

	]);
	{% endfor %}

	_gaq.push(['_trackTrans']);
	</script>
	{% endif %}

{% endblock trailing-scripts %}

		
		
		