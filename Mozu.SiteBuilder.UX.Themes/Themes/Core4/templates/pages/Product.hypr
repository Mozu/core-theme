{% extends "layouts\default" %}

{% block Init %}
	{% setTemplateVariables BodyTagClasses="mz-product" %}
	{{ block.super }}
{% endblock Init%}

{% block BodyContent %}

{% require_script "pages/product" %}


{% preload_json Model "product" %}

<div id="mz-product-detail" class="mz-product-detail-wrap">

	<h1 class="mz-page-header">{{ Model.Content.ProductName }}
        <span class="mz-product-code mz-auxiliary-text">Product Code: {{ Model.ProductCode }}</span>
    </h1>
	
	{% include "Modules/Product/ProductImages" %}

    {% include "Modules/Common/MessageBar" %}

	<div class="mz-detail-info-wrap">
        {% include "Modules/Product/ProductDetail" %}
	</div>
</div>

{% endblock BodyContent %}


 