{% extends "page" %}

{% block title-tag-content %} {{ themeSettings.labelLogIn }} - {% parent %} {% endblock title-tag-content %}

{% block body-tag-classes %} mz-loginpage {% endblock body-tag-classes %}

{% block body-content %}
    <div class="mz-l-container">
        <h1 class="mz-pagetitle">{{ themeSettings.labelLogIn }}</h1>
        <form method="post" class="mz-loginform mz-loginform-page">
           {% include "modules/common/message-bar" %}
           <input type="hidden" name="returnUrl" value="{{ Model.ReturnUrl }}" />
           <div class="mz-formfieldgroup">
                <div class="mz-formfieldgroup-row">
                    <div class="mz-formfieldgroup-cell">
                        <label for="email">{{ themeSettings.labelEmail }}</label>
                    </div>
                    <div class="mz-formfieldgroup-cell">
                        <input name="email" value="{{Model.email|default:user.email}}" type="email"/>
                    </div>
                </div>
                <div class="mz-formfieldgroup-row">
                    <div class="mz-formfieldgroup-cell">
                        <label for="password">{{ themeSettings.labelPassword }}</label>
                    </div>
                    <div class="mz-formfieldgroup-cell">
                        <input name="password"  type="password"/>
                    </div>
                </div>
                <div class="mz-formfieldgroup-row">
                    <div class="mz-formfieldgroup-cell"></div>
                    <div class="mz-formfieldgroup-cell">
                        <button class="mz-button mz-button-large">{{ themeSettings.labelLogIn }}</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
{% endblock body-content %}
