{% extends "page" %}

{% block body-tag-classes %} mz-errorpage {% endblock body-tag-classes %}

{% block body-content %}
<div class="mz-l-container">
    <h1 class="mz-pagetitle">{{ themeSettings.labelErrorApology }} <span class="mz-pagetitle-note">{{ themeSettings.labelErrorDetail }}</span><span class="mz-error-text">{{Model.Message}}</span></h1>
    <div class="mz-errordetail">
        <a href="javascript:;" id="stacktrace-link" class="mz-errordetail-expander">stack trace</a>
        <blockquote class="mz-errordetail-body">
            <pre><code>{% dump Model %}</code></pre>
        </blockquote>
    </div>
</div>
{% require_script "pages/error" %}
{% endblock body-content %}