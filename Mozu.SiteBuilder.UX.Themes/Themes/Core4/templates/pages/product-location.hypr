{% extends "page" %}

{% block title-tag-content %}{% if pageContext.metaTitle %}{{ pageContext.metaTitle }}{% else %}Find it at a Local Store  - {% parent %}{% endif %}{% endblock title-tag-content %}

{% block body-tag-classes %} mz-locations {% endblock body-tag-classes %}

{% block body-content %}

    {% require_script "pages/location" %}
    
    {% preload_json model "product" %}

    <div class="mz-l-container">
        <h1 class="mz-pagetitle">Find it at a Local Store</h1>
        <div class="mz-l-stack">
            <div class="mz-l-stack-section mz-locationproduct">
                <h4 class="mz-l-stack-sectiontitle">{{ labels.product }}</h4>
                {% include "modules/product/product-listing" %}
            </div>
            <div class="mz-l-stack-section mz-locationsearch fades-in" id="location-search">
                {% include "modules/location/location-search" with model=model.locations %}
            </div>
        </div>
    </div>

{% endblock body-content %}