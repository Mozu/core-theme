{% extends "page" %}

{% block title-tag-content %} {{ themeSettings.labelCart }} - {% parent %} {% endblock title-tag-content %}

{% block body-tag-classes %} mz-cart {% endblock body-tag-classes %}

{% block body-content %}

{% require_script "pages/cart" %}

{% preload_json model "cart" %}

<div class="mz-l-container">
	<h1 class="mz-pagetitle">{{ themeSettings.labelCart }}</h1>
	<form method="post" action="/cart/checkout" id="cartform">
        {% include "modules/common/message-bar" %}
        <table class="mz-carttable" id="cart">
            {% include "modules/cart/cart-table" %}
        </table>
	</form>
</div>

{% endblock body-content %}