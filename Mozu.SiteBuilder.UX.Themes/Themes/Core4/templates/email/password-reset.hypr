{% extends "email/email" %}

{% block body-content %}

  {{ labels.emailPasswordTop | safe }}

  <p>
    <a href="https://{{ Model.domain }}/myaccount/forgotpassword?t={{ Model.ValidationToken }}">https://{{ Model.domain }}/myaccount/forgotpassword?t={{ Model.ValidationToken }}</a>
  </p>

  {{ labels.emailPasswordBottom | safe }}

{% endblock body-content %}
