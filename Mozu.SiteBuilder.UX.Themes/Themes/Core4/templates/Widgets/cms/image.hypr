<div class="mz-image-wrap" >
  {% if not Model.config.image  %}
    <img  src ="/admin/scripts/resources/images/legacy/AddPhotos.png" alt = "Kind of a big deal" />
  {% else %}
    <img src ="{{Model.config.image.src}}" alt = "{{Model.config.image.src.alt}}" width="{{Model.config.image.width}}" height="{{Model.config.image.height}}" />
  {% endif %}


</div>