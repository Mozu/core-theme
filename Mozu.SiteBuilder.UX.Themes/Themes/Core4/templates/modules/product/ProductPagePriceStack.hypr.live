<h3 class="mz-price-label">Our Price:</h3>
<div class="mz-price">
  {% if Model.Price.HasRange %}
      <span class="mz-price-amt">
        <span>{{ Model.Price.LowerBoundPrice|currency }}</span> - <span>{{ Model.Price.UpperBoundPrice|currency }}</span>
      </span>
  {% else %}
      <span class="mz-price-amt{% if Model.Price.OnSale %} mz-strikethrough{% endif %}">{{ Model.Price.Price|currency }}</span>
      {% if Model.Price.OnSale %}
          <span class="mz-price-amt mz-price-saleprice">{{ Model.Price.SalePrice|currency }}</span>
      {% endif %}
  {% endif %}
</div>