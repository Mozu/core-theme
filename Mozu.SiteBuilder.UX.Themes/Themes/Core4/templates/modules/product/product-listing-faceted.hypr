{% preload_json Model "facetedproducts" %}
<div id="mz-sidebar" class="mz-layout-sidebar">
    {% include "Modules/Product/FacetingPanel" %}
</div>
<section id="mz-layout-container" class="mz-layout-container mz-content-inner-wrap mz-category-wrapper">
<div class="mz-layout-main">
  <div data-mz-pagingcontrols class="mz-paging-info">
    {% include "Modules/Common/PagingControls" %}
  </div>
  <div data-mz-productlisting>
    {% include "Modules/Product/ProductListingTiles" %}
  </div>
  <div data-mz-pagenumbers class="mz-paging">
    {% include "Modules/Common/PageNumbers" %}
  </div>
</div>
</section>