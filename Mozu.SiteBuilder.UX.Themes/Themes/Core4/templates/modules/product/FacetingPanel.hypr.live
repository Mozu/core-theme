<section class="mz-faceting-form">
    <div class="mz-sidebar-item">
        <button class="mz-faceting-clearall" data-mz-action="clearFacets">Clear All Filters</button>
    </div>
    {% for facet in Model.Facets %}
        {% if facet.Values %}
        <div class="mz-sidebar-item">
            <h4>{{ facet.Label }}</h4>
            <ul class="mz-faceting-group">
                <li>
                  {% if facet.isEmpty %}
                  {% else %}
                    <a href="#" class="mz-faceting-clear" data-mz-action="clearFacet" data-mz-facet="{{ facet.Field }}">Clear</a>
                  {% endif %}
                </li>
                {% for value in facet.Values %}
                    <li>
                        <input type="checkbox" id="{{facet.Field}}_{{ forloop.index }}" class="mz-faceting-option" {% if value.IsApplied %}checked="checked"{% endif %} data-mz-facet="{{ facet.Field }}" data-mz-facet-value="{{ value.Value }}">
                        <label for="{{facet.Field}}_{{ forloop.index }}">{{ value.Label }}</label>
                    </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    {% endfor %}
    <div class="mz-sidebar-item">
        <button class="mz-faceting-clearall" data-mz-action="clearFacets">Clear All Filters</button>
    </div>
</section>