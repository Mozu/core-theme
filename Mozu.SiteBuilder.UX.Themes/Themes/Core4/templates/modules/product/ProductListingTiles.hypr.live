<div class="mz-product-listing-wrap">
    {% if Model.Items %}
        <ul class="mz-list-control" data-items-per-row="3">
            {% for prod in Model.Items %}
                <li class="mz-list-item {% if forloop.counter|divisibleby(3) %}mz-list-last{% endif %}">
                    <div class="mz-product-item-wrap">
                        <div class="mz-product-image-wrap">
                            <a class="mz-product-image-link" href="{{prod.Url}}">
                                <img src="{{prod.Content.MainImage.ImageUrl}}?size=160" class="mz-product-image" />
                            </a>
                        <div class="mz-product-info-wrap">
                            <a class="mz-product-title-link" href="{{prod.Url}}">{{prod.Content.ProductName}}</a>
                           {% include "Modules/Common/PriceStack" with prod %}
                        </div>
                    </div>
                </li>
                {% if forloop.counter|divisibleby(3) %}
                    <li class="mz-list-spacer"></li>
                {% endif %}
            {% endfor %}
        </ul>
  {% endif %}
</div>


