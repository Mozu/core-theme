<div class="mz-productlist {% block module-classes %}{% endblock module-classes %}">
    {% if model.items %}
    <ul class="{% block list-classes %}{% endblock list-classes %}">
        {% for prod in model.items %}
            <li>{% include "modules/product/product-listing" with model=prod %}</li>
        {% endfor %}
    </ul>
    {% endif %}
</div>


