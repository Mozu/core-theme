{% if Model.Options %}
    <h3 class="mz-configurator-head">Choose your options...</h3>
    <div class="mz-configurator">
        {% for option in Model.Options %}
        <div class="mz-option-container">
            <label class="mz-option-label">
                {% if option.IsRequired %}
                    <strong class="mz-required">*</strong>
                {% endif %}
                <span class="mz-option-name">{{ option.AttributeDetail.Name }}</span>: 
            </label>
            <div class="mz-option-control">
                {% if option.AttributeDetail.InputType == "YesNo" %}
                    <input class="mz-checkbox mz-option" type="checkbox" data-mz-product-option="{{ option.AttributeFQN }}" />
                {% endif %}
                {% if option.AttributeDetail.InputType == "TextBox" %}
                    <input class="mz-textbox mz-option" type="text" value="{{ option.ShopperEnteredValue }}" data-mz-product-option="{{ option.AttributeFQN }}">
                {% endif %}
                {% if option.AttributeDetail.InputType == "TextArea" %}
                    <textarea class="mz-textarea mz-option" data-mz-product-option="{{ option.AttributeFQN }}">{{ option.ShopperEnteredValue }}</textarea>
                {% endif %}
                {% if option.AttributeDetail.InputType == "List" %}
                    <select {% if option.IsMultiValue %}multiple{% endif %} class="mz-dropdown mz-option" data-mz-product-option="{{ option.AttributeFQN }}">
                        {% if not option.IsMultiValue %}<option></option>{% endif %}
                        {% for value in option.Values %}
                        <option {% if not value.IsEnabled %} class="mz-option-unavailable" {% endif %} {% if value.IsSelected %}selected="true"{% endif %} value="{{value.Value}}">{{value.Value}}</option>
                        {% endfor %}
                    </select>                
                {% endif %}
                {% if option.AttributeDetail.InputType == "Date" %}
                    <input type="text" data-mz-is-datepicker data-mz-product-option="{{ option.AttributeFQN }}" class="mz-textbox mz-option" style="color:transparent" value="{{ option.ShopperEnteredValue }}" data-format="mm/dd/yy" data-max="{{option.MaxValue}}" data-min="{{ option.MinValue }}">
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}