<header class="mz-pageheader">
    {% block store-branding %}
    <h1 class="mz-storebranding" id="store-branding">
        <a href="/" title="{{ siteContext.settings.general.websiteName }}">{{ siteContext.settings.general.websiteName }}</a>
    </h1>
    {% endblock store-branding %}
    {% include "modules/page-header/utility-nav" %}
    {% include "modules/page-header/search-box" %}
    {% block site-nav %}
    {% include "modules/site-nav" %}
    {% endblock site-nav %}
</header>
