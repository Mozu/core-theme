<h3 class="mz-l-stack-sectiontitle">{{ labels.orderHistory }}</h3>
<div class="mz-orderhistory-section mz-l-paginatedlist">
    <div data-mz-pagingcontrols class="mz-pagingcontrols">
        {% include "modules/common/paging-controls" with model=model.orderHistory %}
    </div>
    <div data-mz-orderlist>
      <ul class="mz-orderlist mz-l-paginatedlist-list">
        {% for order in model.orderHistory.items %}
        <li>{% include "modules/common/order-listing" with model=order %}</li>
        {% endfor %}
      </ul>
    </div>
    <div data-mz-pagenumbers class="mz-pagenumbers">
        {% include "modules/common/page-numbers" with model=model.orderHistory %}
    </div>
</div>