<form id="searchbox" class="mz-searchbox" action="/search">
	<input placeholder="{{ themeSettings.labelSearch }}" type="search" class="mz-searchbox-field"  value="{{SiteContext.SearchContext.Query}}" name="query" />
	<button class="mz-searchbox-button" type="submit">{{ themeSettings.labelSearch }}</button>
	<select class="mz-searchbox-categories" name="categoryId">
		<option value="">{{ themeSettings.labelAll }}</option>
    {% for cat in navigation.rootCategories %}
    <option value="{{cat.originalId}}" {% if cat.originalId == pageContext.categoryId  %}selected="selected"{%endif%}>{{cat.Name}}</option>
		{% endfor %}
	</select>
</form>