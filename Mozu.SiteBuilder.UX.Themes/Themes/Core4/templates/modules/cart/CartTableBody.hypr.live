<thead>
  <tr>
    <th class="mz-cart-col mz-cart-head-products">Product</th>
    <th class="mz-cart-col mz-cart-head-price">Price</th>
    <th class="mz-cart-col mz-cart-head-qty">Qty</th>
    <th class="mz-cart-col mz-cart-head-item-total">Item Total</th>
    <th class="mz-cart-col mz-cart-head-delete">&nbsp;</th>
  </tr>
</thead>
<tbody class="mz-cart-{%if Model.IsEmpty %}isempty{% else %}items{% endif %}">
    {% if not Model.IsEmpty %}
  {% for item in Model.Items %}
  <tr class="mz-cart-product-row">
    <td>
      {% if item.Product.mainImage %}
          <img class="mz-cart-item-image" src="{{ item.Product.mainImage.ImagePath }}?size=50" />
      {% endif %}
      <div class="mz-cart-item-info-wrap{% if not item.Product.mainImage %} mz-no-image{% endif %}">
        <a class="mz-cart-item-title" href="{{item.Product.Url}}">{{ item.Product.Name }}</a>
        {% if item.Product.Options %}
        <dl class="mz-cart-item-options">
          {% for option in item.Product.Options %}
          <dt class="mz-option-name">{{ option.Name }}:</dt>&nbsp;
          <dd class="mz-option-value">{{ option.Value }}</dd>
          {% endfor %}
        </dl>
        {% endif %}
        <span class="mz-cart-item-code">
          Product Code: <em>{{ item.Product.ProductCode }}</em>
        </span>
      </div>
    </td>
    <td align="right">
      {% if item.priceIsModified %}
      <span class="mz-cart-price mz-strikethrough">{{ item.UnitPrice.BaseAmount|currency }}</span>
      {% endif %}
      <span class="mz-cart-price{% if item.priceIsModified %} mz-updated-price{% endif %}">{{ item.UnitPrice.DiscountedAmount|currency }}</span>
    </td>
    <td align="center">
      <input class="mz-cart-quantity" type="number" min="1" {% if Model.isLoading %}disabled="disabled"{% endif %} data-mz-cart-item="{{ item.Id }}" data-mz-value="Quantity" value="{{ item.Quantity }}" />
    </td>
    <td align="right">
      <span class="mz-cart-rowtotal">{{ item.Total|currency }}</span>
    </td>
    <td class="mz-cart-product-remove-col">
      <a href="javascript:;" data-mz-action="removeItem" data-mz-cart-item="{{ item.Id }}" class="mz-product-delete mz-icon mz-i-close-sm">X</a>
    </td>
  </tr>
{% endfor %}
{% else %}
  <tr align="center">
    <td colspan="5">
      You have no items in your cart.
    </td>
  </tr>
  {% endif %}
</tbody>
<tfoot>
  <tr>
    <td colspan="5" align="right">
      <em class="mz-auxiliary-text">Tax &amp; Shipping Calculated at Checkout</em>
    </td>
  </tr>

  {% for discount in Model.OrderDiscounts %}
    {% if not discount.Excluded %}
  <tr class="mz-cart-total-row">
    <td class="mz-cart-total-label" colspan="3" align="right">
        {{ discount.Discount.Name }}:
    </td>
    <td class="mz-cart-total-wrap" colspan="2" align="right">
      <span class="mz-cart-rowtotal">- {{ discount.Impact|currency }}</span>
    </td>
  </tr>
    {% endif %}
  {% endfor %}


  <tr class="mz-cart-total-row">
    <td class="mz-cart-total-label" colspan="3" align="right">
      Order Total:
    </td>
    <td class="mz-cart-total-wrap" colspan="2" align="right">
      <strong>
        <span id="mz-cart-total" class="mz-cart-total">{{ Model.DiscountedTotal|currency }}</span>
      </strong>
    </td>
  </tr>
  <tr>
    <td colspan="5" align ="right">
      <input type="hidden" name="Id" value="{{ Model.Id }}" />
      {% include "modules/common/loadingbar" %}
      <button id="me-cart-checkout" class="mz-button mz-btn-checkout mz-btn-cta"  {% if Model.IsEmpty %} disabled="disabled" {% endif %} data-mz-action="proceedToCheckout">Proceed to Checkout</button>
    </td>
  </tr>
</tfoot>