{% if Model.TotalCount %}
Showing <span>{{ Model.firstIndex }}</span> - <span>{{ Model.lastIndex }}</span> of <span>{{ Model.TotalCount }}</span> result{% if Model.TotalCount != 1 %}s{% endif %}
{% endif %}
<label class="mz-pagingcontrols-pagesize-label">
    Show
    <select data-mz-value="PageSize" class="mz-pagingcontrols-pagesize-dropdown">
        <option {% if Model.PageSize == 15 %}selected="selected"{% endif %} value="15">15</option>
        <option {% if Model.PageSize == 25 %}selected="selected"{% endif %} value="25">25</option>
        <option {% if Model.PageSize == 50 %}selected="selected"{% endif %} value="50">50</option>
        <option {% if Model.PageSize == 100 %}selected="selected"{% endif %} value="100">100</option>
    </select>
    results per page
</label>