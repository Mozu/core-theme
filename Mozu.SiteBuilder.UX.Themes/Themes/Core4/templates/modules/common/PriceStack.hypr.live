<div class="mz-price-stack-wrap">		
	<div class="mz-price-label">{{ProductCode}}</div>
    <div class="mz-price-sub-wrap">
        {% if Price.Price != Price.OfferPrice %}
            <div class="mz-price-amt mz-strikethrough">
                {{Price.Price|currency}}
            </div>
            <div class="mz-price-saleprice mz-price-amt">
                {% if Price.HasDiscount %}
                    <span class="mz-price-discount-name">{{Price.DiscountName}} &ndash;</span>
                {% endif %}
                {{Price.OfferPrice|currency}}
            </div>
        {% else %}
            <div class="mz-price-amt">
                {{Price.Price|currency}}
            </div>
        {% endif %}
    </div>
</div>