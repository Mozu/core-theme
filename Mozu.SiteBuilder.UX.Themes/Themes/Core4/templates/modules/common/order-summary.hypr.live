    <table class="mz-ordersummary">
        <thead>
            <tr>
                <th class="mz-ordersummary-header-product">Product</th>
                <th class="mz-ordersummary-header-qty">Qty</th>
                <th class="mz-ordersummary-header-each">Each</th>
                <th class="mz-ordersummary-header-total">Total</th>
            </tr>
        </thead>
        {% for item in Model.Items %}
            <tbody>
                <tr class="mz-ordersummary-line mz-ordersummary-line-item {% if item.DiscountedTotal < item.Total %}is-discounted{% endif %}">
                    <td class="mz-ordersummary-item-product">{{ item.Product.Name }}</td>
                    <td>{{ item.Quantity }}</td>
                    <td><span class="mz-ordersummary-price">{{ item.UnitPrice.BaseAmount|currency }}</span></td>
                    <td><span class="mz-ordersummary-price mz-ordersummary-itemtotal">{{ item.Subtotal|currency }}</span></td>
                </tr>
                {% if item.DiscountedTotal < item.Total %}
                    <tr class="mz-ordersummary-line mz-ordersummary-line-discount">
                        <td colspan="2">
                            {% if item.Discount %}
                                <span class="mz-ordersummary-discountname">{{ item.Discount.Name }}</span> 
                                {% if item.Discount.FreeShipping %}
                                    <span class="mz-ordersummary-discountamt">Free Shipping</span>
                                {% endif %}
                            {% endif %}
                            <span class="mz-ordersummary-price mz-ordersummary-discountamt" >{{ item.DiscountTotal|currency}} OFF</span>
                        </td>
                        <td>{{ item.UnitPrice.DiscountedAmount|currency }}</td>
                        <td class="mz-ordersummary-price mz-ordersummary-itemtotal">{{ item.Total }}</td>
                    </tr>
                {% endif %}
            </tbody>
        {% endfor %}
      
        <tbody>
            <tr class="mz-ordersummary-totals-row">
                <td colspan="4">
                    <table class="mz-ordersummary-totals">
                        <tbody>
                        {% for discount in Model.OrderDiscounts %}
                            {% if not discount.Excluded %}
                            <tr>
                                <td class="mz-ordersummary-discountname">{{ discount.Discount.Name }}:</td>
                                <td class="mz-ordersummary-discountamt">-{{ discount.Impact|currency }}</td>
                            </tr>
                            {% endif %}
                        {% endfor %}
                            <tr class="mz-ordersummary-subtotal">
                                <td class="mz-ordersummary-totalname">Sub-Total:</td>
                                <td class="mz-ordersummary-totalvalue">{{ Model.DiscountedTotal|currency }}</td>
                            </tr>
                            <tr class="mz-ordersummary-tax">
                                <td class="mz-ordersummary-totalname">Tax:</td>
                                <td class="mz-ordersummary-totalvalue">{{ Model.TaxTotal|currency }}</td>
                            </tr>
                            <tr class="mz-ordersummary-shippingtotal">
                                <td class="mz-ordersummary-totalname">Shipping &amp; Handling:</td>
                                <td class="mz-ordersummary-totalvalue">{{ Model.ShippingTotal|currency }}</td>
                            </tr>
                        {% if Model.HandlingAmount %}
                            <tr class="mz-ordersummary-additionalhandling">
                                <td class="mz-ordersummary-totalname">Additional Handling:</td>
                                <td class="mz-ordersummary-totalvalue">{{ Model.HandlingAmount|currency }}</td>
                            </tr>
                        {% endif %}
                            <tr class="mz-ordersummary-grandtotal">
                                <td class="mz-ordersummary-totalname">Total:</td>
                                <td class="mz-ordersummary-totalvalue">{{ Model.Total|currency }}</td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>