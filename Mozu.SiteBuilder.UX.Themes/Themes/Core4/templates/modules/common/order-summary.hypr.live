    <table class="mz-ordersummary">
        <thead>
            <tr>
                <th class="mz-ordersummary-header-product">{{ themeSettings.labelProduct }}</th>
                <th class="mz-ordersummary-header-qty">{{ themeSettings.labelQty }}</th>
                <th class="mz-ordersummary-header-each">{{ themeSettings.labelEach }}</th>
                <th class="mz-ordersummary-header-total">{{ themeSettings.labelTotal }}</th>
            </tr>
        </thead>
        {% for item in model.items %}
            <tbody class="mz-ordersummary-lineitems">
                <tr class="mz-ordersummary-line mz-ordersummary-line-item {% if item.discountedTotal < item.total %}is-discounted{% endif %}">
                    <td class="mz-ordersummary-item-product">{{ item.product.name }}</td>
                    <td>{{ item.quantity }}</td>
                    <td><span class="mz-ordersummary-price">{{ item.unitPrice.baseAmount|currency }}</span></td>
                    <td><span class="mz-ordersummary-price mz-ordersummary-itemtotal">{{ item.subtotal|currency }}</span></td>
                </tr>
                {% if item.discountedTotal < item.total %}
                    <tr class="mz-ordersummary-line mz-ordersummary-line-discount">
                        <td colspan="2">
                            {% if item.discount %}
                                <span class="mz-ordersummary-discountname">{{ item.discount.name }}</span> 
                                {% if item.discount.freeShipping %}
                                    <span class="mz-ordersummary-discountamt">{{ themeSettings.labelFreeShipping }}</span>
                                {% endif %}
                            {% endif %}
                            <span class="mz-ordersummary-price mz-ordersummary-discountamt" >{{ item.discountTotal|currency}} OFF</span>
                        </td>
                        <td>{{ item.unitPrice.discountedAmount|currency }}</td>
                        <td class="mz-ordersummary-price mz-ordersummary-itemtotal">{{ item.total }}</td>
                    </tr>
                {% endif %}
            </tbody>
        {% endfor %}
      
        <tbody>
            {% for discount in model.orderDiscounts %}
            {% if not discount.excluded %}
            <tr class="mz-ordersummary-discount">
              <td colspan="4">
                <span class="mz-ordersummary-discountname">{{ discount.discount.name }}:</span>
                <span class="mz-ordersummary-discountamt">-{{ discount.impact|currency }}</span
              </td>
            </tr>
            {% endif %}
            {% endfor %}
            <tr class="mz-ordersummary-subtotal">
              <td colspan="4">
                <span class="mz-ordersummary-totalname">{{ themeSettings.labelSubtotal }}:</span>
                <span class="mz-ordersummary-totalvalue">{{ model.discountedTotal|currency }}</span>
              </td>
            </tr>
            {% if model.taxTotal %}
            <tr class="mz-ordersummary-tax">
                <td colspan="4">
                    <span class="mz-ordersummary-totalname">{{ themeSettings.labelTax }}:</span>
                    <span class="mz-ordersummary-totalvalue">{{ model.taxTotal|currency }}</span>
                </td>
            </tr>
            {% endif %}
            <tr class="mz-ordersummary-shippingtotal">
              <td colspan="4">
                <span class="mz-ordersummary-totalname">{{ themeSettings.labelShippingHandling }}:</span>
                <span class="mz-ordersummary-totalvalue">{{ model.shippingTotal|currency }}</span>
              </td>
            </tr>
            {% if model.handlingAmount %}
            <tr class="mz-ordersummary-additionalhandling">
                <td colspan="4">
                    <span class="mz-ordersummary-totalname">{{ themeSettings.labelAdditionalHandling }}</span>
                    <span class="mz-ordersummary-totalvalue">{{ model.handlingAmount|currency }}</span>
                </td>
            </tr>
            {% endif %}
            <tr class="mz-ordersummary-grandtotal">
                <td colspan="4">
                    <span class="mz-ordersummary-totalname">{{ themeSettings.labelTotal }}:</span>
                    <span class="mz-ordersummary-totalvalue">{{ model.total|currency }}</span>
                </td>
            </tr>
        </tbody>
    </table>