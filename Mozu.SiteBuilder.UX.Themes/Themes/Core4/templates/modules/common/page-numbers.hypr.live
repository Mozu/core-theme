<a class="mz-pagenumbers-prev{% if not model.hasPreviousPage %} is-disabled{% endif %}" href="#" data-mz-action="previous">{{ themeSettings.labelPreviousPage }}</a>
{% for pageNumber in model.pageNumbers %}
<a class="mz-pagenumbers-number" href="#" data-mz-action="page" data-mz-pagenum="{{ pageNumber }}">{{ pageNumber }}</a>
{% endfor %}
<a class="mz-pagenumbers-next{% if not model.hasNextPage %} is-disabled{% endif %}" href="#" data-mz-action="next">{{ themeSettings.labelNextPage }}</a>