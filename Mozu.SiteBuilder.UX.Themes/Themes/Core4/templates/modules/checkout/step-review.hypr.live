    <h3 class="mz-formstep-header">
        {{ themeSettings.labelReviewOrder }}
    </h3>
    <div class="mz-formstep-body">
        {% if model.isReady %}
            <p class="mz-formstep-desc">{{ themeSettings.labelReviewOrderText }}</p>

            {% if themeSettings.requireCheckoutAgreeToTerms %}
            <div class="mz-formfieldgroup mz-formfieldgroup-norows">
            <label class='inline'>
                <input type="checkbox" name="terms-and-conditions" id="mz-terms-and-conditions" data-mz-value="agreeToTerms" {% if model.agreeToTerms %} checked="checked"{% endif %}> {{ themeSettings.labelAgreeToTerms }}
            </label>
            <span class="mz-validationmessage" data-mz-validationmessage-for="agreeToTerms"></span>
            </div>
            {% endif %}

            {% if not user or user.isAnonymous %}
            <div class="mz-formfieldgroup mz-formfieldgroup-norows">
                <label class='inline'>
                    <input type="checkbox" name="create-new-account" data-mz-value="createAccount" {% if model.createAccount %} checked="checked"{% endif %} > {{ themeSettings.labelCreateAccount }}
                </label>
            </div>

                {% if model.createAccount %}
                <div class="mz-formfieldgroup mz-create-account-fields">
                    <div class="mz-formfieldgroup-row">
                      <div class="mz-formfieldgroup-cell">
                    <label for="new-account-email"> {{ themeSettings.labelEmail }}<span class="is-required"> *</span> </label>
                      </div>
                      <div class="mz-formfieldgroup-cell">
                        <input type="text" name="new-account-email" data-mz-value="User.EmailAddress" value="{{ model.user.emailAddress }}">
                        <span class="mz-validationmessage" data-mz-validationmessage-for="user.emailAddress"></span>
                       </div>
                    </div>
                  <div class="mz-formfieldgroup-row">
                      <div class="mz-formfieldgroup-cell">
                    <label for="new-account-password"> {{ themeSettings.labelPassword }}<span class="is-required"> *</span> </label>
                      </div>
                      <div class="mz-formfieldgroup-cell">
                        <input type="password" name="new-account-password" data-mz-value="user.password" value="{{ model.user.password }}">
                        <span class="mz-validationmessage" data-mz-validationmessage-for="user.password"></span>
                       </div>
                    </div>
                  <div class="mz-formfieldgroup-row">
                      <div class="mz-formfieldgroup-cell">
                    <label for="new-account-password"> {{ themeSettings.labelConfirmPassword }}<span class="is-required"> *</span> </label>
                      </div>
                      <div class="mz-formfieldgroup-cell">
                        <input type="password" name="new-account-confirm" data-mz-value="user.confirmPassword" value="{{ model.confirmPassword }}">
                        <span class="mz-validationmessage" data-mz-validationmessage-for="user.confirmPassword"></span>
                       </div>
                    </div>
                </div>
                {% endif %}
            {% endif %}

            <div class="mz-formstep-next">
                <button type="button" class="mz-button mz-button-large" data-mz-action="submit">{{ themeSettings.labelPlaceOrder }}</button>
            </div>
        {% endif %}
    </div>
