        <div class="mz-formfieldgroup-cell">
            <label for="coupon-code">{{ themeSettings.labelCouponCode }}: </label>
        </div>
        <div class="mz-formfieldgroup-cell">
            <input type="text" id="coupon-code" name="coupon-code" value="{{ model.couponCode }}" data-mz-value="couponCode">
            <button class="mz-button" data-mz-action="addCoupon" {% if not model.couponCode %} disabled="disabled" {% endif %}>{{ themeSettings.labelApply }}</button>
        </div>