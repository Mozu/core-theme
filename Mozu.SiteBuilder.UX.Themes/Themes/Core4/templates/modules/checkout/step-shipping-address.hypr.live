    <h3 class="mz-checkoutform-stepheader">
        Shipping Information
        <button class="mz-button" data-mz-action="edit">Edit</button>
    </h3>
    <div class="mz-checkoutform-stepbody">
        <p class="mz-desc">Where to?</p>
        <div class="mz-completed-summary mz-addresssummary">
            {% include "modules/common/address-summary" %}
        </div>
        <div class="mz-formfieldgroup mz-formfieldgroup-address">
            {% include "modules/common/address-form" %}
        </div>
        <div class="mz-checkoutform-nextstep">
            <button class="mz-button" data-mz-action="next">Next</button>
        </div>
    </div>