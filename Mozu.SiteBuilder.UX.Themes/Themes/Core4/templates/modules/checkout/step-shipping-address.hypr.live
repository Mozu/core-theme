    <h3 class="mz-formstep-header">
        {{ themeSettings.labelShippingInformation }}
        <button class="mz-button mz-formstep-edit" data-mz-action="edit">{{ themeSettings.labelEdit }}</button>
    </h3>
    <div class="mz-formstep-body">
        <div class="mz-formstep-summary mz-addresssummary">
            {% include "modules/common/address-summary" %}
        </div>
        <div class="mz-formstep-fields mz-formfieldgroup">
            {% include "modules/common/address-form" %}
        </div>
        <div class="mz-formstep-next">
            <button class="mz-button" data-mz-action="next">{{ themeSettings.labelNext }}</button>
        </div>
    </div>