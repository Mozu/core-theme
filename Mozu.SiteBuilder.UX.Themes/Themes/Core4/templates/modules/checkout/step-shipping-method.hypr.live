    <h3 class="mz-checkoutform-stepheader">
        Shipping Method
        <button class="mz-button" data-mz-action="edit">Edit</button>
    </h3>
    <div class="mz-checkoutform-stepbody">
        <p class="mz-desc">How to send it?</p>
        <div class="mz-completed-summary">
            <strong>{{ Model.ShippingMethodName }}</strong> ({{ Model.Price|currency }})
        </div>
        <div class="mz-formfieldgroup">
            {% if Model.AvailableShippingMethods %}
                {% for method in Model.AvailableShippingMethods %}
                    <div>
                        <label>
                            <input type="radio" name="shippingMethod" value="{{ method.ShippingMethodCode }}" data-mz-value="ShippingMethodCode" data-mz-shipping-method {% if Model.ShippingMethodCode == method.ShippingMethodCode %} checked="checked" {% endif %}>
                            {{ method.ShippingMethodName }} {{ method.Price|currency }}
                        </label>
                    </div>
                {% endfor %}
                <span class="mz-validation-message" data-mz-validation-message-for="ShippingMethodCode"></span>
            {% else %}
                <p>Sorry, no shipping methods are available.</p>
            {% endif %}
            <div class="mz-checkoutform-nextstep">
                <button type="button" class="mz-button" data-mz-action="next">Next</button>
            </div>
        </div>
    </div>