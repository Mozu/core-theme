    <div class="mz-form-field-row">
        <div class="mz-form-field-cell">
            <label for="nameOnCheck">Name on check<span class="mz-required-field"> *</span>:</label>
        </div>
        <div class="mz-form-field-cell">
            <input type="text" name="nameOnCheck" id="nameOnCheck" data-mz-value="Check.NameOnCheck" value="{{ Model.Check.NameOnCheck }}">
            <span class="mz-validation-message" data-mz-validation-message-for="Check.NameOnCheck"></span>
        </div>
    </div>
    <div class="mz-form-field-row">
        <div class="mz-form-field-cell">
            <label for="checkNumber">Routing Number<span class="mz-required-field"> *</span>:</label>
        </div>
        <div class="mz-form-field-cell">
            <input type="text" name="checkNumber" id="checkNumber" data-mz-value="Check.RoutingNumber" value="{{ Model.Check.RoutingNumber }}">
            <span class="mz-validation-message" data-mz-validation-message-for="Check.RoutingNumber"></span>
        </div>
    </div>                    
    <div class="mz-form-field-row">
        <div class="mz-form-field-cell">
            <label for="checkNumber">Check Number<span class="mz-required-field"> *</span>:</label>
        </div>
        <div class="mz-form-field-cell">
            <input type="text" name="checkNumber" id="checkNumber" data-mz-value="Check.CheckNumber" value="{{ Model.Check.CheckNumber }}">
            <span class="mz-validation-message" data-mz-validation-message-for="Check.CheckNumber"></span>
        </div>
    </div>