    <div class="mz-formfieldgroup-row">
        <div class="mz-formfieldgroup-cell">
            <label for="nameOnCheck">{{ themeSettings.labelNameOnCheck }}<span class="is-required"> *</span>:</label>
        </div>
        <div class="mz-formfieldgroup-cell">
            <input type="text" name="nameOnCheck" id="nameOnCheck" data-mz-value="Check.NameOnCheck" value="{{ Model.Check.NameOnCheck }}">
            <span class="mz-validationmessage" data-mz-validationmessage-for="Check.NameOnCheck"></span>
        </div>
    </div>
    <div class="mz-formfieldgroup-row">
        <div class="mz-formfieldgroup-cell">
            <label for="checkNumber">{{ themeSettings.labelRoutingNumber }}<span class="is-required"> *</span>:</label>
        </div>
        <div class="mz-formfieldgroup-cell">
            <input type="text" name="checkNumber" id="checkNumber" data-mz-value="Check.RoutingNumber" value="{{ Model.Check.RoutingNumber }}">
            <span class="mz-validationmessage" data-mz-validationmessage-for="Check.RoutingNumber"></span>
        </div>
    </div>                    
    <div class="mz-formfieldgroup-row">
        <div class="mz-formfieldgroup-cell">
            <label for="checkNumber">{{ themeSettings.labelCheckNumber }}<span class="is-required"> *</span>:</label>
        </div>
        <div class="mz-formfieldgroup-cell">
            <input type="text" name="checkNumber" id="checkNumber" data-mz-value="Check.CheckNumber" value="{{ Model.Check.CheckNumber }}">
            <span class="mz-validationmessage" data-mz-validationmessage-for="Check.CheckNumber"></span>
        </div>
    </div>