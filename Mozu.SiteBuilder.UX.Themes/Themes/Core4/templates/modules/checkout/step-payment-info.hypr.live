    <h3 class="mz-formstep-header">
        {{ themeSettings.labelPaymentInformation }}
        <button type="button" class="mz-button mz-formstep-edit" data-mz-action="edit">{{ themeSettings.labelEdit }}</button>
    </h3>
    <div class="mz-formstep-body">
            <div class="mz-formstep-summary">
                <h4>{{ Model.PaymentType }}</h4>
                {% if Model.PaymentType == "Check" %}
                    <span>{{ Model.Check.CheckNumber }}</span>
                {% endif %}
                {% if Model.PaymentType == "CreditCard" %}
                    <span>{{ Model.Card.CardNumberPartOrMask }}</span>
                {% endif %}

                <h4>{{ themeSettings.labelBillingAddress }}</h4>
              <div class="mz-addresssummary">
                {% include "modules/common/address-summary" with Model=Model.BillingContact %}
              </div>

                <h4>{{ themeSettings.labelBillingContact }}</h4>
                <p>{{ themeSettings.labelPhone }}: <strong>{{ Model.BillingContact.PhoneNumbers.Home }}</strong></p>
                <p>{{ themeSettings.labelEmail }}: <strong>{{ Model.BillingContact.Email }}</strong></p>
            </div>

            <div class="mz-formstep-fields mz-formfieldgroup">
                    <div class="mz-formfieldgroup-row">
                        <div class="mz-formfieldgroup-cell">
                            <label for="paymenttype">{{ themeSettings.labelPaymentType }}<span class="is-required"> *</span>:</label>
                        </div>
                        <div class="mz-formfieldgroup-cell">
                    <select data-mz-value="PaymentType">
                        <option>Select payment method</option>
                        <option {% if Model.PaymentType == "CreditCard" %}selected="selected"{% endif %} value="CreditCard">{{ themeSettings.labelCreditCard }}</option>
                        <option {% if Model.PaymentType == "Check" %}selected="selected"{% endif %} value="Check">{{ themeSettings.labelCheckByMail }}</option>
                    </select>
                    <span class="mz-validation-message" data-mz-validation-message-for="PaymentType"></span>
                        </div>
                     </div>
              </div>
      <div class="mz-formstep-fields mz-formfieldgroup">

                {% if Model.PaymentType == "CreditCard" %}
                    <div class="mz-formfieldgroup">
                        {% include "modules/checkout/credit-card-form" with Model=Model.Card %}
                    </div>
                {% endif %}

                {% if Model.PaymentType == "Check" %}
                    <div class="mz-formfieldgroup">
                        {% include "modules/checkout/checking-account-form" %}
                    </div>
                {% endif %}

                <h4>Billing Address</h4>
                <div class="mz-formfieldgroup mz-formfieldgroup-norows"><label><input type="checkbox" data-mz-value="IsSameBillingShippingAddress" value="true" {% if Model.IsSameBillingShippingAddress %}checked="checked"{% endif %}> {{ themeSettings.labelUseShippingAddress }}</label></div>
                {% if Model.IsSameBillingShippingAddress %}
                    <div class="mz-addresssummary mz-same-as-shipping-summary" id="mz-same-as-shipping-summary">
                        {% include "modules/common/address-summary" with Model=Model.BillingContact %}
                    </div>
                {% else %}
                <div class="mz-formfieldgroup mz-formfieldgroup-address">
                    {% include "modules/checkout/billing-address-form" with Model=Model.BillingContact %}
                </div>
                {% endif %}
                <h4>{{ themeSettings.labelBillingContact }}</h4>
                <div class="mz-formfieldgroup">
                    <div class="mz-formfieldgroup-row">
                        <div class="mz-formfieldgroup-cell">
                            <label for="billing-email">{{ themeSettings.labelEmail }}<span class="is-required"> *</span>:</label>
                        </div>
                        <div class="mz-formfieldgroup-cell">
                            <input type="text" id="billing-email" name="billing-email" data-mz-value="BillingContact.Email" value="{{ Model.BillingContact.Email }}">
                            <span class="mz-validation-message" data-mz-validation-message-for="BillingContact.Email"></span>
                        </div>
                    </div>
                    <div class="mz-formfieldgroup-row">
                        <div class="mz-formfieldgroup-cell"></div>
                        <div class="mz-formfieldgroup-cell">
                            <label class="mz-inline"><input type="checkbox" name="special-offers" checked style="float: left; margin-right: 8px;"> {{ themeSettings.labelOptIn }} {{ siteContext.settings.general.websiteName|default(themeSettings.labelYou) }}!</label>
                        </div>
                    </div>
                </div>

                <div class="mz-formstep-next">
                    <button class="mz-button" data-mz-action="next">{{ themeSettings.labelNext }}</button>
                </div>
            </div>
    </div><!-- .mz-panel-wrap -->
