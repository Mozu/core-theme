<head>
    {% preload_json SiteContext.apiClientContext "apiconfig" %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="{{ PageContext.MetaDescription }}">
    <title>{{ PageContext.MetaTitle }} {{templateVariables.MetaTitle}} </title>

    {% if PageContext.FeedUrl  %}
        <link rel="alternate" type="application/rss+xml" title="{{ PageContext.Title }}" href="{{ PageContext.FeedUrl }}" />
    {% endif %}

    {% block StyleSheets %}
        {{ "/stylesheets/storefront.less"|stylesheet_tag:"default" }}
    {% endblock StyleSheets %}
    {% block HeaderScripts %}
        <script src="/scripts/vendor/modernizr-respond.min.js"></script>
    {% endblock HeaderScripts %}
</head>