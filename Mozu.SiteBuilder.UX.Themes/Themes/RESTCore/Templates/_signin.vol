{% extends "default" %}

{% block Init %}
	{% setTemplateVariables BodyTagClasses="login" %}
{% endblock Init%}

{% block BodyContent %}
<div id="mz-layout-container" class="mz-layout-container mz-login-page mz-content-inner-wrap">
	<h1 class="mz-page-header">Sign In</h1>
	<form method="post" id="mz-login-page-form" class="mz-login-page-form">
       {% html_validation_summary null "lerp nerp"%}
       <div class="mz-form-fieldgroup">
            <div class="mz-form-field-row">
                <div class="mz-form-field-cell">
                    <label for="email">Email</label>
                </div>
                <div class="mz-form-field-cell">
                    <input name="email" value="{{model.email|default:user.email}}" type="email"/>
                </div>
            </div>
            <div class="mz-form-field-row">
                <div class="mz-form-field-cell">
                    <label for="password">Password</label>
                </div>
                <div class="mz-form-field-cell">
                    <input name="password"  type="password"/>
                </div>
            </div>
            <div class="mz-form-field-row">
                <div class="mz-form-field-cell">
                    <button type="submit" class="mz-button mz-btn-cta">Sign In</button>
                </div>
            </div>
        </div>
    </form>
</div>

{% endblock BodyContent %}
