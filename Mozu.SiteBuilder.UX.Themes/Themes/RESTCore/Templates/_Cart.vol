{% extends "default" %}
{% setTemplateVariables BodyTagClasses="cart" %}

{% block Init %}
{% require_script "pages/cart" %}
{% endblock Init%}

{% block BodyContent %}


<div id="mz-layout-container" class="mz-layout-container mz-cart-page mz-content-inner-wrap">
	<h1 class="mz-page-header">Your Cart</h1>


	<form method="post" action="/cart/checkout" id="mz-cart-form" data-mz-model="{% json_attribute Model %}">
		<table class="mz-table mz-cart-items">
			<thead>
				<tr>
					<th class="mz-cart-col mz-cart-head-products">Product</th>
					<th class="mz-cart-col mz-cart-head-price">Price</th>
					<th class="mz-cart-col mz-cart-head-qty">Qty</th>
					<th class="mz-cart-col mz-cart-head-item-total">Item Total</th>
					<th class="mz-cart-col mz-cart-head-delete">&nbsp;</th>
				</tr>
			</thead>
			<tbody data-bind="foreach: items">
				<tr class="mz-cart-product-row">
					<td>
                        <!-- ko if: product.imagePath -->
						<img class="mz-cart-item-image" data-bind="attr: { src: product.imagePath + '?size=50' }" />
                        <!-- /ko -->
						<div class="mz-cart-product-item-info-wrap">
							<span class="mz-cart-item-title" data-bind="text: product.name"></span>
							<div class="mz-cart-item-options" data-bind="visible: product.options.length > 0, foreach: product.options">
								<strong data-bind="text: optionName + ':'"></strong>&nbsp;
								<span data-bind="text: optionValue"></span>
							</div>
							<span class="mz-cart-item-code">Product Code: <span data-bind="text: product.productCode"></span></span>
						</div>
					</td>
					<td align="right">
						<span class="mz-cart-price mz-strikethrough" data-bind="visible: priceIsModified, currencyText: unitPrice().baseAmount"></span>
						<span class="mz-cart-price mz-updated-price" data-bind="css: { 'mz-updated-price': !priceIsModified }, currencyText: unitPrice().finalAmount"></span>
					</td>
					<td align="center">
						<input class="mz-cart-quantity" type="text" data-bind="value: quantity" />
					</td>
					<td align="right">
						<span class="mz-cart-rowtotal" data-bind="currencyText: total"></span>
					</td>
					<td class="mz-cart-product-remove-col">
						<a href="javascript:;" data-mz-action="removecartitem" class="mz-product-delete mz-icon mz-i-close-sm">X</a>
					</td>
				</tr>
			</tbody>
			<tbody data-bind="visible: isEmpty">
				<tr align="center">
					<td colspan="5">
						You have no items in your cart.
					</td>
				</tr>
			</tbody>
			<tfoot>
				<tr>
					<td>
						<!-- This is unimplemented for alpha. -->
						{% if not Model.HasDiscount %}
						<div id="mz-cart-coupon-form" class="mz-coupon-wrap" style="display:none">
							Coupon code: <input {% if Model.Items.Count == 0 %} disabled="disabled" {% endif %} style="width: 100px;" id="mz-cart-coupon-code" type="text" />&nbsp;
							<input id="mz-cart-apply-coupon-button" {% if Model.Items.Count == 0 %} disabled="disabled" {% endif %} type="button" value="Apply" />
						</div>
						{% else %}{% endif %}
					</td>
					<td colspan="4" align="right"><em class="mz-auxiliary-text">Tax &amp; Shipping Calculated at Checkout</em></td>
				</tr>
				<tr class="mz-cart-total-row">
					<td class="mz-cart-total-label" colspan="3" align="right">Order Total:</td>
					<td class="mz-cart-total-wrap" align="right"><strong><span id="mz-cart-total" class="mz-cart-total" data-bind="currencyText: total"></span></strong></td>
					<td>&nbsp;</td>
				</tr>
				<tr >
					<td colspan="5" align ="right">
						<input type="hidden" name="Id" value="{{ Model.Id }}" />
						<input type="button" value="Update" id="update" data-bind="click: update" />
						<button id="checkout" class="mz-button mz-btn-checkout mz-btn-cta"  {% if Model.Items.Count == 0 %} disabled="disabled" {% endif %} type="submit">Proceed to Checkout</button>
					</td>
				</tr>
			</tfoot>
		</table>
	</form>
</div>
{% endblock BodyContent %}