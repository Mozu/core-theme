<?xml version="1.0"?>
<settings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\..\Tools\ThemeSettings.xsd">
  <items>
    <section id="color" label="Color" visible="true">
      <items>
        <setting id="breadcrumbColor" type="color" label="Breadcrumb Color" defaultValue="#555555"/>
        <setting id="siteBackgroundColor" type="color" label="Site Background" defaultValue="#E5E5E5"/>
        <setting id="wrapBackgroundColor" type="color" label="Container Background" defaultValue="#FFFFFF"/>
        <setting id="contentBackgroundColor" type="color" label="Content Background" defaultValue="#FFFFFF"/>
        <setting id="siteNavColor" type="color" label="Site Navigation Color" defaultValue="#C5C5C5"/>
        <setting id="siteNavHoverColor" type="color" label="Site Navigation Link Hover" defaultValue="#C9C9C9"/>
        <setting id="storeNameColor" type="color" label="Store Name Color" defaultValue="#FEFEFE"/>
        <setting id="textColor" type="color" label="Text Color" defaultValue="#333333"/>
        <setting id="linkColor" type="color" label="Link Color" defaultValue="#4F4F4F"/>
        <setting id="linkVisited" type="color" label="Link Visited Color" defaultValue="#3F3F3F"/>
        <setting id="linkHover" type="color" label="Link Hover Color" defaultValue="#666666"/>
        <setting id="headlineColor" type="color" label="Headline Color" defaultValue="#444444"/>
      </items>
    </section>
    <section id="General" label="General" visible="true">
      <items>
        <setting id="gutterWidth" type="select" label="Gutter Width" defaultValue="20px">
          <values>
            <option value="25px">25px</option>
            <option value="22px">22px</option>
            <option value="20px">20px</option>
            <option value="18px">18px</option>
            <option value="15px">15px</option>
          </values>
        </setting>
      </items>
    </section>
    <section id="font" label="Font" visible="true">
      <items>
        <setting id="siteNavFont" type="font" label="Site Navigation Font" defaultValue="14px Tahoma, sans-serif"/>
        <setting id="storeNameFont" type="font" label="Store Name Font" defaultValue="bold 30px Tahoma, sans-serif"/>
        <setting id="globalFont" type="font" label="Site Font" defaultValue="14px Tahoma, sans-serif"/>
        <setting id="headlineFont" type="font" label="Headline Font" defaultValue="bold 21px Tahoma, sans-serif"/>
      </items>
    </section>
  </items>
</settings>
